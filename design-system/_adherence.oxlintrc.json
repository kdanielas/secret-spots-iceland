{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/nav/**",
              "components/tours/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Prata|Lato))/i]",
        "message": "Font not provided by the design system. Available: Prata, Lato."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconAfter|fullWidth|disabled|href|as|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconAfter, fullWidth, disabled, href, as, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline|outlineLight|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'outline' | 'outlineLight' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sand|onImage|light|amber)$/]",
        "message": "<Chip> tone must be one of 'sand' | 'onImage' | 'light' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|key|ref|className|style|children)$/]",
        "message": "<ContactRow> doesn't accept that prop. Declared props: icon, label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|amber|muted|onDark)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'amber' | 'muted' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Eyebrow> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<FactBarItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, answer, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeaturedOnPlatform'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|rating|key|ref|className|style|children)$/]",
        "message": "<FeaturedOnPlatform> doesn't accept that prop. Declared props: name, rating."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|placeholder|options|rows|onDark|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, type, placeholder, options, rows, onDark, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|select|textarea)$/]",
        "message": "<Field> type must be one of 'text' | 'email' | 'tel' | 'select' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|subtitle|primaryCta|secondaryCta|height|align|children|onPrimary|onSecondary|style|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: image, title, subtitle, primaryCta, secondaryCta, height, align, children, onPrimary, onSecondary, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<Hero> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|description|onDark|style|key|ref|className|style|children)$/]",
        "message": "<HighlightTile> doesn't accept that prop. Declared props: image, title, description, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconBullet'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|onDark|style|key|ref|className|style|children)$/]",
        "message": "<IconBullet> doesn't accept that prop. Declared props: icon, title, description, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|onDark|style|key|ref|className|style|children)$/]",
        "message": "<IconChip> doesn't accept that prop. Declared props: name, size, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:images|columns|gap|ratio|radius|style|key|ref|className|style|children)$/]",
        "message": "<ImageStrip> doesn't accept that prop. Declared props: images, columns, gap, ratio, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InquiryForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:tours|cta|note|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<InquiryForm> doesn't accept that prop. Declared props: tours, cta, note, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|src|onDark|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: height, src, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rating'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|filled|label|style|key|ref|className|style|children)$/]",
        "message": "<Rating> doesn't accept that prop. Declared props: value, max, size, filled, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|date|avatar|initial|rating|quote|readMore|tone|style|key|ref|className|style|children)$/]",
        "message": "<ReviewCard> doesn't accept that prop. Declared props: name, date, avatar, initial, rating, quote, readMore, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sand|light)$/]",
        "message": "<ReviewCard> tone must be one of 'sand' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|align|size|onDark|maxWidth|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, lead, align, size, onDark, maxWidth, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg|md)$/]",
        "message": "<SectionHeading> size must be one of 'xl' | 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<StatBarItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|description|style|key|ref|className|style|children)$/]",
        "message": "<StepItem> doesn't accept that prop. Declared props: number, title, description, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|meta|rating|align|showNav|style|key|ref|className|style|children)$/]",
        "message": "<TestimonialQuote> doesn't accept that prop. Declared props: quote, author, meta, rating, align, showNav, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialQuote'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<TestimonialQuote> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TourCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|duration|title|level|description|kicker|priceLabel|price|cta|layout|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TourCard> doesn't accept that prop. Declared props: image, duration, title, level, description, kicker, priceLabel, price, cta, layout, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TourCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:vertical|wide)$/]",
        "message": "<TourCard> layout must be one of 'vertical' | 'wide'."
      }
    ]
  },
