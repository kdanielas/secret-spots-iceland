---
// The Tripadvisor review carousel from the three tour pages, where the same
// markup, CSS and rotation script were repeated verbatim. It lives here once so
// the pause control and the motion preference only have to be right in one place.
import Icon from './Icon.astro';

interface Review {
  quote: string;
  name: string;
  type: string;
}
interface Props {
  reviews: Review[];
  label?: string;
}
const { reviews, label = 'Guest reviews' } = Astro.props;
---

<div
  class="review-carousel quote-panel"
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
>
  <div style="display:flex;gap:4px">
    {Array.from({ length: 5 }).map(() => (
      <Icon name="star" size={20} color="var(--star-gold)" />
    ))}
  </div>
  <!-- aria-live starts off: while the carousel rotates on its own, announcing a
       new review every 7s would talk over whatever the reader is doing. The
       script turns it to "polite" as soon as rotation stops, so manual paging
       and the reduced-motion case are announced. -->
  <div class="review-live" aria-live="off" aria-atomic="true">
    <p
      class="review-quote"
      style="font:400 28px/1.4 var(--font-display);color:var(--text-heading);margin:0;text-align:center;max-width:900px"
    >
      "{reviews[0].quote}"
    </p>
    <div style="display:flex;flex-direction:column;gap:4px;align-items:center">
      <span class="review-name" style="font:700 14px/1 var(--font-sans);color:var(--text-heading)">
        {reviews[0].name}
      </span>
      <span class="review-type" style="font:400 12px/1 var(--font-sans);color:var(--text-muted)">
        {reviews[0].type}
      </span>
    </div>
  </div>
  <!-- Hidden until the script wires it up: none of these controls does anything
       without JavaScript, and a button that looks pressable but isn't is worse
       than no button. -->
  <div class="review-controls" hidden>
    <button type="button" class="testimonial-arrow" data-dir="prev" aria-label="Previous review">
      <Icon name="arrow-right" size={18} style="transform:rotate(180deg)" />
    </button>
    <button
      type="button"
      class="testimonial-arrow review-pause"
      data-paused="false"
      aria-label="Pause review rotation"
    >
      <span class="review-pause-icon">
        <Icon name="pause" size={18} />
      </span>
      <span class="review-play-icon">
        <Icon name="play" size={18} />
      </span>
    </button>
    <button type="button" class="testimonial-arrow" data-dir="next" aria-label="Next review">
      <Icon name="arrow-right" size={18} />
    </button>
  </div>
</div>

<style>
  /* Reproduces the gap the quote and the attribution had as direct children of
     .quote-panel, now that the live region wraps them both. */
  .review-live {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-9);
    width: 100%;
  }

  .review-controls {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .review-controls[hidden] {
    display: none;
  }

  .testimonial-arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--cream-50);
    color: var(--ink-900);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-control);
  }
  .testimonial-arrow:hover {
    background: var(--cream-100);
  }
  .testimonial-arrow:active {
    transform: var(--press-scale);
  }

  .review-pause[data-paused='true'] .review-pause-icon,
  .review-pause[data-paused='false'] .review-play-icon {
    display: none;
  }
  .review-pause-icon,
  .review-play-icon {
    display: flex;
  }
</style>

<script define:vars={{ REVIEWS: reviews }}>
  const carousel = document.querySelector('.review-carousel');
  if (carousel) {
    const liveEl = carousel.querySelector('.review-live');
    const quoteEl = carousel.querySelector('.review-quote');
    const nameEl = carousel.querySelector('.review-name');
    const typeEl = carousel.querySelector('.review-type');
    const controls = carousel.querySelector('.review-controls');
    const pauseBtn = carousel.querySelector('.review-pause');
    const arrows = carousel.querySelectorAll('.testimonial-arrow[data-dir]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let autoTimer;
    // Two separate reasons to hold the rotation: the pause button (sticky, and
    // the only one that flips the live region on) and pointer/keyboard presence
    // over the card (transient).
    let paused = reduceMotion.matches;
    let held = false;

    // lock the quote's height to the tallest review so switching never
    // resizes the card (re-measured on resize since wrapping changes with width)
    function lockQuoteHeight() {
      const original = quoteEl.textContent;
      quoteEl.style.minHeight = '';
      let max = 0;
      REVIEWS.forEach((r) => {
        quoteEl.textContent = `"${r.quote}"`;
        max = Math.max(max, quoteEl.getBoundingClientRect().height);
      });
      quoteEl.textContent = original;
      quoteEl.style.minHeight = `${max}px`;
    }

    function render() {
      quoteEl.textContent = `"${REVIEWS[index].quote}"`;
      nameEl.textContent = REVIEWS[index].name;
      typeEl.textContent = REVIEWS[index].type;
    }

    function next() {
      index = (index + 1) % REVIEWS.length;
      render();
    }

    function stopAuto() {
      clearInterval(autoTimer);
      autoTimer = undefined;
    }

    function startAuto() {
      stopAuto();
      if (paused || held) return;
      autoTimer = setInterval(next, 7000);
    }

    function syncPauseBtn() {
      pauseBtn.dataset.paused = String(paused);
      pauseBtn.setAttribute(
        'aria-label',
        paused ? 'Resume review rotation' : 'Pause review rotation',
      );
      liveEl.setAttribute('aria-live', paused ? 'polite' : 'off');
    }

    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      syncPauseBtn();
      startAuto();
    });

    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.dir === 'prev') {
          index = (index - 1 + REVIEWS.length) % REVIEWS.length;
        } else {
          index = (index + 1) % REVIEWS.length;
        }
        render();
        startAuto();
      });
    });

    // Hover and keyboard focus hold the rotation so a review can be read to the
    // end; it picks up again on the way out unless the pause button is engaged.
    carousel.addEventListener('mouseenter', () => {
      held = true;
      stopAuto();
    });
    carousel.addEventListener('mouseleave', () => {
      held = false;
      startAuto();
    });
    carousel.addEventListener('focusin', () => {
      held = true;
      stopAuto();
    });
    carousel.addEventListener('focusout', (event) => {
      if (carousel.contains(event.relatedTarget)) return;
      held = false;
      startAuto();
    });

    // A preference change mid-visit flips the rotation without a reload.
    reduceMotion.addEventListener('change', (event) => {
      paused = event.matches;
      syncPauseBtn();
      startAuto();
    });

    controls.hidden = false;
    syncPauseBtn();
    lockQuoteHeight();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(lockQuoteHeight);
    }
    startAuto();

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(lockQuoteHeight, 150);
    });
  }
</script>
