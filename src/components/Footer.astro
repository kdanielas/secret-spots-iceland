---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Button from './Button.astro';
import licenseImg from '../assets/images/2024-086.webp';
import { BUSINESS, SOCIALS } from '../data/site';
import { TOURS } from '../data/tours';
import CookieSettingsButton from './CookieSettingsButton.astro';

interface Props { style?: string; }
const { style = '' } = Astro.props;

// Three link columns (#12). The footer is the one block of internal linking
// that repeats on every page, so it carries the pages worth ranking rather
// than a short "Pages" list: Google crawls them from everywhere, and on mobile
// — 88% of the traffic — this is where people look for what the header hid.
// The tour entries come from TOURS so the footer can never drift out of sync
// with the catalogue.
const tourLinks = [
  ...TOURS.map((t) => ({ label: t.title, href: t.href })),
  { label: 'Accessible Tours', href: '/accessible-tours' },
  { label: 'All tours', href: '/tours' },
];
const companyLinks = [
  { label: 'About Luke', href: '/about' },
  { label: 'How it works', href: '/how-it-works' },
  { label: 'Our Vehicles', href: '/our-vehicles' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Blog', href: '/blog' },
  { label: 'FAQ', href: '/faq' },
];
const registration = [
  `Kennitala: ${BUSINESS.taxID}`,
  `VAT Number: ${BUSINESS.vatID}`,
];
const address = `${BUSINESS.address.street}, ${BUSINESS.address.postalCode} ${BUSINESS.address.city}, Iceland`;
// Phone and email as real links (#8). 88% of the traffic is mobile, and on the
// old site these were the two most used contact routes — as plain text there is
// nothing to tap. `data-ev` feeds the phone_click / email_click conversions.
const contact = [
  { label: 'Phone', href: BUSINESS.telephoneHref, text: BUSINESS.telephone, ev: 'phone_click' },
  { label: 'Email', href: `mailto:${BUSINESS.email}`, text: BUSINESS.email, ev: 'email_click' },
];
// Legal links (#27, #12). GDPR wants the privacy and cookie information
// reachable from every page, and the inquiry form asks guests to accept the
// terms, so those have to be one click away too. The cookie settings control
// is a component because it has to talk to the CMP. The US "do not sell or
// share" wording stays on the Cookie Policy page rather than in this bar.
const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms & Conditions', href: '/terms' },
  { label: 'Cookie Policy', href: '/cookie-policy' },
];
// Build year, so the copyright line does not go stale on its own.
const year = new Date().getFullYear();
---

<footer class="container-pad" style={`background:var(--surface-footer);border:1px solid rgba(255,255,255,.2);padding-top:var(--space-10);padding-bottom:var(--space-10);${style}`}>
  <div style="max-width:var(--container-max);margin:0 auto">
  <div class="footer-top">
    <div class="footer-brand">
      <Logo height={56} onDark />
      <div style="display:flex;gap:var(--space-3);flex-wrap:wrap">
        {SOCIALS.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} style="width:36px;height:36px;border-radius:var(--radius-pill);background:var(--cream-50);color:var(--ink-800);display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto">
            <Icon name={s.icon} size={16} />
          </a>
        ))}
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:6px">
        <span style="font:700 15px/1.2 var(--font-sans);color:var(--text-on-dark)">Secretspotsiceland EHF</span>
        {registration.map((l) => (
          <span style="font:var(--type-body-xs);color:var(--text-on-dark);opacity:.85">{l}</span>
        ))}
      </div>
    </div>

    <div class="footer-col">
      <span class="footer-col-title">Tours</span>
      <nav class="footer-col-links" aria-label="Tours">
        {tourLinks.map((l) => (
          <a href={l.href} class="footer-nav-link">{l.label}</a>
        ))}
      </nav>
    </div>

    <div class="footer-col">
      <span class="footer-col-title">Company</span>
      <nav class="footer-col-links" aria-label="Company">
        {companyLinks.map((l) => (
          <a href={l.href} class="footer-nav-link">{l.label}</a>
        ))}
      </nav>
    </div>

    <div class="footer-col">
      <span class="footer-col-title">Contact</span>
      <div class="footer-col-links">
        {contact.map((c) => (
          <a
            href={c.href}
            class="footer-nav-link"
            data-ev={c.ev}
            data-ev-text={c.label}
            style="word-break:break-word"
          >{c.text}</a>
        ))}
        <address style="font:var(--type-body-xs);font-style:normal;color:var(--text-on-dark);opacity:.85;margin:0;max-width:22ch">{address}</address>
        <Button href="/contact" variant="outlineLight" size="sm" evText="Contact us" evDest="/contact" style="margin-top:var(--space-2)">Contact us</Button>
      </div>
    </div>
  </div>

  <div class="footer-divider"></div>

  <div class="footer-bottom">
    <div style="display:flex;flex-direction:column;gap:4px;text-align:left">
      <span style="font:700 15px/1.3 var(--font-sans);color:var(--text-on-dark)">Licensed Day Tour Operator in Iceland</span>
      <span style="font:var(--type-body-xs);color:var(--text-on-dark);opacity:.75">Secret Spots of Iceland is an authorized day tour provider registered with the Icelandic Tourist Board (License No. 2024-086).</span>
    </div>
    <Image src={licenseImg} alt="Icelandic Tourist Board authorized day tour provider badge" width={120} quality={85} style="width:96px;height:96px;object-fit:contain;flex:0 0 auto" />
  </div>

  <div class="footer-divider"></div>

  <div class="footer-legal">
    <span style="font:var(--type-body-xs);color:var(--text-on-dark);opacity:.75">© {year} Secretspotsiceland EHF</span>
    <nav class="footer-legal-links" aria-label="Legal and privacy">
      {legalLinks.map((l, i) => (
        <>
          {i > 0 ? <span class="footer-legal-sep" aria-hidden="true">·</span> : null}
          <a href={l.href} class="footer-nav-link">{l.label}</a>
        </>
      ))}
      <span class="footer-legal-sep" aria-hidden="true">·</span>
      <CookieSettingsButton />
    </nav>
  </div>
  </div>
</footer>

<style>
  .footer-top {
    display: grid;
    grid-template-columns: minmax(200px, 1.2fr) repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-9);
    padding-bottom: var(--space-8);
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-7);
  }
  .footer-col-title {
    font: 600 13px/1 var(--font-sans);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    opacity: .5;
    margin: 0;
  }
  .footer-col-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .footer-divider { height: 1px; background: rgba(255,255,255,.15); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-top: var(--space-8);
  }
  .footer-nav-link {
    font: 600 14px/1.3 var(--font-sans);
    color: var(--text-on-dark);
    text-decoration: none;
    opacity: .85;
  }
  .footer-nav-link:hover { opacity: 1; text-decoration: underline; }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-6);
  }
  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .footer-legal-sep { color: var(--text-on-dark); opacity: .4; }

  @media (max-width: 1024px) {
    .footer-top { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); }
  }

  @media (max-width: 768px) {
    .footer-top { grid-template-columns: 1fr; gap: var(--space-8); }
    .footer-bottom { flex-direction: column; align-items: flex-start; gap: var(--space-5); }
    .footer-legal { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
    .footer-legal-links { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
    .footer-legal-sep { display: none; }
  }
</style>
