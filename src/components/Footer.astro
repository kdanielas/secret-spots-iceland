---
import Icon from './Icon.astro';

interface Props { style?: string; }
const { style = '' } = Astro.props;

const legal = [
  'Address: Tangabryggja 18, 110 Reykjavík, Iceland',
  'Kennitala: 610823-2030',
  'VAT Number: 152431',
  '+354 8454057',
];
const socials = [
  { icon: 'instagram', label: 'Instagram' },
  { icon: 'facebook', label: 'Facebook' },
  { icon: 'twitter', label: 'X' },
  { icon: 'circle-x', label: 'Tripadvisor' },
  { icon: 'circle-x', label: 'TikTok' },
  { icon: 'youtube', label: 'YouTube' },
];
---

<footer style={`background:var(--surface-footer);border:1px solid rgba(255,255,255,.2);padding:var(--space-10) var(--space-9);display:flex;flex-direction:column;align-items:center;gap:var(--space-7);${style}`}>
  <div style="display:flex;flex-direction:column;align-items:center;gap:var(--space-2)">
    <span style="font:700 15px/1.2 var(--font-sans);color:var(--text-on-dark)">Secretspotsiceland EHF</span>
    {legal.map((l) => (
      <span style="font:var(--type-body-xs);color:var(--text-on-dark)">{l}</span>
    ))}
  </div>
  <div style="display:flex;gap:var(--space-4)">
    {socials.map((s) => (
      <a href="#" aria-label={s.label} style="width:40px;height:40px;border-radius:var(--radius-pill);background:var(--cream-50);color:var(--ink-800);display:inline-flex;align-items:center;justify-content:center">
        <Icon name={s.icon} size={18} />
      </a>
    ))}
  </div>
</footer>
