---
interface Item { value: string; label: string; }
interface Props {
  items?: Item[];
  onDark?: boolean;
  style?: string;
}
const { items = [], onDark = true, style = '' } = Astro.props;
---

<div class="stat-bar" style={`--stat-cols:${items.length};gap:var(--grid-gap);${style}`}>
  {items.map((it) => (
    <div style="display:flex;flex-direction:column;gap:var(--space-3)">
      <span style={`font:var(--type-display-md);color:${onDark ? 'var(--cream-50)' : 'var(--text-heading)'};${onDark ? 'text-shadow:0 1px 10px rgba(0,0,0,.35)' : ''}`}>{it.value}</span>
      <span style={`font:var(--type-eyebrow);letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;color:${onDark ? 'var(--text-on-dark-muted)' : 'var(--text-muted)'};${onDark ? 'text-shadow:0 1px 8px rgba(0,0,0,.35)' : ''}`}>{it.label}</span>
    </div>
  ))}
</div>
