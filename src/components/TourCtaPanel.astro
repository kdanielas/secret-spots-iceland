---
import { Image } from 'astro:assets';
import Button from './Button.astro';

interface Props {
  title: string;
  lead: string;
  cta: string;
  image: ImageMetadata;
  imageAlt?: string;
  href?: string;
}
const {
  title,
  lead,
  cta,
  image,
  imageAlt = 'Family enjoying a geothermal steam vent in North Iceland',
  href = '/contact',
} = Astro.props;
---

<section class="tour-cta">
  <div class="tour-cta-card">
    <Image src={image} alt={imageAlt} width={1600} quality={80} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 25%" />
    <div class="tour-cta-overlay"></div>
    <div class="tour-cta-body">
      <div style="display:flex;flex-direction:column;gap:var(--space-6)">
        <h2 class="tour-cta-title">{title}</h2>
        <p class="tour-cta-lead">{lead}</p>
      </div>
      <Button variant="primary" href={href}>{cta}</Button>
    </div>
  </div>
</section>

<style>
  /* Issue #57: el panel llevaba padding fijo (32px fuera, 96px dentro), lo que
     dejaba 104px de contenido a 360px y desbordaba el titular. Padding fluido
     con clamp() + titular fluido para que el bloque respire en movil. */
  .tour-cta {
    background: #081824;
    border-radius: 32px 32px 0 0;
    padding: clamp(var(--space-5), 4vw, var(--space-8));
  }
  .tour-cta-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: var(--cream-50);
    min-height: 520px;
    display: flex;
    align-items: center;
    padding: clamp(var(--space-7), 8vw, var(--space-13));
  }
  .tour-cta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(251,246,240,.97) 40%, rgba(251,246,240,.15) 90%);
  }
  .tour-cta-body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
    align-items: flex-start;
    max-width: 600px;
  }
  .tour-cta-title {
    font: 400 clamp(1.75rem, 6vw, 3rem)/1.1 var(--font-display);
    color: var(--text-heading);
    margin: 0;
    overflow-wrap: break-word;
  }
  .tour-cta-lead {
    font: 400 18px/1.6 var(--font-sans);
    color: var(--text-body);
    margin: 0;
  }

  @media (max-width: 768px) {
    .tour-cta-card { min-height: 0; }
    .tour-cta-body { gap: var(--space-7); }
    .tour-cta-lead { font-size: 16px; }
    /* El degradado horizontal deja el texto sin fondo legible cuando la
       columna ocupa todo el ancho; en movil se vuelve vertical. */
    .tour-cta-overlay {
      background: linear-gradient(180deg, rgba(251,246,240,.93) 0%, rgba(251,246,240,.97) 60%, rgba(251,246,240,.93) 100%);
    }
  }
</style>
