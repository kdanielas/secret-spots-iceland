---
import Icon from './Icon.astro';
import type { TourDay } from '../data/tours';

interface Props {
  heading: string;
  days: TourDay[];
}

const { heading, days } = Astro.props;
---

<section class="tour-block">
  <div style="display:flex;flex-direction:column;gap:var(--space-10);max-width:var(--container-max);margin:0 auto">
    <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">{heading}</h2>
    <div style="display:flex;flex-direction:column">
      {days.map((d) => (
        <div style="display:flex;flex-direction:column;gap:var(--space-5);padding:var(--space-8) 0;border-bottom:1px solid var(--border-subtle)">
          <div style="display:flex;flex-direction:column;gap:var(--space-2)">
            <span style="font:700 13px/1 var(--font-sans);color:var(--blue-500);letter-spacing:.04em;text-transform:uppercase">Day {d.day}</span>
            <h3 style="font:400 1.75rem/1.25 var(--font-display);color:var(--text-heading);margin:0">{d.location}</h3>
            <p style="font:600 15px/1.4 var(--font-sans);color:var(--text-muted);margin:0">{d.subtitle}</p>
          </div>
          <p style="font:var(--type-lead);color:var(--text-body);margin:0;max-width:800px">{d.description}</p>
          <div style="display:flex;flex-direction:column;gap:var(--space-3)">
            {d.stops.map((stop) => (
              <div style="display:flex;gap:var(--space-3);align-items:flex-start">
                <Icon name="check" size={16} color="var(--blue-500)" style="flex:0 0 auto;margin-top:4px" />
                <p style="font:400 15px/1.5 var(--font-sans);color:var(--text-body);margin:0">{stop}</p>
              </div>
            ))}
          </div>
          {d.closing ? <p style="font:600 14px/1 var(--font-sans);color:var(--text-muted);margin:0">{d.closing}</p> : null}
        </div>
      ))}
    </div>
  </div>
</section>
