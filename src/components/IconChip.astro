---
import Icon from './Icon.astro';

interface Props {
  name: string;
  size?: number;
  onDark?: boolean;
  style?: string;
}
const { name, size = 40, onDark = false, style = '' } = Astro.props;
---

<span
  style={`display:inline-flex;align-items:center;justify-content:center;width:${size}px;height:${size}px;flex:0 0 auto;border-radius:var(--radius-pill);background:${onDark ? 'var(--surface-dark-field)' : 'var(--surface-chip)'};color:${onDark ? 'var(--text-on-dark)' : 'var(--blue-500)'};${style}`}
>
  <Icon name={name} size={Math.round(size * 0.5)} />
</span>
