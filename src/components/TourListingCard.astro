---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { contactHref, formatPrice, listingTitle, tourMetaLine, type Tour } from '../data/tours';

interface Props {
  tour: Tour;
}
const { tour } = Astro.props;

// Medición (#86): slug del tour al que lleva la tarjeta, para tour_name.
const tourSlug = tour.href.startsWith('/tours/') ? tour.href.split('/')[2] : undefined;
const title = listingTitle(tour);
---

<article id={tour.slug} class="tour-card">
  <div class="tour-card-media">
    <Image src={tour.image} alt="" width={700} quality={80} loading="lazy" />
    <div class="tour-card-scrim"></div>
    <span class="tour-card-duration">{tour.duration}</span>
    <span class="tour-card-price">
      <span class="tour-card-price-label">From</span>
      <span class="tour-card-price-value">{formatPrice(tour.priceUsd)}<span class="tour-card-price-unit"> /group</span></span>
    </span>
    {/* El titular y los dos CTA ya enlazan al tour, asi que este enlace sobre la
        foto es redundante para un lector de pantalla: se oculta del arbol de
        accesibilidad y del tabulador, y la duracion y el precio siguen siendo
        texto legible porque quedan fuera de el. */}
    <a
      href={tour.href}
      class="tour-card-media-link"
      data-ev="click_image"
      data-ev-text={title}
      data-ev-tour={tourSlug}
      tabindex="-1"
      aria-hidden="true"
    ></a>
  </div>

  <div class="tour-card-body">
    <div class="tour-card-head">
      <h3 class="tour-card-title">
        <a href={tour.href} data-ev="click_link" data-ev-text={title} data-ev-tour={tourSlug}>{title}</a>
      </h3>
      <p class="tour-card-meta">{tourMetaLine(tour)}</p>
    </div>

    <p class="tour-card-copy">{tour.longDescription}</p>

    <div>
      <h4 class="tour-card-highlights-label">{tour.highlightsLabel ?? 'Highlights'}</h4>
      <ul class="tour-card-list">
        {tour.highlights.map((h) => (
          <li>
            <Icon name="check" size={16} color="var(--blue-500)" style="margin-top:4px" />
            <span>
              <strong>{h.title}</strong>{h.description ? <> — {h.description}</> : null}
            </span>
          </li>
        ))}
      </ul>
    </div>

    {tour.note ? <p class="tour-card-note">{tour.note}</p> : null}

    <div class="tour-card-ctas">
      <a href={contactHref(tour.slug)} class="cta-pill" data-ev="click_button" data-ev-tour={tourSlug}>Check Availability</a>
      <a
        href={tour.href}
        class="info-pill"
        aria-label={`More info about the ${title} tour`}
        data-ev="click_button"
        data-ev-tour={tourSlug}
      >Tour details<Icon name="chevron-right" size={16} /></a>
    </div>
  </div>
</article>

<style>
  .tour-card {
    display: flex;
    flex-direction: column;
    background: var(--cream-50);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .05);
    scroll-margin-top: 110px;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .tour-card:hover { box-shadow: 0 12px 32px rgba(0, 0, 0, .1); }

  .tour-card-media { position: relative; aspect-ratio: 2/1; overflow: hidden; }
  .tour-card-media-link { position: absolute; inset: 0; }
  .tour-card-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tour-card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, .6) 0%, rgba(0, 0, 0, 0) 45%);
  }
  .tour-card-duration {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(29, 45, 68, .54);
    color: var(--cream-50);
    padding: 8px 14px;
    border-radius: 20px;
    font: 700 13px/1 var(--font-sans);
  }
  .tour-card-price { position: absolute; bottom: 16px; right: 16px; color: var(--cream-50); text-align: right; }
  .tour-card-price-label { display: block; font: 400 13px/1 var(--font-sans); opacity: .9; margin-bottom: 4px; }
  .tour-card-price-value { display: block; font: 700 22px/1 var(--font-sans); }
  .tour-card-price-unit { font: 400 13px/1 var(--font-sans); }

  .tour-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-6) var(--space-7);
  }
  .tour-card-head { display: flex; flex-direction: column; gap: 6px; }
  .tour-card-title { font: 700 20px/1.2 var(--font-sans); color: var(--text-heading); margin: 0; }
  .tour-card-title a { color: inherit; text-decoration: none; }
  .tour-card-title a:hover { color: var(--blue-500); }
  .tour-card-meta { font: 500 13px/1.5 var(--font-sans); color: var(--text-muted); margin: 0; }
  .tour-card-copy { font: 400 16px/1.6 var(--font-sans); color: var(--text-body); margin: 0; }

  .tour-card-highlights-label {
    font: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-eyebrow);
    margin: 0 0 var(--space-4);
  }
  .tour-card-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .tour-card-list li { display: flex; gap: var(--space-3); align-items: flex-start; }
  .tour-card-list span { font: 400 15px/1.5 var(--font-sans); color: var(--text-body); }
  .tour-card-list strong { font-weight: 700; color: var(--text-heading); }

  .tour-card-note { font: 400 14px/1.5 var(--font-sans); color: var(--text-muted); margin: 0; }

  .tour-card-ctas {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--space-2);
  }
  .cta-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9.5px 24px;
    background: var(--action-dark-bg);
    color: var(--action-dark-fg);
    border-radius: var(--radius-pill);
    font: var(--type-button);
    font-size: .9375rem;
    white-space: nowrap;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .cta-pill:hover { background: var(--action-dark-bg-hover); }
  .cta-pill:active { transform: var(--press-scale); }
  .info-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 9px 4px;
    color: var(--ink-900);
    font: var(--type-button);
    font-size: .9375rem;
    white-space: nowrap;
    text-decoration: none;
  }
  .info-pill:hover { color: var(--blue-500); }
</style>
