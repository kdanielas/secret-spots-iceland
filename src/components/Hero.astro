---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  framedImage: ImageMetadata;
  framedImageAlt?: string;
  subtitle?: string;
  ratingText?: string;
  tagline?: string;
  primaryCta?: string;
  secondaryCta?: string;
  primaryHref?: string;
  secondaryHref?: string;
  height?: number;
  fullHeight?: boolean;
  style?: string;
}
const {
  framedImage,
  framedImageAlt = '',
  subtitle,
  ratingText,
  tagline,
  primaryCta = 'Check Availability',
  secondaryCta = 'Explore Iceland Photography Tours',
  primaryHref = '/tours',
  secondaryHref = '/tours',
  height = 420,
  fullHeight = false,
  style = '',
} = Astro.props;
---

<section class:list={['hero-section', { 'hero-section-full': fullHeight }]} style={`--hero-h:${height}px;position:relative;z-index:1;display:flex;flex-direction:column;background:#081824;${style}`}>
  <div class="hero-framed-image">
    <Image src={framedImage} alt={framedImageAlt} width={1000} quality={85} loading="eager" fetchpriority="high" style="width:100%;height:100%;object-fit:cover" />
  </div>
  <div class="hero-inner" style="flex:1;display:flex;align-items:center">
    <div class="hero-inner-row" style="width:100%;max-width:var(--container-max);margin:0 auto;padding:0 var(--space-9)">
      <div class="hero-text-col">
        <h1 class="hero-title hero-anim" style="font:var(--type-display-lg);color:var(--cream-50);margin-top:0;margin-bottom:0;text-shadow:0 2px 4px rgba(0,0,0,.4);animation-delay:200ms">
          <slot name="title" />
        </h1>
        {subtitle ? <p class="hero-anim" style="font:var(--type-lead);color:rgba(255,255,255,.9);margin:0;animation-delay:900ms">{subtitle}</p> : null}
        <div class="hero-ctas hero-anim" style="justify-content:flex-start;animation-delay:1600ms">
          {primaryCta ? <Button variant="primary" href={primaryHref}>{primaryCta}</Button> : null}
          {secondaryCta ? <Button variant="outlineLight" href={secondaryHref}>{secondaryCta}</Button> : null}
        </div>
        <slot />
      </div>
      {ratingText ? (
        <div class="hero-rating hero-anim" style="display:flex;flex-direction:column;gap:var(--space-2);animation-delay:2300ms">
          <div style="display:flex;gap:4px">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={16} color="var(--star-gold)" />)}
          </div>
          <p style="margin:0;color:rgba(251,250,248,.48)">
            <span style="text-decoration:underline;font:var(--type-body-sm)">{ratingText}</span>
            {tagline ? <><br /><span style="font:var(--type-body-xs)">{tagline}</span></> : null}
          </p>
        </div>
      ) : null}
    </div>
  </div>
</section>

<style>
  /* Plays automatically on load — the hero is always above the fold, so
     unlike the rest of the site this never waits on a scroll observer. */
  .hero-anim {
    opacity: 0;
    transform: translateY(26px);
    animation: hero-fade-up 1400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes hero-fade-up {
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-anim { opacity: 1; transform: none; animation: none; }
  }
</style>
