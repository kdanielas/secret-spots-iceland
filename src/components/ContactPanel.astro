---
import { Image } from 'astro:assets';
import Eyebrow from './Eyebrow.astro';
import IconChip from './IconChip.astro';
import Button from './Button.astro';
import contactImg from '../assets/images/north-iceland-hot-steam-family.jpg';
import { BUSINESS } from '../data/site';

/** `href` turns the value into a link; `ev` names the dataLayer event it fires. */
interface Row { icon: string; label: string; value: string; href?: string; ev?: string; }
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  style?: string;
}
const {
  eyebrow = 'Get in touch',
  title = "Let's plan your Iceland tour",
  lead = "Tell us what you'd like to experience and we'll create a personalized Iceland itinerary designed around your interests, pace and travel dates.",
  style = '',
} = Astro.props;

// Phone and email are tappable (#8) — this panel sits on nearly every page, so
// it is the main contact surface, and 88% of the traffic is on a phone.
const ROWS: Row[] = [
  { icon: 'phone', label: 'Call or WhatsApp', value: BUSINESS.telephone, href: BUSINESS.telephoneHref, ev: 'phone_click' },
  { icon: 'mail', label: 'Email', value: BUSINESS.email, href: `mailto:${BUSINESS.email}`, ev: 'email_click' },
  { icon: 'map-pin', label: 'Based in', value: `${BUSINESS.address.street}, ${BUSINESS.address.postalCode} ${BUSINESS.address.city}, Iceland` },
  { icon: 'clock', label: 'Response time', value: 'Usually within 24 hours, personally from Luke.' },
];
---

<section class="contact-panel" style={`background:#081824;border-radius:32px 32px 0 0;padding:var(--space-8);${style}`}>
  <div class="contact-panel-card" style="position:relative;border-radius:24px;overflow:hidden;background:var(--cream-50);min-height:600px;display:flex;align-items:center;padding:var(--space-13)">
    <Image src={contactImg} alt="Family enjoying a geothermal steam vent in North Iceland" width={1600} quality={80} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
    <div class="contact-panel-overlay" style="position:absolute;inset:0;background:linear-gradient(90deg, rgba(251,246,240,.97) 30%, rgba(251,246,240,0) 55%)"></div>
    <div style="position:relative;display:flex;flex-direction:column;gap:var(--space-6);align-items:flex-start;max-width:560px">
      <Eyebrow tone="amber">{eyebrow}</Eyebrow>
      <h2 style="font:var(--type-display-md);color:var(--text-heading);margin:0">{title}</h2>
      <p style="font:var(--type-body);color:var(--text-body);margin:0;max-width:460px">{lead}</p>
      <div style="display:flex;flex-direction:column;gap:var(--space-6);margin-top:var(--space-4)">
        {ROWS.map((r) => (
          <div style="display:flex;gap:var(--space-5);align-items:flex-start">
            <IconChip name={r.icon} size={32} />
            <div style="display:flex;flex-direction:column;min-width:0">
              <span style="font:var(--type-body-xs);color:var(--text-muted)">{r.label}</span>
              {r.href ? (
                <a href={r.href} class="contact-panel-link" data-ev={r.ev} data-ev-text={r.label} style="font:var(--type-body-sm);color:var(--text-heading);text-decoration:none;word-break:break-word">{r.value}</a>
              ) : (
                <span style="font:var(--type-body-sm);color:var(--text-heading)">{r.value}</span>
              )}
            </div>
          </div>
        ))}
      </div>
      <Button variant="primary" iconAfter="arrow-right" href="/contact" style="margin-top:var(--space-4)">Plan My Iceland Trip</Button>
    </div>
  </div>
</section>

<style>
  .contact-panel-link:hover,
  .contact-panel-link:focus-visible { text-decoration: underline; }

  @media (max-width: 768px) {
    .contact-panel { padding: var(--space-6) !important; }
    .contact-panel-card { padding: var(--space-7) !important; min-height: 0 !important; }
    .contact-panel-overlay {
      background: linear-gradient(180deg, rgba(251,246,240,.93) 0%, rgba(251,246,240,.97) 60%, rgba(251,246,240,.93) 100%) !important;
    }
  }
</style>
