---
import { Image } from 'astro:assets';
import logoSrc from '../assets/images/logo.png';

interface Props {
  height?: number;
  onDark?: boolean;
  style?: string;
}
const { height = 34, onDark = false, style = '' } = Astro.props;
---

<Image
  src={logoSrc}
  alt="Secret Spots Iceland"
  height={height}
  loading="eager"
  style={`height:${height}px;width:auto;filter:${onDark ? 'brightness(0) invert(1)' : 'none'};${style}`}
/>
