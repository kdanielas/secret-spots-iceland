---
import { Image } from 'astro:assets';
import logoSrc from '../assets/images/secret-spots-iceland-logo.webp';

interface Props {
  height?: number;
  onDark?: boolean;
  style?: string;
}
const { height = 34, onDark = false, style = '' } = Astro.props;

// El logo se pinta a 54-56 px de alto, pero el original mide 1500x754. Sin un
// `width` Astro sirve el original entero (66 KB) en el camino critico de todas
// las paginas, asi que lo derivamos del alto real y dejamos que `densities`
// genere la variante retina.
const ASPECT = 1500 / 754;
const width = Math.round(height * ASPECT);
---

<Image
  src={logoSrc}
  alt="Secret Spots Iceland"
  width={width}
  densities={[1, 2]}
  loading="eager"
  style={`height:${height}px;width:auto;filter:${onDark ? 'brightness(0) invert(1)' : 'none'};${style}`}
/>
