---
// Every icon in src/icons is read at build time and inlined into the page, so
// an icon costs no HTTP request. Sizing, colour and a11y attributes are
// rebuilt onto the root <svg> below so the whole set behaves the same way
// regardless of which library an individual file came from.
const ICONS = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  name: string;
  size?: number;
  color?: string;
  style?: string;
  class?: string;
}
const { name, size = 20, color, style = '', class: className } = Astro.props;

const raw = ICONS[`../icons/${name}.svg`];
if (!raw) {
  throw new Error(`<Icon name="${name}" /> has no matching file — add src/icons/${name}.svg.`);
}

// Split the root tag off so its attributes can be normalised; `body` keeps the
// paths and the closing </svg> untouched.
const source = raw.slice(raw.indexOf('<svg'));
const openTagEnd = source.indexOf('>');
const body = source.slice(openTagEnd + 1);

let attrs = source
  .slice('<svg'.length, openTagEnd)
  // these are all set explicitly below
  .replace(/\s(?:width|height|class|role|aria-label|style)="[^"]*"/g, '')
  // the lucide files are pretty-printed one attribute per line
  .replace(/\s+/g, ' ')
  .trim();
// lucide files declare fill/stroke themselves; the simple-icons ones don't and
// would paint black instead of inheriting the surrounding text colour.
if (!/\b(?:fill|stroke)=/.test(attrs)) attrs += ' fill="currentColor"';

const inlineStyle = `display:inline-block;flex:0 0 auto;${color ? `color:${color};` : ''}${style}`;
const svg = `<svg ${attrs} width="${size}" height="${size}" role="img" aria-label="${name}"${
  className ? ` class="${className}"` : ''
} style="${inlineStyle}">${body}`;
---

<Fragment set:html={svg} />
