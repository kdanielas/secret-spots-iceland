---
interface Props {
  name: string;
  size?: number;
  color?: string;
  style?: string;
  class?: string;
}
const { name, size = 20, color, style = '', class: className } = Astro.props;
---

<span
  role="img"
  aria-label={name}
  class={className}
  style={`display:inline-block;width:${size}px;height:${size}px;flex:0 0 auto;background:${color || 'currentColor'};-webkit-mask-image:url(/icons/${name}.svg);mask-image:url(/icons/${name}.svg);-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center;-webkit-mask-size:contain;mask-size:contain;${style}`}
></span>
