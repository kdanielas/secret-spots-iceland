---
// Every icon in src/icons is read at build time and inlined into the page, so
// an icon costs no HTTP request. Sizing, colour and a11y attributes are
// rebuilt onto the root <svg> below so the whole set behaves the same way
// regardless of which library an individual file came from.
const ICONS = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  name: string;
  size?: number;
  color?: string;
  style?: string;
  class?: string;
  label?: string;
}

// Icons are decorative by default: the file name ("arrow-right", "star") is not
// meaningful to a screen reader. Pass `label` only when the icon is the sole
// carrier of meaning and nothing around it already names the control.
const { name, size = 20, color, style = '', class: className, label } = Astro.props;

const raw = ICONS[`../icons/${name}.svg`];
if (!raw) {
  throw new Error(`<Icon name="${name}" /> has no matching file — add src/icons/${name}.svg.`);
}

const source = raw.slice(raw.indexOf('<svg'));
const openTagEnd = source.indexOf('>');
const body = source.slice(openTagEnd + 1);

let attrs = source
  .slice('<svg'.length, openTagEnd)
  .replace(/\s(?:width|height|class|role|aria-label|aria-hidden|style)="[^"]*"/g, '')
  .replace(/\s+/g, ' ')
  .trim();

if (!/\b(?:fill|stroke)=/.test(attrs)) attrs += ' fill="currentColor"';

const a11y = label ? `role="img" aria-label="${label}"` : `aria-hidden="true"`;

// display and flex live in the .icon class rather than being repeated inline on
// all 77 icons in the page set; only a caller-supplied colour or style is inline.
const inlineStyle = `${color ? `color:${color};` : ''}${style}`;
const svg = `<svg ${attrs} width="${size}" height="${size}" ${a11y} class="icon${ className ? ` ${className}` : '' }"${inlineStyle ? ` style="${inlineStyle}"` : ''}>${body}`;
---

<Fragment set:html={svg} />

