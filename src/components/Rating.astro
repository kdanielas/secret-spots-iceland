---
import Icon from './Icon.astro';

interface Props {
  value?: number;
  max?: number;
  size?: number;
  label?: string;
  style?: string;
}
const { value = 5, max = 5, size = 14, label, style = '' } = Astro.props;
const stars = Array.from({ length: max }, (_, i) => i);
---

<div style={`display:inline-flex;align-items:center;gap:4px;color:var(--star-gold);${style}`}>
  {stars.map((i) => (
    <Icon name="star" size={size} style={`opacity:${i < Math.round(value) ? 1 : 0.3}`} />
  ))}
  {label ? <span style="font:var(--type-body-sm);color:var(--text-muted);margin-left:6px">{label}</span> : null}
</div>
