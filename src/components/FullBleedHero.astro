---
import { Image, getImage } from 'astro:assets';
import Navbar from './Navbar.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt?: string;
  video?: string;
  active?: string;
  overlayOpacity?: number;
  contentMaxWidth?: string;
}
const {
  image,
  imageAlt = '',
  video,
  active,
  overlayOpacity = 0.9,
  contentMaxWidth = '700px',
} = Astro.props;
const posterSrc = video
  ? (await getImage({ src: image, width: 1600, quality: 80 })).src
  : undefined;
---

<div
  class="full-bleed-hero-wrap"
  style="box-sizing:border-box;padding:var(--space-8);position:relative"
>
  <section style="position:relative;min-height:calc(100dvh - var(--space-8) * 2);border-radius:32px;overflow:hidden;background:#081824;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:var(--space-11) var(--space-9)">
    {video ? (
      <video
        src={video}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={posterSrc}
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
      ></video>
    ) : (
      <Image
        src={image}
        alt={imageAlt}
        width={1600}
        quality={80}
        loading="eager"
        fetchpriority="high"
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
      />
    )}
    <div style={`position:absolute;inset:0;background:#081824;opacity:${overlayOpacity}`}></div>
    <Navbar active={active} transparent showContact overlay />
    <div
      class="full-bleed-hero-content"
      style={`position:relative;display:flex;flex-direction:column;gap:var(--space-8);align-items:center;max-width:${contentMaxWidth};width:100%`}
    >
      <slot />
    </div>
  </section>
</div>

<style>
  @media (max-width: 768px) {
    .full-bleed-hero-wrap {
      padding: var(--space-6) !important;
    }
  }
</style>
