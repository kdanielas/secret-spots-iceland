---
interface Props {
  number: string;
  title: string;
  description: string;
  style?: string;
}
const { number, title, description, style = '' } = Astro.props;
---

<div style={`display:flex;flex-direction:column;gap:var(--space-4);${style}`}>
  <span style="font:var(--type-numeral);color:var(--blue-500)">{number}</span>
  <span style="font:var(--type-lead);font-weight:var(--weight-bold);color:var(--text-heading)">{title}</span>
  <p style="font:var(--type-body);color:var(--text-body);margin:0">{description}</p>
</div>
