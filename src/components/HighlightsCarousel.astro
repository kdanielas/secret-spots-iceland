---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Highlight {
  image: ImageMetadata;
  title: string;
  description: string;
}
interface Props {
  title: string;
  highlights: Highlight[];
}
const { title, highlights } = Astro.props;
---

<section class="panel-py" style="background:var(--ink-900);overflow:hidden">
  <div style="display:flex;flex-direction:column;gap:var(--space-11);max-width:var(--container-max);margin:0 auto">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:0 var(--space-8)">
      <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--cream-100);margin:0">{title}</h2>
      <div style="display:flex;gap:var(--space-4)">
        <button type="button" class="highlights-arrow" data-dir="prev" aria-label="Previous highlight">
          <Icon name="arrow-right" size={18} style="transform:rotate(180deg)" />
        </button>
        <button type="button" class="highlights-arrow" data-dir="next" aria-label="Next highlight">
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
    </div>
    <div class="highlights-carousel">
      {highlights.map((h) => (
        <div class="highlight-card">
          <div style="border-radius:16px;overflow:hidden;aspect-ratio:16/10">
            <Image class="cover" src={h.image} alt="" width={500} quality={80} loading="lazy" />
          </div>
          <div class="stack gap-3">
            <span style="font:600 24px/1.2 var(--font-sans);color:var(--cream-100)">{h.title}</span>
            <p style="font:400 14px/1.5 var(--font-sans);color:rgba(244,237,225,.7);margin:0">{h.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .highlights-carousel {
    display: flex;
    gap: var(--space-7);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 var(--space-8);
    scroll-padding: 0 var(--space-8);
    scrollbar-width: none;
  }
  .highlights-carousel::-webkit-scrollbar { display: none; }
  .highlight-card {
    flex: 0 0 clamp(260px, 30vw, 420px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .highlights-arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255,255,255,.25);
    background: transparent;
    color: var(--cream-100);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-control);
  }
  .highlights-arrow:hover { background: rgba(255,255,255,.1); }
  .highlights-arrow:active { transform: var(--press-scale); }

  @media (max-width: 768px) {
    .highlight-card { flex-basis: 78vw; }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.highlights-carousel');
  const arrows = document.querySelectorAll<HTMLButtonElement>('.highlights-arrow');
  if (track) {
    const originalCards = Array.from(track.children);
    originalCards.forEach((card) => {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    });

    const setWidth = () => track.scrollWidth / 2;

    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.highlight-card');
        const step = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
        if (btn.dataset.dir === 'prev' && track.scrollLeft - step < 0) {
          track.scrollLeft += setWidth();
        }
        track.scrollBy({ left: btn.dataset.dir === 'prev' ? -step : step, behavior: 'smooth' });
      });
    });

    let settleTimer: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(settleTimer);
      settleTimer = setTimeout(() => {
        const width = setWidth();
        if (track.scrollLeft >= width) track.scrollLeft -= width;
      }, 120);
    });
  }
</script>
