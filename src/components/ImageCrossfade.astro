---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  ratio?: string;
  radius?: string;
  interval?: number;
  alt?: string;
  class?: string;
  style?: string;
}
const {
  images,
  ratio = '3 / 4',
  radius = 'var(--radius-image)',
  interval = 4000,
  alt = '',
  class: className,
  style = '',
} = Astro.props;
const uid = `xfade-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['image-crossfade', className]}
  data-interval={interval}
  style={`position:relative;overflow:hidden;border-radius:${radius};aspect-ratio:${ratio};${style}`}
>
  {images.map((img, i) => (
    <Image
      src={img}
      alt={alt}
      width={700}
      quality={80}
      loading={i === 0 ? 'eager' : 'lazy'}
      class="image-crossfade-slide"
      data-active={i === 0 ? 'true' : 'false'}
      style={`position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:${i === 0 ? 1 : 0};transition:opacity 1200ms var(--ease-out)`}
    />
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.image-crossfade').forEach((el) => {
    const slides = Array.from(el.querySelectorAll<HTMLElement>('.image-crossfade-slide'));
    if (slides.length < 2) return;
    const interval = Number(el.dataset.interval) || 4000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;
    let current = 0;
    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides[current].style.opacity = '0';
      slides[next].style.opacity = '1';
      current = next;
    }, interval);
  });
</script>
