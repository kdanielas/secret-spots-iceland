---
import Icon from './Icon.astro';
import { CATEGORIES } from '../lib/consent';

// The consent banner and the preferences dialog (#26), the piece the footer's
// CookieSettingsButton has been waiting for: this file is what finally defines
// window.openCookieSettings().
//
// Both live at the top of <body> so keyboard and screen reader users reach the
// banner before the rest of the page; CSS puts it back at the bottom visually.
// Visibility is driven by the data-consent attribute that ConsentMode.astro
// sets in <head>, so a returning visitor never sees the banner flash.
//
// No third-party CMP: the whole exchange is two categories and one cookie, and
// a self-hosted banner is one less vendor loading scripts before consent.
---

<aside id="cookie-banner" class="cc-banner" role="region" aria-label="Cookie consent">
  <div class="cc-banner-inner">
    <div class="cc-banner-copy">
      <p class="cc-banner-title">Cookies on this site</p>
      <p class="cc-banner-text">
        Some cookies are needed for the site to work and to keep the contact form free of spam.
        With your consent we also use Google Analytics to see how the site is used — never for
        advertising. You can change your mind at any time. See our <a href="/cookie-policy">Cookie Policy</a>.
      </p>
    </div>
    <div class="cc-banner-actions">
      <button type="button" class="cc-btn cc-btn-outline" data-cc="open" data-ev="click_button" data-ev-text="Cookie settings">Cookie settings</button>
      <button type="button" class="cc-btn cc-btn-dark" data-cc="reject" data-ev="click_button" data-ev-text="Reject all cookies">Reject all</button>
      <button type="button" class="cc-btn cc-btn-dark" data-cc="accept" data-ev="click_button" data-ev-text="Accept all cookies">Accept all</button>
    </div>
  </div>
</aside>

<div id="cookie-prefs" class="cc-modal" hidden>
  <div class="cc-scrim" data-cc="close"></div>
  <div class="cc-card" role="dialog" aria-modal="true" aria-labelledby="cc-title" aria-describedby="cc-intro">
    <button type="button" class="cc-close" data-cc="close" aria-label="Close cookie settings">
      <Icon name="x" size={18} />
    </button>

    <p id="cc-title" class="cc-card-title">Cookie settings</p>
    <p id="cc-intro" class="cc-card-intro">
      Choose which cookies this site may use. Your choice is stored for 12 months and you can
      change it whenever you like from the link in the footer.
    </p>

    <ul class="cc-cats">
      {CATEGORIES.map((cat) => (
        <li class="cc-cat">
          <div class="cc-cat-head">
            <label class="cc-switch-label" for={`cc-toggle-${cat.id}`}>{cat.title}</label>
            {cat.required ? (
              <span class="cc-always">Always on</span>
            ) : null}
            <input
              type="checkbox"
              class="cc-switch"
              id={`cc-toggle-${cat.id}`}
              data-cc-category={cat.id}
              checked={cat.required}
              disabled={cat.required}
              aria-describedby={`cc-desc-${cat.id}`}
            />
          </div>
          <p class="cc-cat-desc" id={`cc-desc-${cat.id}`}>{cat.description}</p>
        </li>
      ))}
    </ul>

    <div class="cc-card-actions">
      <button type="button" class="cc-btn cc-btn-dark" data-cc="reject" data-ev="click_button" data-ev-text="Reject all cookies">Reject all</button>
      <button type="button" class="cc-btn cc-btn-dark" data-cc="accept" data-ev="click_button" data-ev-text="Accept all cookies">Accept all</button>
      <button type="button" class="cc-btn cc-btn-primary" data-cc="save" data-ev="click_button" data-ev-text="Save cookie choices">Save choices</button>
    </div>

    <p class="cc-card-foot">
      Every cookie we set is listed, with its provider and how long it lasts, in our
      <a href="/cookie-policy">Cookie Policy</a>.
    </p>
  </div>
</div>

<style>
  /* Two gates, both set from script. data-consent comes from ConsentMode.astro
     in <head>, so a returning visitor never sees the banner flash; data-cc-ready
     comes from the module below, so the banner never appears before the buttons
     it offers can do anything. */
  .cc-banner { display: none; }
  :global(html[data-consent='ask'][data-cc-ready]) .cc-banner { display: block; }

  .cc-banner {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-overlay);
    padding: var(--space-4);
    animation: cc-rise var(--dur-slow) var(--ease-out) both;
  }
  @keyframes cc-rise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }

  .cc-banner-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-bar);
    padding: var(--space-6) var(--space-7);
  }
  .cc-banner-copy { display: flex; flex-direction: column; gap: var(--space-2); }
  .cc-banner-title {
    font: 700 1rem/1.3 var(--font-sans);
    color: var(--text-heading);
    margin: 0;
  }
  .cc-banner-text {
    font: var(--type-body-sm);
    color: var(--text-body);
    margin: 0;
    max-width: 68ch;
  }
  .cc-banner-text a { color: var(--blue-500); text-decoration: underline; }
  .cc-banner-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 0 0 auto;
  }

  /* --- buttons: the Button component's tokens, inlined because that component
     does not forward the data-cc hook this script listens for. "Accept all" and
     "Reject all" deliberately share one treatment — under the GDPR refusing has
     to be as easy and as visible as agreeing. --- */
  .cc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--control-h-md);
    padding: 0 var(--control-px-md);
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font: var(--type-button);
    font-size: 0.9375rem;
    white-space: nowrap;
    cursor: pointer;
    transition: var(--transition-control);
  }
  .cc-btn:active { transform: var(--press-scale); }
  .cc-btn-dark { background: var(--action-dark-bg); color: var(--action-dark-fg); }
  .cc-btn-dark:hover { background: var(--action-dark-bg-hover); }
  .cc-btn-primary { background: var(--action-primary-bg); color: var(--action-primary-fg); }
  .cc-btn-primary:hover { background: var(--action-primary-bg-hover); }
  .cc-btn-outline { background: transparent; color: var(--action-outline-fg); border-color: var(--action-outline-border); }
  .cc-btn-outline:hover { background: rgba(29, 45, 68, 0.05); }

  /* --- preferences dialog --- */
  .cc-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
  }
  .cc-modal[hidden] { display: none; }
  .cc-scrim { position: absolute; inset: 0; background: rgba(23, 32, 40, 0.55); }

  .cc-card {
    position: relative;
    width: min(560px, 100%);
    max-height: 100%;
    overflow-y: auto;
    background: var(--surface-raised);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-float);
    padding: var(--panel-pad);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .cc-close {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .cc-close:hover { background: var(--surface-chip); color: var(--text-heading); }

  .cc-card-title {
    font: 400 1.5rem/1.3 var(--font-display);
    color: var(--text-heading);
    margin: 0;
    padding-right: var(--space-8);
  }
  .cc-card-intro { font: var(--type-body-sm); color: var(--text-body); margin: 0; }

  .cc-cats { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .cc-cat { border-top: 1px solid var(--border-subtle); padding: var(--space-5) 0; }
  .cc-cat:last-child { border-bottom: 1px solid var(--border-subtle); }
  .cc-cat-head { display: flex; align-items: center; gap: var(--space-3); }
  .cc-switch-label {
    font: 700 0.9375rem/1.3 var(--font-sans);
    color: var(--text-heading);
    cursor: pointer;
  }
  .cc-always {
    font: 600 11px/1 var(--font-sans);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--surface-chip);
    border-radius: var(--radius-pill);
    padding: 5px 10px;
  }
  .cc-cat-desc { font: var(--type-body-sm); color: var(--text-muted); margin: var(--space-2) 0 0; }

  /* A real checkbox, restyled as a switch: it keeps the native keyboard
     behaviour and the checked state screen readers announce. */
  .cc-switch {
    appearance: none;
    -webkit-appearance: none;
    margin: 0 0 0 auto;
    flex: 0 0 auto;
    width: 44px;
    height: 24px;
    border-radius: var(--radius-pill);
    background: var(--gray-400);
    border: 0;
    position: relative;
    cursor: pointer;
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .cc-switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--white);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .cc-switch:checked { background: var(--blue-500); }
  .cc-switch:checked::after { transform: translateX(20px); }
  .cc-switch:disabled { cursor: default; opacity: 0.55; }
  .cc-switch:focus-visible { outline: none; box-shadow: var(--focus-ring); }

  .cc-card-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .cc-card-actions .cc-btn { flex: 1 1 auto; }
  .cc-card-foot { font: var(--type-body-xs); color: var(--text-muted); margin: 0; }
  .cc-card-foot a { color: var(--blue-500); text-decoration: underline; }

  .cc-btn:focus-visible,
  .cc-close:focus-visible { outline: none; box-shadow: var(--focus-ring); }

  @media (max-width: 768px) {
    .cc-banner-inner { flex-direction: column; align-items: stretch; gap: var(--space-5); }
    .cc-banner-actions { flex-wrap: wrap; }
    .cc-banner-actions .cc-btn { flex: 1 1 140px; }
  }
  @media (max-width: 480px) {
    .cc-banner { padding: var(--space-3); }
    .cc-banner-inner { padding: var(--space-5); }
    .cc-card { padding: var(--space-6); }
    /* Two rows rather than three stacked buttons: on a phone the banner was
       eating close to half the screen. "Accept all" and "Reject all" share the
       second row, so neither is the easier one to reach. */
    .cc-banner-actions [data-cc='open'] { flex: 1 1 100%; }
    .cc-banner-actions [data-cc='reject'],
    .cc-banner-actions [data-cc='accept'] { flex: 1 1 calc(50% - var(--space-3)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc-banner { animation: none; }
    .cc-switch, .cc-switch::after, .cc-btn { transition: none; }
    .cc-btn:active { transform: none; }
  }
</style>

<script>
  import {
    CATEGORIES,
    CONSENT_COOKIE,
    CONSENT_MAX_AGE,
    CONSENT_VERSION,
    DENIED_SIGNALS,
  } from '../lib/consent';

  type Decision = Record<string, boolean>;

  const root = document.documentElement;
  const banner = document.getElementById('cookie-banner');
  const modal = document.getElementById('cookie-prefs');
  const card = modal?.querySelector<HTMLElement>('.cc-card');

  if (banner && modal && card) {
    const toggles = Array.from(modal.querySelectorAll<HTMLInputElement>('[data-cc-category]'));

    const dataLayer = (): unknown[] =>
      ((window as any).dataLayer = (window as any).dataLayer || []);
    // Consent Mode wants the arguments object, not an object literal.
    function gtag() { dataLayer().push(arguments); }

    const readDecision = (): Decision | null => {
      try {
        const match = document.cookie.match(
          new RegExp('(?:^|; )' + CONSENT_COOKIE + '=([^;]*)')
        );
        const parsed = match ? JSON.parse(decodeURIComponent(match[1])) : null;
        if (parsed && parsed.v === CONSENT_VERSION && parsed.c && typeof parsed.c === 'object') {
          return parsed.c as Decision;
        }
      } catch {
        /* a cookie we cannot read is a decision we do not have */
      }
      return null;
    };

    const writeDecision = (decision: Decision) => {
      const value = encodeURIComponent(
        JSON.stringify({ v: CONSENT_VERSION, c: decision, t: Date.now() })
      );
      const secure = location.protocol === 'https:' ? ';Secure' : '';
      document.cookie =
        `${CONSENT_COOKIE}=${value};path=/;max-age=${CONSENT_MAX_AGE};SameSite=Lax${secure}`;
    };

    const signalsFor = (decision: Decision) => {
      const signals: Record<string, 'granted' | 'denied'> = {};
      for (const signal of DENIED_SIGNALS) signals[signal] = 'denied';
      for (const cat of CATEGORIES) {
        const granted = cat.required === true || decision[cat.id] === true;
        for (const signal of cat.signals) signals[signal] = granted ? 'granted' : 'denied';
      }
      return signals;
    };

    /** Records the decision, tells the tags about it and takes the banner away. */
    const apply = (decision: Decision, action: string) => {
      writeDecision(decision);
      gtag('consent', 'update', signalsFor(decision));
      dataLayer().push({
        event: 'cookie_consent',
        consent_action: action,
        consent_categories: CATEGORIES.filter((c) => c.required || decision[c.id])
          .map((c) => c.id)
          .join(','),
      });
      root.setAttribute('data-consent', 'set');
    };

    /** Everything on, or everything optional off — the required ones never move. */
    const everything = (granted: boolean): Decision => {
      const decision: Decision = {};
      for (const cat of CATEGORIES) decision[cat.id] = cat.required === true || granted;
      return decision;
    };

    const fromToggles = (): Decision => {
      const decision: Decision = {};
      for (const cat of CATEGORIES) decision[cat.id] = cat.required === true;
      for (const toggle of toggles) {
        if (!toggle.disabled) decision[toggle.dataset.ccCategory!] = toggle.checked;
      }
      return decision;
    };

    // Opening the dialog must show what was actually agreed, not whatever the
    // switches were left on last time it was open.
    const syncToggles = () => {
      const stored = readDecision();
      for (const toggle of toggles) {
        if (toggle.disabled) continue;
        toggle.checked = stored ? stored[toggle.dataset.ccCategory!] === true : false;
      }
    };

    const FOCUSABLE =
      'button:not([disabled]), [href], input:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let lastFocused: HTMLElement | null = null;

    const openPrefs = () => {
      if (!modal.hidden) return;
      syncToggles();
      lastFocused = document.activeElement as HTMLElement | null;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      card.querySelector<HTMLElement>(FOCUSABLE)?.focus();
    };

    const closePrefs = () => {
      if (modal.hidden) return;
      modal.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    // The contract CookieSettingsButton.astro looks for, on every page.
    (window as any).openCookieSettings = openPrefs;

    // Everything below is wired up: the banner may now show itself.
    root.setAttribute('data-cc-ready', '');

    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-cc]');
      if (!trigger) return;
      switch (trigger.dataset.cc) {
        case 'open':
          openPrefs();
          break;
        case 'close':
          closePrefs();
          break;
        case 'accept':
          apply(everything(true), 'accept_all');
          closePrefs();
          break;
        case 'reject':
          apply(everything(false), 'reject_all');
          closePrefs();
          break;
        case 'save':
          apply(fromToggles(), 'save');
          closePrefs();
          break;
      }
    });

    // Escape closes, Tab stays inside: while the dialog is open the page behind
    // it is inert, so focus must not wander out of the card.
    document.addEventListener('keydown', (event) => {
      if (modal.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closePrefs();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = Array.from(card.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (el) => el.offsetParent !== null
      );
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Global Privacy Control, flagged by ConsentMode.astro: record it as
    // "necessary only" so the signal is honoured and the banner stays away.
    if (root.getAttribute('data-consent') === 'gpc') apply(everything(false), 'gpc');
  }
</script>
