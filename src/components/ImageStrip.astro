---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  columns?: number;
  gap?: string;
  ratio?: string;
  radius?: string;
  style?: string;
}
const { images = [], columns, gap = 'var(--grid-gap)', ratio = '5 / 4', radius = 'var(--radius-image)', style = '' } = Astro.props;
---

<div class="image-strip" style={`--strip-cols:${columns || images.length};gap:${gap};${style}`}>
  {images.map((src) => (
    <div style={`overflow:hidden;border-radius:${radius};aspect-ratio:${ratio}`}>
      <Image class="cover" src={src} alt="" width={700} quality={80} loading="lazy" />
    </div>
  ))}
</div>
