---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import ConsentMode from '../components/ConsentMode.astro';
import CookieConsent from '../components/CookieConsent.astro';
import logoImg from '../assets/images/secret-spots-iceland-logo.webp';
import { absoluteUrl, canonicalUrl, siteNodes } from '../lib/schema';
import { BUSINESS, TWITTER_HANDLE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  active?: string;
  transparentNav?: boolean;
  hideNav?: boolean;
  hideContactPanel?: boolean;
  footerStyle?: string;
  contactPanelStyle?: string;
  /** Page-specific JSON-LD nodes, merged into the site-wide @graph. */
  schema?: Record<string, unknown>[];
  /** Image for the social card. Defaults to /og-default.jpg. */
  image?: ImageMetadata;
  /** What the social card image shows, for screen readers. */
  imageAlt?: string;
}
const {
  title,
  description = 'Private, photography-led Iceland tours with local guide Luke — hidden landscapes, flexible itineraries, no crowds.',
  active,
  transparentNav = false,
  hideNav = false,
  hideContactPanel = false,
  footerStyle = '',
  contactPanelStyle = '',
  schema = [],
  image,
  imageAlt,
} = Astro.props;

// ─── Medición: variables de página (#84) ───────────────────────────────────
// Se quita la barra final: Vercel sirve /tours y /tours/ igual.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pageType =
  path === '/'                                        ? 'home'
  : path.startsWith('/tours/')                        ? 'tour'
  : path === '/tours' || path === '/accessible-tours' ? 'listado_tours'
  : path === '/blog' || /^\/blog\/\d+$/.test(path)    ? 'blog_listado'   // /blog/2 es listado
  : path.startsWith('/blog/')                         ? 'blog_articulo'
  : path === '/contact'                               ? 'contacto'
  : path === '/faq'                                   ? 'faq'
  : 'informativa';
// En las páginas de tour, el slug: no cambia aunque cambie el nombre del tour.
const tourName = path.startsWith('/tours/') ? path.split('/')[2] : undefined;

// Contenedor de Tag Manager (#88). Si la variable no está definida, no se carga.
const GTM_ID = import.meta.env.PUBLIC_GTM_ID;

// Structured data (#39): the business and the site on every page, plus whatever
// the page itself describes (article, tour, FAQ), in a single @graph.
const logoUrl = absoluteUrl((await getImage({ src: logoImg, width: 512, quality: 90 })).src);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...siteNodes(logoUrl), ...schema],
};

// ─── Tarjeta social (#38) ──────────────────────────────────────────────────
// Sin estas etiquetas, un tour compartido en WhatsApp, Facebook o un grupo de
// viajes sale como un enlace pelado, sin imagen ni título.
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
const DEFAULT_OG_ALT = 'Two travellers looking out over the Icelandic highlands on a private tour.';

// Las redes recortan la tarjeta a 1,91:1 y Astro 4 solo sabe redimensionar por
// ancho, no recortar. Una imagen vertical saldría en una franja central que
// corta cabezas, y una de menos de 1200 px saldría ampliada y borrosa: en esos
// casos vale más /og-default.jpg, que ya viene recortada a 1200x630.
const cardImage =
  image && image.width >= OG_WIDTH && image.width / image.height >= 1.3 ? image : undefined;
const ogImage = cardImage && (await getImage({ src: cardImage, width: OG_WIDTH, format: 'jpeg', quality: 80 }));

const ogImageUrl = absoluteUrl(ogImage ? ogImage.src : '/og-default.jpg');
// Las medidas reales: si no cuadran con la imagen, Facebook la recorta a su aire.
const ogImageHeight = cardImage
  ? Math.round((OG_WIDTH * cardImage.height) / cardImage.width)
  : OG_HEIGHT;
// El texto alternativo describe la imagen que acaba en la tarjeta, no la de la página.
const ogImageAlt = (cardImage && imageAlt) || DEFAULT_OG_ALT;
// Los artículos del blog son 'article'; el resto de la web, 'website'.
const ogType = pageType === 'blog_articulo' ? 'article' : 'website';
const ogUrl = canonicalUrl(path);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Consentimiento (#26): los valores por defecto de Consent Mode v2, ANTES
         que el dataLayer y que Tag Manager. Si van después, GA4 escribe sus
         cookies antes de que la persona haya dicho nada. -->
    <ConsentMode />
    <!-- Medición (#84): el dataLayer y las variables de página, ANTES que Tag Manager.
         Si van después, la primera página vista llega a GA4 sin page_type. -->
    <script define:vars={{ pageType, tourName }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ page_type: pageType, tour_name: tourName });
    </script>
    <!-- Tag Manager (#88). Solo se carga si PUBLIC_GTM_ID está definido. -->
    {GTM_ID && (
      <script is:inline define:vars={{ GTM_ID }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
        var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
        j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',GTM_ID);
      </script>
    )}
    <meta name="description" content={description} />
    <!-- Tarjeta social (#38): Open Graph para WhatsApp, Facebook y LinkedIn;
         Twitter Card para X. Las dos leen el mismo título, texto e imagen. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <!-- Not launched yet: keep the preview domain out of search results. Remove at launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>
    <JsonLd schema={jsonLd} />
    <script is:inline>document.documentElement.classList.add('js-reveal-ready');</script>
  </head>
  <body style="background:var(--surface-page)">
    {GTM_ID && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <!-- Accesibilidad (#70). El primer tabulador de cualquier página, por delante
         incluso del aviso de cookies: la cabecera pegajosa y los enlaces del menú
         suman 31 elementos, y sin esto hay que pasar por todos ellos en cada
         página antes de llegar al contenido (WCAG 2.4.1). Es un solo salto, así
         que el aviso de cookies sigue siendo lo primero que se lee. -->
    <a href="#main" class="skip-link">Skip to content</a>
    <!-- Consentimiento (#26). Va al principio del body para que con teclado o
         lector de pantalla se llegue al aviso antes que al resto de la página;
         el CSS lo coloca abajo visualmente. -->
    <CookieConsent />
    <div style={transparentNav ? 'position:relative' : undefined}>
      {hideNav ? null : <Navbar active={active} transparent={transparentNav} showContact overlay={transparentNav} />}
      <!-- Accesibilidad (#70): el contenido de cada página vive dentro de un
           <main>, la región que los lectores de pantalla ofrecen para ir directo
           al contenido, y el destino del enlace de salto. tabindex="-1" es lo que
           permite que el foco aterrice aquí al activarlo; sin él, algunos
           navegadores solo hacen scroll y el siguiente tabulador vuelve al menú. -->
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    {hideContactPanel ? null : <ContactPanel style={contactPanelStyle} />}
    <Footer style={footerStyle} />

    <style>
      /* Accesibilidad (#70). Fuera de la pantalla hasta que recibe el foco; no se
         esconde con display:none ni visibility:hidden porque entonces el teclado
         tampoco podría llegar a él. position:fixed, no absolute, para que aparezca
         a la vista aunque la página esté desplazada. */
      .skip-link {
        position: fixed;
        top: -100px;
        left: var(--space-5);
        z-index: var(--z-modal);
        padding: var(--space-3) var(--space-5);
        border-radius: var(--radius-sm);
        background: var(--surface-raised);
        color: var(--text-link);
        box-shadow: var(--shadow-float);
      }
      .skip-link:focus { top: var(--space-5); }

      /* Al activar el enlace, la cabecera pegajosa taparía el principio del
         contenido: el mismo desplazamiento que ya usan los anclajes de /tours. */
      #main { scroll-margin-top: 110px; }
      /* <main> solo recibe el foco desde el enlace de salto, nunca tabulando, y
         un recuadro alrededor de toda la página se lee como un fallo de pintado. */
      #main:focus { outline: none; }
    </style>

    <script>
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('revealed'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
        );
        items.forEach((el) => observer.observe(el));
      }
    </script>
    <script>
      // ─── Medición (#85): un único listener para toda la web ──────────────────
      // Lee los atributos data-ev* del elemento pulsado y empuja el evento al
      // dataLayer. Vive SOLO aquí: copiado en un componente que se repite,
      // cada clic mandaría el evento varias veces.

      type Datos = Record<string, string | number | undefined>;
      const dl = (): Datos[] => ((window as any).dataLayer = (window as any).dataLayer || []);

      // Variable de página (page_type, tour_name): el valor más reciente, leyendo SOLO
      // las entradas sin "event". Si leyera también los eventos, tras pulsar la tarjeta
      // de un tour todos los clics siguientes heredarían su tour_name.
      const varPagina = (clave: string): string | undefined => {
        const arr = dl();
        for (let i = arr.length - 1; i >= 0; i--) {
          const entrada = arr[i];
          if (!entrada || entrada.event) continue;
          const v = entrada[clave];
          if (v !== undefined && v !== '') return String(v);
        }
        return undefined;
      };

      // Empuja quitando vacíos y recortando a 100 caracteres (límite de GA4).
      const empujar = (event: string, datos: Datos) => {
        const out: Datos = { event };
        for (const [k, v] of Object.entries(datos)) {
          if (v === undefined || v === '') continue;
          out[k] = typeof v === 'string' ? v.slice(0, 100) : v;
        }
        dl().push(out);
      };

      // Zona de la página, sin tocar ningún componente.
      const zona = (el: Element): string => {
        if (el.closest('#site-nav[data-open="true"]')) return 'menu_movil';
        if (el.closest('.site-header')) return 'cabecera';
        if (el.closest('footer')) return 'pie';
        return 'cuerpo';
      };

      // Destino a partir del href.
      const destino = (a: HTMLAnchorElement | null): string | undefined => {
        const href = a?.getAttribute('href');
        if (!href || href === '#') return undefined;
        if (href === '/') return 'home';
        if (href.startsWith('tel:')) return 'telefono';
        if (href.startsWith('mailto:')) return 'correo';
        if (/^https?:\/\//.test(href) && !href.includes(location.host)) return 'externo';
        if (href === '/tours' || href === '/accessible-tours') return 'listado_tours';
        if (href.startsWith('/tours/')) return 'tour';
        if (href.startsWith('/blog')) return 'blog';
        if (href.startsWith('/contact')) return 'contacto';
        return 'otra';
      };

      // Clics: click_button, click_link, click_nav, click_image, phone_click, email_click.
      // En fase de captura (true): algunos componentes cortan la propagación del clic
      // (los desplegables del menú hacen stopPropagation) y en fase normal no llegaría.
      document.addEventListener('click', (e) => {
        const el = (e.target as Element | null)?.closest<HTMLElement>('[data-ev]');
        if (!el) return;
        const evento = el.dataset.ev!;
        const enlace = el.closest<HTMLAnchorElement>('a[href]');
        // data-ev-text manda: en una tarjeta, el texto completo traería la descripción entera.
        const texto = (el.dataset.evText ?? el.textContent ?? '').trim().replace(/\s+/g, ' ');
        const campoTexto = evento === 'click_button' ? 'button_text'
                         : evento === 'click_image'  ? 'image_alt'
                         : 'link_text';
        empujar(evento, {
          page_type: varPagina('page_type'),
          page_zone: zona(el),
          destino: el.dataset.evDest ?? destino(enlace),
          [campoTexto]: texto,
          tour_name: el.dataset.evTour ?? varPagina('tour_name'),
        });
      }, true);

      // toggle_faq. Atributo propio (data-ev-faq), nunca data-ev en el mismo elemento.
      // Este listener está en document, así que corre después del de FaqItem:
      // data-open ya tiene el estado nuevo.
      document.addEventListener('click', (e) => {
        const boton = (e.target as Element | null)?.closest<HTMLElement>('[data-ev-faq]');
        if (!boton) return;
        const abierto = boton.closest<HTMLElement>('.faq-item')?.dataset.open === 'true';
        empujar('toggle_faq', {
          page_type: varPagina('page_type'),
          page_zone: zona(boton),
          toggle_action: abierto ? 'abrir' : 'cerrar',
          toggle_question: boton.dataset.evFaq,
          tour_name: varPagina('tour_name'),
        });
      });

      // scroll_depth: 25, 50, 75 y 90 %, una vez cada uno por página.
      (() => {
        const umbrales = [25, 50, 75, 90];
        const vistos = new Set<number>();
        let pendiente = false;
        const medir = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          const pct = max > 0 ? (window.scrollY / max) * 100 : 100;
          for (const u of umbrales) {
            if (pct >= u && !vistos.has(u)) {
              vistos.add(u);
              empujar('scroll_depth', { page_type: varPagina('page_type'), percent_scrolled: u, tour_name: varPagina('tour_name') });
            }
          }
          if (vistos.size === umbrales.length) window.removeEventListener('scroll', alHacerScroll);
          pendiente = false;
        };
        const alHacerScroll = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(medir); } };
        window.addEventListener('scroll', alHacerScroll, { passive: true });
        medir();   // en páginas cortas, el 90 % ya se ve al cargar
      })();
    </script>
  </body>
</html>
