---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tourPageSchema } from '../../lib/tour';
import { contactHref, priceLabel } from '../../data/tours';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import HighlightsCarousel from '../../components/HighlightsCarousel.astro';

import heroImg from '../../assets/images/DJI_0368.jpg';
import anotherPlanetImg from '../../assets/images/reykjanes-piano-volcano-performance.jpg';
import expectImg from '../../assets/images/reykjanes-volcano-girl-walking.jpg';
import photographyImg from '../../assets/images/reykjanes-coastline-couple-shoot.jpg';
import whoForImg from '../../assets/images/DSCF0305.jpg';
import TourCtaPanel from '../../components/TourCtaPanel.astro';
import ctaImg from '../../assets/images/north-iceland-hot-steam-family.jpg';

import highlight1 from '../../assets/images/reykjanes-coastline.jpg';
import highlight2 from '../../assets/images/reykjanes-reykjanesviti-couple.jpg';
import highlight3 from '../../assets/images/brimketill-reykjanes.jpg';
import highlight4 from '../../assets/images/gunnuhver-hot-springs-reykjanes.jpg';
import highlight5 from '../../assets/images/reykjanes-peninsula-drone.jpg';
import highlight6 from '../../assets/images/reykjanes-gunnuhver-steam.jpg';
import highlight7 from '../../assets/images/reykjanes-lava-field-iceland.jpg';

// Issue #9: el slug de este tour en src/data/tours.ts. De ahi salen el precio
// del info bar y los CTA, que llevan al formulario con el tour ya elegido.
const TOUR_SLUG = 'secret-reykjanes';

const STATS = [
  { icon: 'clock', label: '7 hours', sub: 'Private tour' },
  { icon: 'map-pin', label: 'Reykjavik', sub: 'Keflavík pickup' },
  { icon: 'briefcase', label: priceLabel(TOUR_SLUG), sub: 'Year-round' },
];

const EXPECT = [
  'Explore ancient volcanic craters, geothermal fissures and bubbling mud pools',
  'Walk along dramatic sea cliffs and surreal lava formations',
  'Visit the oldest lighthouse in Iceland — complete with ghost stories',
  'Professional photography guidance throughout — go home with stunning shots',
  'Learn fun facts, Icelandic phrases and unique local insights along the way',
  'Flexible itinerary — adapted daily to weather, light and your interests',
];

const HIGHLIGHTS = [
  { image: highlight1, title: 'Valahnúkamöl Sea Cliffs', description: 'Towering basalt cliffs and crashing Atlantic waves — one of the most dramatic coastal landscapes in Iceland and almost always crowd-free.' },
  { image: highlight2, title: 'Reykjanesviti Lighthouse', description: 'The oldest lighthouse in Iceland, perched above the ocean with panoramic views across the peninsula. Rich in local history and folklore.' },
  { image: highlight3, title: 'Brimketill Lava Rock Pool', description: "A natural lava pool carved by the ocean at the edge of the peninsula — one of Reykjanes' best hidden spots and a favourite photography location." },
  { image: highlight4, title: 'Gunnuhver Geothermal Area', description: "Steaming vents, vivid colours and eerie local folklore make this one of Iceland's most atmospheric geothermal locations — and one of the least visited." },
  { image: highlight5, title: 'Lake Kleifarvatn', description: "Iceland's deepest lake, surrounded by hauntingly beautiful volcanic terrain. Mysterious, remote, and almost always empty of other tourists." },
  { image: highlight6, title: 'Krýsuvík Geothermal Area', description: "Colourful hot springs and active geothermal zones — a photographer's dream and a fascinating glimpse into Iceland's volcanic activity up close." },
  { image: highlight7, title: 'Hidden Lava Fields & Secret Locations', description: 'Off-the-map locations known only to locals — the kind of hidden Iceland spots that never appear in guidebooks or standard tour itineraries.' },
];

const WHO_FOR = [
  'Couples looking for a private Iceland experience away from crowds',
  'Photographers seeking dramatic volcanic landscapes and geothermal locations',
  'Families wanting a flexible, personalised day in Iceland',
  'Travellers arriving or departing via Keflavík Airport looking to make the most of their time',
  'Anyone who wants to experience the real Iceland beyond the standard tourist route',
];

const TOUR_NAME = 'The Hidden Side of Reykjanes';
const TOUR_INTRO = `This is a fully private tour — just your group, no strangers, no fixed schedule. Every stop is adapted to your pace, the weather, and the light conditions on the day.`;

const schema = await tourPageSchema(Astro.url.pathname, {
  name: TOUR_NAME,
  description: TOUR_INTRO,
  heroImage: heroImg,
  duration: STATS[0].label,
  highlights: HIGHLIGHTS.map((h) => h.title),
});
---

<Layout
  title="Secret Reykjanes Tour | 7-Hour Private Iceland Adventure"
  description="7-hour private Reykjanes tour. Volcanic craters, geothermal fields, sea cliffs & hidden lava formations just outside Reykjavík. Almost no tourists. Photography included."
  active="Tours"
  image={heroImg}
  imageAlt="Aerial view of a steaming geothermal vent on the Reykjanes Peninsula"
  schema={schema}
  hideContactPanel
  footerStyle="margin:0;border:none;border-radius:0"
>
  <Hero
    framedImage={heroImg}
    framedImageAlt="Aerial view of a steaming geothermal vent on the Reykjanes Peninsula"
    subtitle="Private Tour & Photography Experience with a Local Guide"
    primaryCta=""
    secondaryCta=""
  >
    <Fragment slot="title">{TOUR_NAME}</Fragment>
    <div class="tour-info-bar">
      <div class="tour-info-bar-stats">
        {STATS.map((s, i) => (
          <>
            {i > 0 ? <span aria-hidden="true" class="tour-info-bar-dot"></span> : null}
            <div style="display:flex;align-items:center;gap:var(--space-4)">
              <span style="width:48px;height:48px;border-radius:var(--radius-pill);background:var(--surface-chip);display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto">
                <Icon name={s.icon} size={20} color="var(--text-heading)" />
              </span>
              <div style="display:flex;flex-direction:column;gap:4px;text-align:left">
                <span style="font:700 16px/1.15 var(--font-sans);color:var(--text-heading);white-space:nowrap">{s.label}</span>
                <span style="font:500 13px/1 var(--font-sans);color:var(--text-body);white-space:nowrap">{s.sub}</span>
              </div>
            </div>
          </>
        ))}
      </div>
      <Button variant="dark" href={contactHref(TOUR_SLUG)} iconAfter="arrow-right">Check Availability</Button>
    </div>
  </Hero>

  <Breadcrumbs trail={[{ label: 'Tours', href: '/tours' }, { label: TOUR_NAME }]} />

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media media-frame" style="flex:0 0 450px;border-radius:32px;overflow:hidden;--media-ratio:450/800">
        <Image src={expectImg} alt="Traveler standing near an active lava eruption on the Reykjanes Peninsula" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px;align-items:flex-start">
        <div style="display:flex;flex-direction:column;gap:var(--space-4)">
          <h2 style="font:400 2.5rem/1.2 var(--font-display);color:#081824;margin:0">What to Expect on the Reykjanes Tour</h2>
          <p style="font:var(--type-lead);color:#081824;margin:0">{TOUR_INTRO}</p>
        </div>
        <div style="display:flex;flex-direction:column;width:100%">
          {EXPECT.map((item) => (
            <div style="display:flex;gap:var(--space-4);align-items:center;padding:var(--space-5) 0;border-bottom:1px solid var(--border-subtle)">
              <Icon name="check" size={20} color="var(--blue-500)" style="flex:0 0 auto" />
              <p style="font:var(--type-lead);color:#081824;margin:0">{item}</p>
            </div>
          ))}
        </div>
        <Button variant="outline" href="/how-it-works" iconAfter="arrow-right">How It Works</Button>
      </div>
    </div>
  </section>

  <HighlightsCarousel title="Reykjanes Highlights" highlights={HIGHLIGHTS} />

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media media-frame" style="flex:0 0 450px;border-radius:32px;overflow:hidden;--media-ratio:590/886">
        <Image src={whoForImg} alt="Traveler standing near the Reykjanesviti lighthouse" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px;align-items:flex-start">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Who this Reykjanes tour is for</h2>
        <div style="display:flex;flex-direction:column;width:100%">
          {WHO_FOR.map((item) => (
            <div style="padding:var(--space-6) 0;border-bottom:1px solid #c2b8ab">
              <p style="font:var(--type-lead);color:var(--text-heading);margin:0">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media media-frame" style="flex:0 0 450px;border-radius:32px;overflow:hidden;--media-ratio:450/800">
        <Image src={anotherPlanetImg} alt="Musician playing a keyboard on the black sand beach near a Reykjanes sea stack" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Another planet. One hour from Reykjavík.</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">The Reykjanes Peninsula is home to dramatic geothermal activity, steaming mud pools, vast moss-covered lava fields, and rugged volcanic coastlines. It is a region of raw beauty and constant change—a true representation of Iceland's fiery volcanic spirit, often overlooked by major tour buses.</p>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">This private custom tour allows us to explore the hidden nooks of Reykjanes at your own pace, with professional photography guidance to capture your memories against the most alien backdrops imaginable.</p>
      </div>
    </div>
  </section>

  <section class="tour-block">
    <div class="quote-panel">
      <div style="display:flex;gap:4px">
        {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} color="var(--star-gold)" />)}
      </div>
      <p style="font:400 28px/1.4 var(--font-display);color:var(--text-heading);margin:0;text-align:center;max-width:900px">"Our afternoon with Luke was wonderful! He is very patient, accommodating and knowledgeable of the area. He took us to so many beautiful places out of the crowds and took AMAZING photos that captured our memories forever. I highly recommend Luke if you are visiting Reykjavik!"</p>
      <div style="display:flex;flex-direction:column;gap:4px;align-items:center">
        <span style="font:700 14px/1 var(--font-sans);color:var(--text-heading)">Deborah F</span>
        <span style="font:400 12px/1 var(--font-sans);color:var(--text-muted);text-decoration:underline">United States · Tripadvisor Review</span>
      </div>
    </div>
  </section>

  <section class="tour-block tour-block-row" style="margin-bottom:var(--space-8)">
    <div class="tour-row">
      <div class="tour-row-media media-frame" style="flex:0 0 450px;border-radius:32px;overflow:hidden;--media-ratio:603/903">
        <Image src={photographyImg} alt="Couple sitting on a Reykjanes coastal cliff overlooking the ocean" width={900} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px;align-items:flex-start">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Photographing the Reykjanes Peninsula</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">The Reykjanes Peninsula is one of Iceland's finest photography destinations — dramatic contrasts of black lava, turquoise geothermal pools, ocean spray and volcanic steam create extraordinary images at every stop.</p>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">Whether you're joining an Iceland photography tour with a professional camera or capturing memories on your phone, every location on this route is chosen with the best light and composition in mind. Professional photography guidance is included throughout — this is not just a tour, it's an experience designed for travellers who want to come home with images that tell a real story.</p>
        <Button variant="outline" href="/photography-guide" iconAfter="arrow-right">See our photography tips</Button>
      </div>
    </div>
  </section>

  <TourCtaPanel
    href={contactHref(TOUR_SLUG)}
    title="Ready to book your Secret Reykjanes Tour?"
    lead="This is not just a tour — it's a private Iceland experience designed for travellers who crave real connection with nature, culture, and photography. Tell Luke's team your dates and group size and we'll take care of everything else."
    cta="Contact us"
    image={ctaImg}
    imageAlt="Family enjoying a geothermal steam vent on a private Reykjanes tour"
  />
</Layout>

<style>
  .tour-block { padding: var(--space-8); }
  .tour-row { display: flex; align-items: center; gap: var(--space-11); max-width: var(--container-max); margin: 0 auto; }
  /* Issue #78: la proporción de escritorio viaja en --media-ratio para que el
     breakpoint móvil la pueda sustituir por 1/1 sin recurrir a !important. */
  .tour-row-media { aspect-ratio: var(--media-ratio, 450/800); }

  .tour-info-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-7);
    background: var(--cream-50);
    border-radius: 100px;
    padding: var(--space-5) var(--space-7);
    max-width: 1200px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .tour-info-bar-stats { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  .tour-info-bar-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-900); flex: 0 0 auto; }

  @media (max-width: 1024px) {
    .tour-row { gap: var(--space-8); }
    .tour-row-media { flex-basis: 320px !important; }
  }
  @media (max-width: 768px) {
    .tour-row { flex-direction: column; align-items: stretch; }
    .tour-row-media { flex-basis: auto !important; width: 100%; order: -1; aspect-ratio: 1/1; }
    .tour-info-bar { flex-direction: column; border-radius: 32px; justify-content: center; }
    .tour-info-bar-stats { flex-direction: column; align-items: flex-start; justify-content: center; }
    .tour-info-bar-dot { display: none; }
    .tour-block { padding-left: var(--space-6); padding-right: var(--space-6); }
  }
</style>

