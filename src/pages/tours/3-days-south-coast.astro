---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tourPageSchema } from '../../lib/tour';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';

import heroImg from '../../assets/images/Web images/3-days-south-coast/south-coast-vestrahorn-photographer.jpg';
import anotherPlanetImg from '../../assets/images/Web images/3-days-south-coast/highlands-couple-iceland.jpg';
import expectImg from '../../assets/images/Web images/3-days-south-coast/south-coast-skogafoss-tour.jpg';
import photographyImg from '../../assets/images/Web images/3-days-south-coast/south-coast-horse-skogafoss-tour.jpg';
import whoForImg from '../../assets/images/Web images/3-days-south-coast/south-coast-family-tour.jpg';
import ctaImg from '../../assets/images/north-iceland-hot-steam-family.jpg';

import highlight1 from '../../assets/images/Web images/3-days-south-coast/south-coast-svartifoss-couple.jpg';
import highlight2 from '../../assets/images/Web images/3-days-south-coast/skogafoss-waterfall-iceland.jpg';
import highlight3 from '../../assets/images/Web images/3-days-south-coast/haifoss-waterfall.jpg';
import highlight4 from '../../assets/images/Web images/3-days-south-coast/black-sand-beach-iceland-girl-ocean.jpg';
import highlight5 from '../../assets/images/Web images/3-days-south-coast/south-coast-glacier-lagoon.jpg';

const STATS = [
  { icon: 'clock', label: '3 Days / 2 Nights', sub: 'Private tour' },
  { icon: 'map-pin', label: 'Reykjavík', sub: 'Departure' },
  { icon: 'briefcase', label: 'From $4500 / tour', sub: 'Year-round' },
];

const EXPECT = [
  "Iceland's most iconic waterfalls — Seljalandsfoss, Skógafoss and hidden alternatives",
  'Black sand beaches and dramatic coastal cliffs away from crowds',
  'Glacier lagoons and ice caves — the magic of glacial Iceland',
  'Professional photography guidance throughout — go home with stunning shots',
  'Learn fun facts, Icelandic phrases and unique local insights along the way',
  'Flexible itinerary — adapted daily to weather, light and your interests',
  'Local restaurant and accommodation recommendations included',
  'Comfortable luxury vehicle chosen for your group size',
  'Overnight stays in Vík with time to explore at your own pace',
];

const HIGHLIGHTS = [
  { image: highlight1, title: 'Vatnajökull National Park', description: "Europe's largest glacier and one of Iceland's most dramatic landscapes. Depending on season and conditions, this area offers waterfalls, glacier views, hiking opportunities and some of Iceland's most otherworldly scenery." },
  { image: highlight2, title: 'Skógafoss Waterfall', description: "Iceland's most powerful waterfall — dramatic, thundering, and magnificent. Luke's local knowledge includes the best vantage points and timing to avoid the worst of the tour bus crowds." },
  { image: highlight3, title: 'Hidden Waterfalls & Secret Spots', description: 'Away from the main route, Luke knows the waterfall hikes, hidden canyons, and viewpoints that create the most memorable moments — and the best photography opportunities.' },
  { image: highlight4, title: 'Reynisfjara Black Sand Beach', description: "Iceland's most famous beach with jet-black sand, towering basalt columns and crashing Atlantic waves. Luke knows how to capture it at the right moment without the postcard crowds." },
  { image: highlight5, title: 'Glacier Lagoon & Ice Caves', description: 'Jökulsárlón glacier lagoon — icebergs floating in brilliant blue water. For the ultimate experience, explore inside an actual ice cave, surrounded by the ethereal blue glow of ancient glacier ice.' },
];

const WHO_FOR = [
  "Anyone wanting 3 days immersed in Iceland's most dramatic and magical landscapes",
  'Couples looking for a romantic private Iceland experience away from crowds',
  'Families wanting flexible timing and local insights for all ages',
  'Photographers seeking dramatic landscapes with professional guidance',
  'Milestone trips — birthdays, anniversaries, proposals, special celebrations',
  'First-time visitors wanting to experience the real Iceland beyond the tourist route',
];

const TOUR_NAME = '3 Days Ultimate South Coast from Reykjavík';
const TOUR_INTRO = `This is a fully private tour — just your group, no strangers, no fixed schedule. Every stop is adapted to your pace, the weather, and the light conditions. You'll stay overnight in Vík, a small village at the heart of the South Coast, allowing for a relaxed pace and the best possible light for photography.`;

const schema = await tourPageSchema(Astro.url.pathname, {
  name: TOUR_NAME,
  description: TOUR_INTRO,
  heroImage: heroImg,
  duration: STATS[0].label,
  highlights: HIGHLIGHTS.map((h) => h.title),
});
---

<Layout
  title="South Coast Private Iceland | Private Multi-Day Iceland Tour"
  description="3-day private South Coast tour with 2 nights in Vík. Glaciers, ice caves, waterfalls & hidden canyons. Flexible itinerary, glacier hiking optional, photography included."
  active="Tours"
  image={heroImg}
  imageAlt="Photographer standing before dramatic mountains and a black sand beach on Iceland's South Coast"
  schema={schema}
  hideContactPanel
  footerStyle="margin:0;border:none;border-radius:0"
>
  <Hero
    framedImage={heroImg}
    framedImageAlt="Photographer standing before dramatic mountains and a black sand beach on Iceland's South Coast"
    subtitle="Private Tour & Photography Experience with a Local Guide"
    primaryCta=""
    secondaryCta=""
  >
    <Fragment slot="title">{TOUR_NAME}</Fragment>
    <div class="tour-info-bar">
      <div class="tour-info-bar-stats">
        {STATS.map((s, i) => (
          <>
            {i > 0 ? <span aria-hidden="true" class="tour-info-bar-dot"></span> : null}
            <div style="display:flex;align-items:center;gap:var(--space-4)">
              <span style="width:48px;height:48px;border-radius:var(--radius-pill);background:var(--surface-chip);display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto">
                <Icon name={s.icon} size={20} color="var(--text-heading)" />
              </span>
              <div style="display:flex;flex-direction:column;gap:4px;text-align:left">
                <span style="font:700 16px/1.15 var(--font-sans);color:var(--text-heading);white-space:nowrap">{s.label}</span>
                <span style="font:500 13px/1 var(--font-sans);color:var(--text-body);white-space:nowrap">{s.sub}</span>
              </div>
            </div>
          </>
        ))}
      </div>
      <Button variant="dark" href="/contact" iconAfter="arrow-right">Check Availability</Button>
    </div>
  </Hero>

  <Breadcrumbs trail={[{ label: 'Tours', href: '/tours' }, { label: TOUR_NAME }]} />

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media" style="flex:0 0 450px;border-radius:32px;overflow:hidden;aspect-ratio:450/800">
        <Image src={expectImg} alt="Travelers standing at the base of a powerful waterfall on Iceland's South Coast" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px;align-items:flex-start">
        <div style="display:flex;flex-direction:column;gap:var(--space-4)">
          <h2 style="font:400 2.5rem/1.2 var(--font-display);color:#081824;margin:0">What to Expect on the 3-Day South Coast Tour</h2>
          <p style="font:var(--type-lead);color:#081824;margin:0">{TOUR_INTRO}</p>
        </div>
        <div style="display:flex;flex-direction:column;width:100%">
          {EXPECT.map((item) => (
            <div style="display:flex;gap:var(--space-4);align-items:center;padding:var(--space-5) 0;border-bottom:1px solid var(--border-subtle)">
              <Icon name="check" size={20} color="var(--blue-500)" style="flex:0 0 auto" />
              <p style="font:var(--type-lead);color:#081824;margin:0">{item}</p>
            </div>
          ))}
        </div>
        <Button variant="outline" href="/how-it-works" iconAfter="arrow-right">How It Works</Button>
      </div>
    </div>
  </section>

  <section style="padding:var(--space-13) 0;background:var(--ink-900);overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:var(--space-11);max-width:var(--container-max);margin:0 auto">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:0 var(--space-8)">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--cream-100);margin:0">Highlights of Your 3-Day Journey</h2>
        <div style="display:flex;gap:var(--space-4)">
          <button type="button" class="highlights-arrow" data-dir="prev" aria-label="Previous highlight">
            <Icon name="arrow-right" size={18} style="transform:rotate(180deg)" />
          </button>
          <button type="button" class="highlights-arrow" data-dir="next" aria-label="Next highlight">
            <Icon name="arrow-right" size={18} />
          </button>
        </div>
      </div>
      <div class="highlights-carousel">
        {HIGHLIGHTS.map((h) => (
          <div class="highlight-card">
            <div style="border-radius:16px;overflow:hidden;aspect-ratio:16/10">
              <Image src={h.image} alt="" width={500} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
            </div>
            <div style="display:flex;flex-direction:column;gap:var(--space-3)">
              <span style="font:600 24px/1.2 var(--font-sans);color:var(--cream-100)">{h.title}</span>
              <p style="font:400 14px/1.5 var(--font-sans);color:rgba(244,237,225,.7);margin:0">{h.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media" style="flex:0 0 450px;border-radius:32px;overflow:hidden;aspect-ratio:590/886">
        <Image src={whoForImg} alt="Family group hiking near a South Coast waterfall in Iceland" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px;align-items:flex-start">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Who This 3-Day South Coast Tour Is For</h2>
        <div style="display:flex;flex-direction:column;width:100%">
          {WHO_FOR.map((item) => (
            <div style="padding:var(--space-6) 0;border-bottom:1px solid #c2b8ab">
              <p style="font:var(--type-lead);color:var(--text-heading);margin:0">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media" style="flex:0 0 450px;border-radius:32px;overflow:hidden;aspect-ratio:450/800">
        <Image src={anotherPlanetImg} alt="Couple admiring a rainbow at a South Coast waterfall in Iceland" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Iceland's most dramatic landscape. Three unforgettable days.</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">The South Coast is Iceland's most iconic region — and its most crowded. But with Luke's local knowledge, you'll discover the hidden waterfalls, secret viewpoints, and dramatic black sand beaches that most visitors miss while waiting in tour bus queues.</p>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">This private Iceland tour combines Iceland's most famous sites — Seljalandsfoss, Skógafoss, Reynisfjara, glacier lagoons and ice caves — with the kind of alternative routes, perfect timing and flexible itinerary that turns a good trip into an unforgettable one.</p>
      </div>
    </div>
  </section>

  <section class="tour-block">
    <div style="background:#dbd6c5;border-radius:32px;padding:var(--space-13) var(--space-8);width:100%;display:flex;flex-direction:column;gap:var(--space-9);align-items:center">
      <div style="display:flex;gap:4px">
        {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} color="var(--star-gold)" />)}
      </div>
      <p style="font:400 28px/1.4 var(--font-display);color:var(--text-heading);margin:0;text-align:center;max-width:900px">"The areas Luke took us were definitely off the beaten path. No tour buses or tourists. One particular waterfall was so grand that in all my travels, it was the most beautiful sight I've ever seen!!"</p>
      <div style="display:flex;flex-direction:column;gap:4px;align-items:center">
        <span style="font:700 14px/1 var(--font-sans);color:var(--text-heading)">Kathy H</span>
        <span style="font:400 12px/1 var(--font-sans);color:var(--text-muted);text-decoration:underline">Couples</span>
      </div>
    </div>
  </section>

  <section class="tour-block tour-block-row" style="margin-bottom:var(--space-8)">
    <div class="tour-row">
      <div class="tour-row-media" style="flex:0 0 450px;border-radius:32px;overflow:hidden;aspect-ratio:603/903">
        <Image src={photographyImg} alt="Icelandic horse standing before a frozen waterfall on Iceland's South Coast" width={900} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px;align-items:flex-start">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Photography Along the 3-Day Journey</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">The South Coast is one of Earth's most photogenic regions — but only if you know when and where to shoot. Waterfalls backlit by afternoon sun, black sand beaches during golden hour, glaciers in clear blue light — every location has a perfect moment.</p>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">Whether you're a professional photographer or capturing memories on your phone, every stop on this tour is chosen with light, composition and timing in mind. Professional photography guidance is included throughout — this is not just a tour, it's an experience designed for travellers who want to come home with images that tell a real story.</p>
        <Button variant="outline" href="/iceland-photography" iconAfter="arrow-right">See Our Photography Guide</Button>
      </div>
    </div>
  </section>

  <section style="background:#081824;border-radius:32px 32px 0 0;padding:var(--space-8)">
    <div style="position:relative;border-radius:24px;overflow:hidden;background:var(--cream-50);min-height:520px;display:flex;align-items:center;padding:var(--space-13)">
      <Image src={ctaImg} alt="Family enjoying a geothermal steam vent in North Iceland" width={1600} quality={80} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 25%" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg, rgba(251,246,240,.97) 40%, rgba(251,246,240,.15) 90%)"></div>
      <div style="position:relative;display:flex;flex-direction:column;gap:var(--space-9);align-items:flex-start;max-width:600px">
        <div style="display:flex;flex-direction:column;gap:var(--space-6)">
          <h2 style="font:400 3rem/1.1 var(--font-display);color:var(--text-heading);margin:0">Ready to book your 3 Days Ultimate South Coast Tour?</h2>
          <p style="font:400 18px/1.6 var(--font-sans);color:var(--text-body);margin:0">This is not just a tour — it's a private Iceland experience designed for travellers who crave real connection with nature, culture, and photography. Tell Luke's team your preferred dates and group size and we'll take care of everything else.</p>
        </div>
        <Button variant="primary" href="/contact">Book this Tour</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .tour-block { padding: var(--space-8); }
  .tour-row { display: flex; align-items: center; gap: var(--space-11); max-width: var(--container-max); margin: 0 auto; }

  .tour-info-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-7);
    background: var(--cream-50);
    border-radius: 100px;
    padding: var(--space-5) var(--space-7);
    max-width: 1200px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .tour-info-bar-stats { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  .tour-info-bar-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-900); flex: 0 0 auto; }

  .highlights-carousel {
    display: flex;
    gap: var(--space-7);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 var(--space-8);
    scroll-padding: 0 var(--space-8);
    scrollbar-width: none;
  }
  .highlights-carousel::-webkit-scrollbar { display: none; }
  .highlight-card {
    flex: 0 0 clamp(260px, 30vw, 420px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .highlights-arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255,255,255,.25);
    background: transparent;
    color: var(--cream-100);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-control);
  }
  .highlights-arrow:hover { background: rgba(255,255,255,.1); }
  .highlights-arrow:active { transform: var(--press-scale); }

  @media (max-width: 1024px) {
    .tour-row { gap: var(--space-8); }
    .tour-row-media { flex-basis: 320px !important; }
  }
  @media (max-width: 768px) {
    .tour-row { flex-direction: column; align-items: stretch; }
    .tour-row-media { flex-basis: auto !important; width: 100%; order: -1; }
    .tour-info-bar { flex-direction: column; border-radius: 32px; justify-content: center; }
    .tour-info-bar-stats { flex-direction: column; align-items: flex-start; justify-content: center; }
    .tour-info-bar-dot { display: none; }
  }
  @media (max-width: 640px) {
    .highlight-card { flex-basis: 78vw; }
    .tour-block { padding-left: var(--space-6); padding-right: var(--space-6); }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.highlights-carousel');
  const arrows = document.querySelectorAll<HTMLButtonElement>('.highlights-arrow');
  if (track) {
    // duplicate the set once so we can loop seamlessly — scrolling past the
    // end (or before the start) lands on identical cloned cards, then we
    // silently rewind by one set width so it feels infinite
    const originalCards = Array.from(track.children);
    originalCards.forEach((card) => {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    });

    const setWidth = () => track.scrollWidth / 2;

    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.highlight-card');
        const step = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
        if (btn.dataset.dir === 'prev' && track.scrollLeft - step < 0) {
          track.scrollLeft += setWidth();
        }
        track.scrollBy({ left: btn.dataset.dir === 'prev' ? -step : step, behavior: 'smooth' });
      });
    });

    let settleTimer: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(settleTimer);
      settleTimer = setTimeout(() => {
        const width = setWidth();
        if (track.scrollLeft >= width) track.scrollLeft -= width;
      }, 120);
    });
  }
</script>
