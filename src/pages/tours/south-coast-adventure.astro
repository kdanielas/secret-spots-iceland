---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tourPageSchema } from '../../lib/tour';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';

import heroImg from '../../assets/images/Web images/south-coast-adventure/DSCF8342.jpg';
import anotherPlanetImg from '../../assets/images/Web images/south-coast-adventure/south-coast-solheimajokull-glacier-outlet.jpg';
import expectImg from '../../assets/images/Web images/south-coast-adventure/south-coast-skogafoss-winter.jpg';
import photographyImg from '../../assets/images/Web images/south-coast-adventure/south-coast-snow-iceland.jpg';
import whoForImg from '../../assets/images/Web images/south-coast-adventure/south-coast-horse-skogafoss-tour.jpg';
import ctaImg from '../../assets/images/north-iceland-hot-steam-family.jpg';

import highlight1 from '../../assets/images/Web images/south-coast-adventure/black-sand-beach-iceland-girl-ocean.jpg';
import highlight2 from '../../assets/images/Web images/south-coast-adventure/skogafoss-waterfall-rainbow.webp';
import highlight3 from '../../assets/images/Web images/south-coast-adventure/south-coast-horse-skogafoss-tour.jpg';
import highlight4 from '../../assets/images/Web images/south-coast-adventure/puffin-dyrholaey-iceland.jpg';
import highlight5 from '../../assets/images/Web images/south-coast-adventure/vik-village.webp';
import highlight6 from '../../assets/images/Web images/south-coast-adventure/skogar-folk-museum-iceland.webp';

const STATS = [
  { icon: 'clock', label: '10 hours', sub: 'Private tour' },
  { icon: 'map-pin', label: 'Reykjavík', sub: 'Departure' },
  { icon: 'user', label: 'Private — just your group', sub: 'Available year-round' },
];

const EXPECT = [
  "Iceland's most iconic waterfalls — Seljalandsfoss and Skógafoss",
  "Black sand beach drama — Reynisfjara's basalt columns and sea stacks",
  'Glacier views and optional glacier hiking',
  'Dramatic coastal cliffs and seabird viewpoints',
  'Optional glacier hike with certified guides',
  'Professional photography guidance throughout — go home with stunning shots',
  'Flexible itinerary — adapted daily to weather, light and your interests',
  'Craft lunch or dinner in Vík village included',
  'Optional museum or exhibition visits to deepen your experience',
  'Luxury vehicle chosen for your group size and comfort',
];

const HIGHLIGHTS = [
  { image: highlight1, title: 'Reynisfjara Black Sand Beach', description: "Jet-black sand, towering basalt columns, and the Reynisdrangar sea stacks rising from the ocean — one of Iceland's most iconic landscapes, timed for the best light of the day." },
  { image: highlight2, title: 'Skógafoss Waterfall', description: 'A powerful, wide cascade into a misty canyon. Climb the stairs alongside it for panoramic views, or stand at the base and feel the spray.' },
  { image: highlight3, title: 'Sólheimajökull Glacier (Optional)', description: 'An easily accessible glacier. Optional 1-hour hike with certified guides — walking on ancient ice and exploring crevasses.' },
  { image: highlight4, title: 'Dyrhólaey Nature Reserve', description: 'Rich birdlife, dramatic cliffs, and a massive sea arch carved by the Atlantic — sweeping 360° views from this coastal promontory.' },
  { image: highlight5, title: 'Vík Village', description: "Iceland's southernmost village — craft lunch or dinner overlooking dramatic coastline, and a relaxed pause in the day." },
  { image: highlight6, title: 'Skógar Folk Museum', description: 'Turf houses, traditional boats, and heritage artifacts — a look at rural Icelandic life in past centuries.' },
];

const WHO_FOR = [
  'Families wanting to experience the complete Iceland in one epic journey',
  'Couples seeking an unforgettable adventure combining adventure and romance',
  "First-time visitors wanting to see everything Iceland is famous for — plus the hidden side",
  'Photographers pursuing the full range of Icelandic landscapes and light',
  'Groups wanting flexibility — each day can be customized based on interests and energy',
  'Multi-generational groups — from young children to grandparents, Luke adapts every day',
  'Anyone wanting professional photography throughout their entire Iceland adventure',
];

const REVIEWS = [
  { quote: "Luke is awesome both as a person and as a tour guide. On top of that he takes amazing photos. He has great in-depth knowledge about Iceland and knows all the good places to visit. Plus he's always ready to make extra efforts to deliver what guests want. My only regret is we just had him for 1 day!", name: 'Abhishek', type: 'Couple' },
  { quote: 'If you want a customized off-road adventure and photo session making you feel like the luckiest person in the world — go with Luke! He showed us so much, even during the short winter days.', name: 'razner', type: 'Family' },
  { quote: "Luke was a phenomenal tour guide! If you're looking for adventure off the beaten path, he's got you covered. He went above and beyond what we were looking for and suggested amazing spots we hadn't considered.", name: 'Liz B', type: 'Friends' },
  { quote: "We had an amazing time with Luke touring the South Coast. Two jam-packed days of breathtaking scenery, delicious food, and a local's insight. He's responsive, patient, fun, and his photography is the icing on the cake!", name: 'Jennifer Q', type: 'Family' },
  { quote: 'Luke created a flexible, weather-adaptable adventure that combined well-known sites with hidden treasures. His expert photography let us enjoy the moment instead of fumbling with our phones. Highly recommend!', name: 'Mehul P', type: 'Family' },
  { quote: "Luke provided a meaningful, personal, and dynamic tour! His energy was amazing and he kept us engaged during long drives. We sang, laughed, and shared incredible moments. I'm so thankful for the memories he captured!", name: 'Tanja P', type: 'Friends' },
];

const TOUR_NAME = 'South Coast Private Iceland';
const TOUR_INTRO = `This is a fully private tour — just your group, no strangers, no fixed schedule. You'll depart Reykjavík early, drive the scenic Ring Road southeast, and experience the South Coast at a relaxed pace. Optional stops let you customize the day — visit museums, hike a glacier, explore coastal cliffs, or simply find the perfect light for photography.`;

const schema = await tourPageSchema(Astro.url.pathname, {
  name: TOUR_NAME,
  description: TOUR_INTRO,
  heroImage: heroImg,
  duration: STATS[0].label,
  highlights: HIGHLIGHTS.map((h) => h.title),
});
---

<Layout
  title="South Coast Iceland Tour | 10 Hours Waterfalls, Glaciers & Black Sand"
  description="10-hour private South Coast tour. Seljalandsfoss, Skógafoss, Reynisfjara black sand beach & glacier views. Flexible itinerary, professional photography, no tour buses."
  active="Tours"
  image={heroImg}
  imageAlt="Couple standing on the moss-covered lava fields of Iceland's South Coast"
  schema={schema}
  hideContactPanel
  footerStyle="margin:0;border:none;border-radius:0"
>
  <Hero
    framedImage={heroImg}
    framedImageAlt="Couple standing on the moss-covered lava fields of Iceland's South Coast"
    subtitle="Private Tour & Photography Experience with a Local Guide"
    primaryCta=""
    secondaryCta=""
  >
    <Fragment slot="title">{TOUR_NAME}</Fragment>
    <div class="tour-info-bar">
      <div class="tour-info-bar-stats">
        {STATS.map((s, i) => (
          <>
            {i > 0 ? <span aria-hidden="true" class="tour-info-bar-dot"></span> : null}
            <div style="display:flex;align-items:center;gap:var(--space-4)">
              <span style="width:48px;height:48px;border-radius:var(--radius-pill);background:var(--surface-chip);display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto">
                <Icon name={s.icon} size={20} color="var(--text-heading)" />
              </span>
              <div style="display:flex;flex-direction:column;gap:4px;text-align:left">
                <span style="font:700 16px/1.15 var(--font-sans);color:var(--text-heading);white-space:nowrap">{s.label}</span>
                <span style="font:500 13px/1 var(--font-sans);color:var(--text-body);white-space:nowrap">{s.sub}</span>
              </div>
            </div>
          </>
        ))}
      </div>
      <Button variant="dark" href="/contact" iconAfter="arrow-right">Check Availability</Button>
    </div>
  </Hero>

  <Breadcrumbs trail={[{ label: 'Tours', href: '/tours' }, { label: TOUR_NAME }]} />

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media" style="flex:0 0 450px;border-radius:32px;overflow:hidden;aspect-ratio:450/800">
        <Image src={expectImg} alt="Traveler in a maroon winter coat standing on ice in front of the frozen Skógafoss waterfall" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px;align-items:flex-start">
        <div style="display:flex;flex-direction:column;gap:var(--space-4)">
          <h2 style="font:400 2.5rem/1.2 var(--font-display);color:#081824;margin:0">What to Expect on the South Coast Tour</h2>
          <p style="font:var(--type-lead);color:#081824;margin:0">{TOUR_INTRO}</p>
        </div>
        <div style="display:flex;flex-direction:column;width:100%">
          {EXPECT.map((item) => (
            <div style="display:flex;gap:var(--space-4);align-items:center;padding:var(--space-5) 0;border-bottom:1px solid var(--border-subtle)">
              <Icon name="check" size={20} color="var(--blue-500)" style="flex:0 0 auto" />
              <p style="font:var(--type-lead);color:#081824;margin:0">{item}</p>
            </div>
          ))}
        </div>
        <Button variant="outline" href="/how-it-works" iconAfter="arrow-right">How It Works</Button>
      </div>
    </div>
  </section>

  <section style="padding:var(--space-13) 0;background:var(--ink-900);overflow:hidden">
    <div style="display:flex;flex-direction:column;gap:var(--space-11);max-width:var(--container-max);margin:0 auto">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:0 var(--space-8)">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--cream-100);margin:0">South Coast Highlights</h2>
        <div style="display:flex;gap:var(--space-4)">
          <button type="button" class="highlights-arrow" data-dir="prev" aria-label="Previous highlight">
            <Icon name="arrow-right" size={18} style="transform:rotate(180deg)" />
          </button>
          <button type="button" class="highlights-arrow" data-dir="next" aria-label="Next highlight">
            <Icon name="arrow-right" size={18} />
          </button>
        </div>
      </div>
      <div class="highlights-carousel">
        {HIGHLIGHTS.map((h) => (
          <div class="highlight-card">
            <div style="border-radius:16px;overflow:hidden;aspect-ratio:16/10">
              <Image src={h.image} alt="" width={500} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
            </div>
            <div style="display:flex;flex-direction:column;gap:var(--space-3)">
              <span style="font:600 24px/1.2 var(--font-sans);color:var(--cream-100)">{h.title}</span>
              <p style="font:400 14px/1.5 var(--font-sans);color:rgba(244,237,225,.7);margin:0">{h.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media" style="flex:0 0 450px;border-radius:32px;overflow:hidden;aspect-ratio:590/886">
        <Image src={whoForImg} alt="White Icelandic horse standing in icy water at the base of a frozen South Coast waterfall" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px;align-items:flex-start">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">This tour is perfect for</h2>
        <div style="display:flex;flex-direction:column;width:100%">
          {WHO_FOR.map((item) => (
            <div style="padding:var(--space-6) 0;border-bottom:1px solid #c2b8ab">
              <p style="font:var(--type-lead);color:var(--text-heading);margin:0">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media" style="flex:0 0 450px;border-radius:32px;overflow:hidden;aspect-ratio:450/800">
        <Image src={anotherPlanetImg} alt="Glacier outlet on Iceland's South Coast" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Iceland's most iconic landscapes in one unforgettable day</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">The South Coast is where Iceland reveals its raw power — dramatic waterfalls plunging from sheer cliffs, black sand beaches with towering basalt columns, glaciers calving into lagoons, and cliffs carved by centuries of Atlantic waves. It's Iceland's most famous route, which means crowds. But with Luke's local knowledge, flexible timing, and professional photography, you'll experience the South Coast the way it's meant to be experienced — without the tour bus queues.</p>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">This full-day private Iceland tour takes you through landscapes carved by ice, fire, and ocean. From Seljalandsfoss and Skógafoss waterfalls to Reynisfjara black sand beach and optional glacier adventures, every stop is adapted to light conditions, weather, and what you want to experience most.</p>
      </div>
    </div>
  </section>

  <section class="tour-block">
    <div class="review-carousel" style="background:#dbd6c5;border-radius:32px;padding:var(--space-13) var(--space-8);width:100%;display:flex;flex-direction:column;gap:var(--space-9);align-items:center">
      <div style="display:flex;gap:4px">
        {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} color="var(--star-gold)" />)}
      </div>
      <p class="review-quote" style="font:400 28px/1.4 var(--font-display);color:var(--text-heading);margin:0;text-align:center;max-width:900px">"{REVIEWS[0].quote}"</p>
      <div style="display:flex;flex-direction:column;gap:4px;align-items:center">
        <span class="review-name" style="font:700 14px/1 var(--font-sans);color:var(--text-heading)">{REVIEWS[0].name}</span>
        <span class="review-type" style="font:400 12px/1 var(--font-sans);color:var(--text-muted);text-decoration:underline">{REVIEWS[0].type}</span>
      </div>
      <div style="display:flex;gap:var(--space-4)">
        <button type="button" class="testimonial-arrow" data-dir="prev" aria-label="Previous review">
          <Icon name="arrow-right" size={18} style="transform:rotate(180deg)" />
        </button>
        <button type="button" class="testimonial-arrow" data-dir="next" aria-label="Next review">
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
    </div>
  </section>

  <section class="tour-block tour-block-row" style="margin-bottom:var(--space-8)">
    <div class="tour-row">
      <div class="tour-row-media" style="flex:0 0 450px;border-radius:32px;overflow:hidden;aspect-ratio:603/903">
        <Image src={photographyImg} alt="Woman standing in a snowy South Coast field with mountains and trees in the background" width={900} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px;align-items:flex-start">
        <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Photography Experience on This South Coast Iceland Tour</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">The South Coast is one of Earth's most photogenic regions — but only if you know when and where to shoot. Golden hour light hitting Seljalandsfoss, dramatic cloud formations over Reynisfjara, glacial mist at the right moment, seabirds catching light above the cliffs — every location has a perfect window.</p>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">Professional photography guidance is included throughout the full 10-hour day. Luke will help you find the best angles, time the light perfectly, suggest compositions, and capture the moments that make the South Coast unforgettable — not just the famous views, but your personal experience of this raw landscape.</p>
        <Button variant="outline" href="/iceland-photography" iconAfter="arrow-right">See Our Photography Guide</Button>
      </div>
    </div>
  </section>

  <section style="background:#081824;border-radius:32px 32px 0 0;padding:var(--space-8)">
    <div style="position:relative;border-radius:24px;overflow:hidden;background:var(--cream-50);min-height:520px;display:flex;align-items:center;padding:var(--space-13)">
      <Image src={ctaImg} alt="Family enjoying a geothermal steam vent in North Iceland" width={1600} quality={80} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 25%" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg, rgba(251,246,240,.97) 40%, rgba(251,246,240,.15) 90%)"></div>
      <div style="position:relative;display:flex;flex-direction:column;gap:var(--space-9);align-items:flex-start;max-width:600px">
        <div style="display:flex;flex-direction:column;gap:var(--space-6)">
          <h2 style="font:400 3rem/1.1 var(--font-display);color:var(--text-heading);margin:0">Ready to Experience a South Coast Photography Tour in Iceland?</h2>
          <p style="font:400 18px/1.6 var(--font-sans);color:var(--text-body);margin:0">This is not just a tour — it's a private Iceland experience designed for travellers who want to experience the South Coast the way it's meant to be — without the crowds, with flexible timing, and with professional photography capturing every moment. Tell Luke's team your preferred date and group size and we'll take care of everything else.</p>
        </div>
        <Button variant="primary" href="/contact">Check Availability & Book</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .tour-block { padding: var(--space-8); }
  .tour-row { display: flex; align-items: center; gap: var(--space-11); max-width: var(--container-max); margin: 0 auto; }

  .tour-info-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-7);
    background: var(--cream-50);
    border-radius: 100px;
    padding: var(--space-5) var(--space-7);
    max-width: 1200px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .tour-info-bar-stats { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  .tour-info-bar-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-900); flex: 0 0 auto; }

  .highlights-carousel {
    display: flex;
    gap: var(--space-7);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 var(--space-8);
    scroll-padding: 0 var(--space-8);
    scrollbar-width: none;
  }
  .highlights-carousel::-webkit-scrollbar { display: none; }
  .highlight-card {
    flex: 0 0 clamp(260px, 30vw, 420px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .highlights-arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255,255,255,.25);
    background: transparent;
    color: var(--cream-100);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-control);
  }
  .highlights-arrow:hover { background: rgba(255,255,255,.1); }
  .highlights-arrow:active { transform: var(--press-scale); }

  @media (max-width: 1024px) {
    .tour-row { gap: var(--space-8); }
    .tour-row-media { flex-basis: 320px !important; }
  }
  @media (max-width: 768px) {
    .tour-row { flex-direction: column; align-items: stretch; }
    .tour-row-media { flex-basis: auto !important; width: 100%; order: -1; }
    .tour-info-bar { flex-direction: column; border-radius: 32px; justify-content: center; }
    .tour-info-bar-stats { flex-direction: column; align-items: flex-start; justify-content: center; }
    .tour-info-bar-dot { display: none; }
  }
  @media (max-width: 640px) {
    .highlight-card { flex-basis: 78vw; }
    .tour-block { padding-left: var(--space-6); padding-right: var(--space-6); }
  }

  .testimonial-arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--cream-50);
    color: var(--ink-900);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-control);
  }
  .testimonial-arrow:hover { background: var(--cream-100); }
  .testimonial-arrow:active { transform: var(--press-scale); }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.highlights-carousel');
  const arrows = document.querySelectorAll<HTMLButtonElement>('.highlights-arrow');
  if (track) {
    // duplicate the set once so we can loop seamlessly — scrolling past the
    // end (or before the start) lands on identical cloned cards, then we
    // silently rewind by one set width so it feels infinite
    const originalCards = Array.from(track.children);
    originalCards.forEach((card) => {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    });

    const setWidth = () => track.scrollWidth / 2;

    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.highlight-card');
        const step = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
        if (btn.dataset.dir === 'prev' && track.scrollLeft - step < 0) {
          track.scrollLeft += setWidth();
        }
        track.scrollBy({ left: btn.dataset.dir === 'prev' ? -step : step, behavior: 'smooth' });
      });
    });

    let settleTimer: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(settleTimer);
      settleTimer = setTimeout(() => {
        const width = setWidth();
        if (track.scrollLeft >= width) track.scrollLeft -= width;
      }, 120);
    });
  }
</script>

<script define:vars={{ REVIEWS }}>
  const carousel = document.querySelector('.review-carousel');
  if (carousel) {
    const quoteEl = carousel.querySelector('.review-quote');
    const nameEl = carousel.querySelector('.review-name');
    const typeEl = carousel.querySelector('.review-type');
    const arrows = carousel.querySelectorAll('.testimonial-arrow');
    let index = 0;
    let autoTimer;

    // lock the quote's height to the tallest review so switching never
    // resizes the card (re-measured on resize since wrapping changes with width)
    function lockQuoteHeight() {
      const original = quoteEl.textContent;
      quoteEl.style.minHeight = '';
      let max = 0;
      REVIEWS.forEach((r) => {
        quoteEl.textContent = `"${r.quote}"`;
        max = Math.max(max, quoteEl.getBoundingClientRect().height);
      });
      quoteEl.textContent = original;
      quoteEl.style.minHeight = `${max}px`;
    }

    function render() {
      quoteEl.textContent = `"${REVIEWS[index].quote}"`;
      nameEl.textContent = REVIEWS[index].name;
      typeEl.textContent = REVIEWS[index].type;
    }

    function next() {
      index = (index + 1) % REVIEWS.length;
      render();
    }

    function startAuto() {
      clearInterval(autoTimer);
      autoTimer = setInterval(next, 7000);
    }

    arrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.dir === 'prev') {
          index = (index - 1 + REVIEWS.length) % REVIEWS.length;
        } else {
          index = (index + 1) % REVIEWS.length;
        }
        render();
        startAuto();
      });
    });

    lockQuoteHeight();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(lockQuoteHeight);
    }
    startAuto();

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(lockQuoteHeight, 150);
    });
  }
</script>
