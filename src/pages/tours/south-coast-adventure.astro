---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tourPageSchema } from '../../lib/tour';
import { contactHref } from '../../data/tours';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import HighlightsCarousel from '../../components/HighlightsCarousel.astro';
import ReviewCarousel from '../../components/ReviewCarousel.astro';

import heroImg from '../../assets/images/Web images/south-coast-adventure/south-coast-mossy-lava-field-couple.webp';
import anotherPlanetImg from '../../assets/images/Web images/south-coast-adventure/south-coast-solheimajokull-glacier-outlet.webp';
import expectImg from '../../assets/images/Web images/south-coast-adventure/south-coast-skogafoss-winter.webp';
import photographyImg from '../../assets/images/Web images/south-coast-adventure/south-coast-snow-iceland.webp';
import whoForImg from '../../assets/images/Web images/south-coast-adventure/south-coast-horse-skogafoss-tour.webp';
import ContactPanel from '../../components/ContactPanel.astro';
import ctaImg from '../../assets/images/north-iceland-hot-steam-family.webp';

import highlight1 from '../../assets/images/Web images/south-coast-adventure/black-sand-beach-iceland-girl-ocean.webp';
import highlight2 from '../../assets/images/Web images/south-coast-adventure/skogafoss-waterfall-rainbow.webp';
import highlight3 from '../../assets/images/Web images/south-coast-adventure/south-coast-horse-skogafoss-tour.webp';
import highlight4 from '../../assets/images/Web images/south-coast-adventure/puffin-dyrholaey-iceland.webp';
import highlight5 from '../../assets/images/Web images/south-coast-adventure/vik-village.webp';
import highlight6 from '../../assets/images/Web images/south-coast-adventure/skogar-folk-museum-iceland.webp';

// Issue #9: el slug de este tour en src/data/tours.ts, para que los CTA lleven
// al formulario con el tour ya elegido.
const TOUR_SLUG = 'south-coast-waterfalls';

const STATS = [
  { icon: 'clock', label: '10 hours', sub: 'Private tour' },
  { icon: 'map-pin', label: 'Reykjavík', sub: 'Departure' },
  { icon: 'user', label: 'Private — just your group', sub: 'Available year-round' },
];

const EXPECT = [
  "Iceland's most iconic waterfalls — Seljalandsfoss and Skógafoss",
  "Black sand beach drama — Reynisfjara's basalt columns and sea stacks",
  'Glacier views and optional glacier hiking',
  'Dramatic coastal cliffs and seabird viewpoints',
  'Optional glacier hike with certified guides',
  'Professional photography guidance throughout — go home with stunning shots',
  'Flexible itinerary — adapted daily to weather, light and your interests',
  'Craft lunch or dinner in Vík village included',
  'Optional museum or exhibition visits to deepen your experience',
  'Luxury vehicle chosen for your group size and comfort',
];

const HIGHLIGHTS = [
  { image: highlight1, alt: 'Traveller in a black coat and yellow scarf on the black sand of Reynisfjara at dusk, with basalt columns and a sea stack offshore', title: 'Reynisfjara Black Sand Beach', description: "Jet-black sand, towering basalt columns, and the Reynisdrangar sea stacks rising from the ocean — one of Iceland's most iconic landscapes, timed for the best light of the day." },
  { image: highlight2, alt: 'Visitors standing in front of Skógafoss waterfall with a full double rainbow arching through its spray, on the South Coast of Iceland', title: 'Skógafoss Waterfall', description: 'A powerful, wide cascade into a misty canyon. Climb the stairs alongside it for panoramic views, or stand at the base and feel the spray.' },
  { image: highlight3, alt: 'White Icelandic horse standing in a river below a frozen waterfall on the South Coast of Iceland in winter', title: 'Sólheimajökull Glacier (Optional)', description: 'An easily accessible glacier. Optional 1-hour hike with certified guides — walking on ancient ice and exploring crevasses.' },
  { image: highlight4, alt: 'Puffin with its wings raised on the grassy clifftop of Dyrhólaey, on the South Coast of Iceland', title: 'Dyrhólaey Nature Reserve', description: 'Rich birdlife, dramatic cliffs, and a massive sea arch carved by the Atlantic — sweeping 360° views from this coastal promontory.' },
  { image: highlight5, alt: 'The village of Vík with its red-roofed church on the green hillside and the Reynisdrangar sea stacks offshore', title: 'Vík Village', description: "Iceland's southernmost village — craft lunch or dinner overlooking dramatic coastline, and a relaxed pause in the day." },
  { image: highlight6, alt: 'Turf-roofed and timber buildings of the Skógar folk museum below an autumn hillside on the South Coast of Iceland', title: 'Skógar Folk Museum', description: 'Turf houses, traditional boats, and heritage artifacts — a look at rural Icelandic life in past centuries.' },
];

const WHO_FOR = [
  'Families wanting to experience the complete Iceland in one epic journey',
  'Couples seeking an unforgettable adventure combining adventure and romance',
  "First-time visitors wanting to see everything Iceland is famous for — plus the hidden side",
  'Photographers pursuing the full range of Icelandic landscapes and light',
  'Groups wanting flexibility — each day can be customized based on interests and energy',
  'Multi-generational groups — from young children to grandparents, Luke adapts every day',
  'Anyone wanting professional photography throughout their entire Iceland adventure',
];

const REVIEWS = [
  { quote: "Luke is awesome both as a person and as a tour guide. On top of that he takes amazing photos. He has great in-depth knowledge about Iceland and knows all the good places to visit. Plus he's always ready to make extra efforts to deliver what guests want. My only regret is we just had him for 1 day!", name: 'Abhishek', type: 'Couple' },
  { quote: 'If you want a customized off-road adventure and photo session making you feel like the luckiest person in the world — go with Luke! He showed us so much, even during the short winter days.', name: 'razner', type: 'Family' },
  { quote: "Luke was a phenomenal tour guide! If you're looking for adventure off the beaten path, he's got you covered. He went above and beyond what we were looking for and suggested amazing spots we hadn't considered.", name: 'Liz B', type: 'Friends' },
  { quote: "We had an amazing time with Luke touring the South Coast. Two jam-packed days of breathtaking scenery, delicious food, and a local's insight. He's responsive, patient, fun, and his photography is the icing on the cake!", name: 'Jennifer Q', type: 'Family' },
  { quote: 'Luke created a flexible, weather-adaptable adventure that combined well-known sites with hidden treasures. His expert photography let us enjoy the moment instead of fumbling with our phones. Highly recommend!', name: 'Mehul P', type: 'Family' },
  { quote: "Luke provided a meaningful, personal, and dynamic tour! His energy was amazing and he kept us engaged during long drives. We sang, laughed, and shared incredible moments. I'm so thankful for the memories he captured!", name: 'Tanja P', type: 'Friends' },
];

const TOUR_NAME = 'South Coast Private Iceland';
const TOUR_INTRO = `This is a fully private tour — just your group, no strangers, no fixed schedule. You'll depart Reykjavík early, drive the scenic Ring Road southeast, and experience the South Coast at a relaxed pace. Optional stops let you customize the day — visit museums, hike a glacier, explore coastal cliffs, or simply find the perfect light for photography.`;

const schema = await tourPageSchema(Astro.url.pathname, {
  name: TOUR_NAME,
  description: TOUR_INTRO,
  heroImage: heroImg,
  duration: STATS[0].label,
  highlights: HIGHLIGHTS.map((h) => h.title),
});
---

<Layout
  title="South Coast Iceland Tour | Waterfalls, Glaciers & Black Sand"
  description="10-hour private South Coast tour. Seljalandsfoss, Skógafoss, Reynisfjara black sand beach & glacier views. Flexible itinerary, professional photography, no tour buses."
  active="Tours"
  image={heroImg}
  imageAlt="Couple standing on the moss-covered lava fields of Iceland's South Coast"
  schema={schema}
  hideContactPanel
  footerStyle="margin:0;border:none;border-radius:0"
>
  <Hero
    framedImage={heroImg}
    framedImageAlt="Couple standing on the moss-covered lava fields of Iceland's South Coast"
    subtitle="Private Tour & Photography Experience with a Local Guide"
    primaryCta=""
    secondaryCta=""
  >
    <Fragment slot="title">{TOUR_NAME}</Fragment>
    <div class="tour-info-bar">
      <div class="tour-info-bar-stats">
        {STATS.map((s, i) => (
          <>
            {i > 0 ? <span aria-hidden="true" class="tour-info-bar-dot"></span> : null}
            <div class="row-center gap-4">
              <span class="icon-disc">
                <Icon name={s.icon} size={20} color="var(--text-heading)" />
              </span>
              <div class="stack gap-2 text-left">
                <span class="stat-value">{s.label}</span>
                <span class="stat-label">{s.sub}</span>
              </div>
            </div>
          </>
        ))}
      </div>
      <Button variant="dark" href={contactHref(TOUR_SLUG)} iconAfter="arrow-right">Check Availability</Button>
    </div>
  </Hero>

  <Breadcrumbs trail={[{ label: 'Tours', href: '/tours' }, { label: TOUR_NAME }]} />

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media media-frame" style="--media-ratio:450/800">
        <Image class="cover" src={expectImg} alt="Traveler in a maroon winter coat standing on ice in front of the frozen Skógafoss waterfall" width={700} quality={80} loading="lazy" />
      </div>
      <div class="text-col items-start">
        <div class="stack gap-4">
          <h2 class="sh-lg title-ink-deep">What to Expect on the South Coast Tour</h2>
          <p class="lead-deep">{TOUR_INTRO}</p>
        </div>
        <div class="stack w-full">
          {EXPECT.map((item) => (
            <div class="feature-row">
              <Icon name="check" size={20} color="var(--blue-500)" />
              <p class="lead-deep">{item}</p>
            </div>
          ))}
        </div>
        <Button variant="outline" href="/how-it-works" iconAfter="arrow-right">How It Works</Button>
      </div>
    </div>
  </section>

  <HighlightsCarousel title="South Coast Highlights" highlights={HIGHLIGHTS} />

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media media-frame" style="--media-ratio:590/886">
        <Image class="cover" src={whoForImg} alt="White Icelandic horse standing in icy water at the base of a frozen South Coast waterfall" width={700} quality={80} loading="lazy" />
      </div>
      <div class="text-col items-start">
        <h2 class="sh-lg title-ink">This tour is perfect for</h2>
        <div class="stack w-full">
          {WHO_FOR.map((item) => (
            <div class="spec-row">
              <p class="lead-heading">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="tour-block tour-block-row">
    <div class="tour-row">
      <div class="tour-row-media media-frame" style="--media-ratio:450/800">
        <Image class="cover" src={anotherPlanetImg} alt="Glacier outlet on Iceland's South Coast" width={700} quality={80} loading="lazy" />
      </div>
      <div class="text-col">
        <h2 class="sh-lg title-ink">Iceland's most iconic landscapes in one unforgettable day</h2>
        <p class="lead-body">The South Coast is where Iceland reveals its raw power — dramatic waterfalls plunging from sheer cliffs, black sand beaches with towering basalt columns, glaciers calving into lagoons, and cliffs carved by centuries of Atlantic waves. It's Iceland's most famous route, which means crowds. But with Luke's local knowledge, flexible timing, and professional photography, you'll experience the South Coast the way it's meant to be experienced — without the tour bus queues.</p>
        <p class="lead-body">This full-day private Iceland tour takes you through landscapes carved by ice, fire, and ocean. From Seljalandsfoss and Skógafoss waterfalls to Reynisfjara black sand beach and optional glacier adventures, every stop is adapted to light conditions, weather, and what you want to experience most.</p>
      </div>
    </div>
  </section>

  <section class="tour-block">
    <ReviewCarousel reviews={REVIEWS} label="South Coast Adventure guest reviews" />
  </section>

  <section class="tour-block tour-block-row mb-8">
    <div class="tour-row">
      <div class="tour-row-media media-frame" style="--media-ratio:603/903">
        <Image class="cover" src={photographyImg} alt="Woman standing in a snowy South Coast field with mountains and trees in the background" width={900} quality={80} loading="lazy" />
      </div>
      <div class="text-col items-start">
        <h2 class="sh-lg title-ink">Photography Experience on This South Coast Iceland Tour</h2>
        <p class="lead-body">The South Coast is one of Earth's most photogenic regions — but only if you know when and where to shoot. Golden hour light hitting Seljalandsfoss, dramatic cloud formations over Reynisfjara, glacial mist at the right moment, seabirds catching light above the cliffs — every location has a perfect window.</p>
        <p class="lead-body">Professional photography guidance is included throughout the full 10-hour day. Luke will help you find the best angles, time the light perfectly, suggest compositions, and capture the moments that make the South Coast unforgettable — not just the famous views, but your personal experience of this raw landscape.</p>
        <Button variant="outline" href="/iceland-photography" iconAfter="arrow-right">See Our Photography Guide</Button>
      </div>
    </div>
  </section>

  <ContactPanel
    href={contactHref(TOUR_SLUG)}
    title="Ready to Experience a South Coast Photography Tour in Iceland?"
    lead="This is not just a tour — it's a private Iceland experience designed for travellers who want to experience the South Coast the way it's meant to be — without the crowds, with flexible timing, and with professional photography capturing every moment. Tell Luke's team your preferred date and group size and we'll take care of everything else."
    cta="Check Availability & Book"
    image={ctaImg}
    imageAlt="Family enjoying a geothermal steam vent in North Iceland"
  />
</Layout>
