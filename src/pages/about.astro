---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';

import heroImg from '../assets/images/reykjanes-photographer-luke.jpg';
import passionImg from '../assets/images/Web images/about-luke/landmannalaugar-guide.jpg';
import photographerImg from '../assets/images/reykjanes-photography-tour.jpg';
import toursImg from '../assets/images/Web images/about-luke/northern-lights-icei.jpg';
---

<Layout
  title="Meet Luke — Iceland Private Guide & Photographer (20+ Years)"
  description="Luke has spent nearly 20 years exploring and photographing Iceland. Private tours built around what you want to see — not what every tour bus does."
  active="About"
  contactPanelStyle="background:var(--surface-footer)"
  footerStyle="border:none"
>
  <Hero
    framedImage={heroImg}
    framedImageAlt="Luke, local guide and photographer, exploring Iceland's highlands"
    subtitle="Private Tour & Photography Experience with a Local Guide"
    primaryCta=""
    secondaryCta=""
  >
    <Fragment slot="title">Meet Luke | Private Iceland Tours with a Local Guide & Photographer in Hidden Iceland</Fragment>
  </Hero>

  <section class="about-block">
    <div class="about-row">
      <div class="about-row-media media-frame" style="flex:0 0 533px;border-radius:32px;overflow:hidden;aspect-ratio:533/800">
        <Image class="cover" src={passionImg} alt="Local guide standing on a ridge overlooking the Icelandic highlands" width={700} quality={80} loading="lazy" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-9);max-width:565px">
        <div style="display:flex;flex-direction:column;gap:var(--space-7)">
          <h2 class="page-section-title">Born from a passion for exploration</h2>
          <div class="stack gap-5">
            <p class="lead-heading">It didn't start as a business. It started as an obsession. For nearly 20 years Luke has been exploring Iceland's dramatic landscapes, hidden waterfalls, remote highlands, and lesser-known corners of the island — backroads that didn't appear on maps, unique viewpoints that many visitors never get to see, and hidden gems that reveal a quieter side of the country, away from crowded tourist routes.</p>
            <p class="lead-heading">What began as a passion for adventure and photography eventually became Secret Spots of Iceland — a way to share the places he loves most with travellers from around the world.</p>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:var(--space-7)">
          <h2 class="page-section-title">Why &ldquo;Secret Spots&rdquo;</h2>
          <p class="lead-heading">When Luke talks about Secret Spots, he doesn't mean places no one has ever visited. He means alternative viewpoints, lesser-known waterfalls, perfect timing, and the hidden corners of Iceland that most standard tours never reach — the kind of local knowledge that only comes from nearly two decades of dedicated exploration.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-block">
    <div class="about-card">
      <div class="about-row">
        <div class="about-row-media media-frame" style="flex:0 0 735px;border-radius:32px;overflow:hidden;aspect-ratio:735/490">
          <Image class="cover" src={photographerImg} alt="Luke photographing the geothermal landscape at Reykjanes" width={900} quality={80} loading="lazy" />
        </div>
        <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:513px">
          <h2 class="page-section-title">Luke the photographer</h2>
          <div class="stack gap-5">
            <p class="lead-heading">Photography has always been a big part of Luke's life. As a certified tour guide, professional photographer, and private tour guide in Iceland specializing in Iceland photography tours, during every tour Luke not only guides you to incredible locations but also helps capture the moments that make your adventure special — so you return home with both amazing memories and beautiful photographs.</p>
            <p class="lead-heading">His work has taken him across every corner of Iceland — from the dramatic black sand beaches of the South Coast and the otherworldly lava fields of the Reykjanes Peninsula, to remote Highland canyons and the dancing colours of the Northern Lights over glacier lagoons, creating unforgettable Northern Lights photography experiences.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-block">
    <div class="about-row">
      <div class="about-row-media media-frame" style="flex:0 0 533px;border-radius:32px;overflow:hidden;aspect-ratio:533/799">
        <Image class="cover" src={toursImg} alt="Northern Lights dancing over an Icelandic glacier lagoon" width={700} quality={80} loading="lazy" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-9);max-width:565px;align-items:flex-start">
        <div class="stack gap-5">
          <h2 class="page-section-title">How Luke runs his tours</h2>
          <div class="stack gap-5">
            <p class="lead-heading">As a private tour guide in Iceland, Luke creates every private Iceland tour around the same foundation — flexibility, authenticity, and genuine passion.</p>
            <p class="lead-heading">No fixed itineraries, no tour buses, no crowds. Just you, your group, and a guide who knows Iceland's hidden side intimately.</p>
            <p class="lead-heading">Luke works with a small team of trusted local guides who share the same values and deep local knowledge — ensuring the Secret Spots experience is always consistent, personal and unforgettable.</p>
          </div>
        </div>
        <Button variant="outline" href="/how-it-works" iconAfter="arrow-right">How It Works</Button>
      </div>
    </div>
  </section>

  <section class="container-pad" style="padding-top:0;padding-bottom:var(--space-11)">
    <div class="quote-panel">
      <div class="row gap-2">
        {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} color="var(--star-gold)" />)}
      </div>
      <p style="font:400 22px/1.6 var(--font-sans);color:var(--text-heading);margin:0;text-align:center;max-width:900px">&ldquo;I started Secret Spots because I genuinely believe Iceland is best experienced privately, slowly, and with someone who knows where to look. I look forward to welcoming you and sharing the hidden places that have inspired me for nearly two decades.&rdquo;</p>
      <div class="stack gap-2 items-center">
        <span class="label-14">Luke, Founder of Secret Spots of Iceland</span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-block { padding: 0 var(--space-8) var(--space-8); }
  .about-row { display: flex; align-items: center; gap: var(--space-11); max-width: var(--container-max); margin: 0 auto; }
  .about-card {
    background: var(--cream-50);
    border-radius: 32px;
    padding: var(--space-8);
  }

  @media (max-width: 1024px) {
    .about-row { gap: var(--space-8); }
    .about-row-media { flex-basis: 320px !important; }
  }
  @media (max-width: 768px) {
    .about-row { flex-direction: column; align-items: stretch; }
    .about-row-media { flex-basis: auto !important; width: 100%; }
    .about-block { padding-left: var(--space-6); padding-right: var(--space-6); }
  }
</style>
