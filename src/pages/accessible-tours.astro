---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Section from '../components/Section.astro';
import IconChip from '../components/IconChip.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import FaqItem from '../components/FaqItem.astro';

import introImg from '../assets/images/Web images/blog/compressed/wheelchair-glacier-lagoon-portrait-iceland.webp';
import { canonicalUrl, faqPageNode } from '../lib/schema';

const ADAPT = [
  { icon: 'truck', title: 'Vehicles built for the terrain', description: 'My vehicles are selected with accessibility in mind, and I plan routes around what actually works for you — not a fixed itinerary that assumes everyone can hike the same trail.' },
  { icon: 'clock', title: 'Pace and stops, your way', description: 'Shorter walks, more frequent stops, extra time at each location — the itinerary adjusts around your comfort, not a group schedule.' },
  { icon: 'arrow-up-right', title: "When the road can't get you there, we fly", description: "Some of Iceland's most striking locations sit beyond where any vehicle — accessible or not — can reach. A helicopter tour can open up the landscape without requiring a single step on uneven ground." },
  { icon: 'message-circle', title: 'Every trip starts with a conversation', description: "No two guests have the same needs. Before we plan anything, we talk through what matters to you — physical limitations, pace, must-see places — and build the tour around that." },
];

const FAQS = [
  { question: 'What kind of mobility needs have you accommodated before?', answer: "I've guided guests using wheelchairs, guests with limited walking ability, and older travelers who needed a slower pace and more frequent rest stops. Every tour is planned around the specific guest, not a generic accessibility checklist.", defaultOpen: true },
  { question: 'Are your vehicles wheelchair accessible?', answer: "Vehicle setup depends on your specific needs — reach out and I'll walk you through the best option for your trip, including helicopter access where road travel isn't practical." },
  { question: 'Is there an extra cost for accessibility adaptations, like helicopter access?', answer: "Costs vary depending on what your tour requires. I'll give you a clear, upfront quote once I understand your needs — no surprises." },
  { question: 'Can you accommodate older travelers who just need a slower pace, not a wheelchair?', answer: "Absolutely — this is one of the most common requests I get, and it's easy to build into any private tour." },
];
---

<Layout 
  title="Wheelchair Accessible Private Tours in Iceland" 
  description="Years guiding travelers with limited mobility across Iceland — including a 14-day wheelchair-accessible tour with helicopter access to remote sites. Book a private, fully adapted journey." 
  active="Accessible Tours"
  schema={[faqPageNode(canonicalUrl(Astro.url.pathname), FAQS)]}
>
  <div class="container-pad" style="padding-bottom:var(--space-8)">
    <section style="background:#081824;border-radius:32px;min-height:420px;display:flex;align-items:flex-end;justify-content:center;padding:var(--space-11) var(--space-9)">
      <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center;max-width:857px">
        <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center;text-align:center">
          <h1 class="acc-hero-title" style="font:400 3rem/1.1 var(--font-display);color:var(--cream-100);margin:0;overflow-wrap:anywhere">Accessible Tours in Iceland — Real Experience, Not Just a Promise</h1>
          <p style="font:400 18px/1.6 var(--font-sans);color:rgba(255,255,255,.9);margin:0">Traveling with limited mobility shouldn't mean settling for a watered-down version of Iceland. It means finding a guide who's actually done it — and knows how to make the remote, rugged, and breathtaking parts of this country reachable for you.</p>
        </div>
        <Button variant="primary" href="/contact">Book Your Accessible Tour</Button>
      </div>
    </section>
  </div>

  <Breadcrumbs trail={[{ label: 'Accessible Tours in Iceland' }]} />

  <Section tight style="padding-top:var(--space-7)">
    <div class="acc-row">
      <div class="acc-row-media media-frame" style="flex:0 0 460px;border-radius:32px;overflow:hidden;aspect-ratio:460/620">
        <Image src={introImg} alt="Traveller in a wheelchair by a glacier lagoon in Iceland" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px">
        <p style="font:var(--type-lead);color:var(--text-heading);margin:0">Accessibility isn't an afterthought here — it's something I've built real experience with over the years, guiding older travelers and guests with limited mobility across some of Iceland's most remote locations.</p>
        <div style="border-left:3px solid var(--amber-400);padding-left:var(--space-6);display:flex;flex-direction:column;gap:var(--space-4)">
          <p style="font:400 20px/1.5 var(--font-display);color:var(--text-heading);margin:0">&ldquo;I've had several older guests and guests with limited mobility over the years. One guest was in a wheelchair, and we traveled around Iceland together for 12 days. We even did two helicopter tours, which made it possible to experience places that would otherwise have been inaccessible.&rdquo;</p>
          <span style="font:700 14px/1 var(--font-sans);color:var(--text-muted)">— Luke</span>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="alt">
    <div style="display:flex;flex-direction:column;gap:var(--space-9);align-items:center">
      <h2 style="font:400 2.25rem/1.2 var(--font-display);color:var(--text-heading);margin:0;text-align:center">How We Adapt Your Tour</h2>
      <div class="icons-grid">
        {ADAPT.map((a) => (
          <div style="display:flex;flex-direction:column;gap:var(--space-5);align-items:flex-start">
            <IconChip name={a.icon} size={48} />
            <div style="display:flex;flex-direction:column;gap:6px">
              <span style="font:600 16px/1.3 var(--font-sans);color:var(--text-heading)">{a.title}</span>
              <span style="font:400 13px/1.6 var(--font-sans);color:var(--text-body)">{a.description}</span>
            </div>
          </div>
        ))}
      </div>
      <Button variant="primary" href="/contact">Check Availability With Luke</Button>
    </div>
  </Section>

  <Section tone="page">
    <div style="display:flex;flex-direction:column;align-items:center;gap:var(--space-11);max-width:700px;margin:0 auto">
      <h2 style="font:400 2.25rem/1.2 var(--font-display);color:var(--text-heading);margin:0;text-align:center">FAQ</h2>
      <div data-faq-group style="display:flex;flex-direction:column;width:100%">
        {FAQS.map((q) => <FaqItem question={q.question} answer={q.answer} defaultOpen={q.defaultOpen} />)}
      </div>
    </div>
  </Section>

  <Section tone="alt">
    <div style="background:#dbd6c5;border-radius:32px;padding:var(--space-13) var(--space-8);width:100%;display:flex;flex-direction:column;gap:var(--space-9);align-items:center">
      <div style="display:flex;gap:4px">
        {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} color="var(--star-gold)" />)}
      </div>
      <p style="font:400 28px/1.4 var(--font-display);color:var(--text-heading);margin:0;text-align:center;max-width:900px">"Has a FANTASTIC 12 days with Luke enjoying the scenery, culture, people and food of Iceland 🇮🇸."</p>
      <div style="display:flex;flex-direction:column;gap:4px;align-items:center">
        <span style="font:700 14px/1 var(--font-sans);color:var(--text-heading)">Jerry Jensen</span>
        <span style="font:400 12px/1 var(--font-sans);color:var(--text-muted)">Verified traveller</span>
      </div>
    </div>
  </Section>
</Layout>

<style>
  .acc-row { display: flex; align-items: center; gap: var(--space-11); }

  @media (max-width: 1024px) {
    .acc-row { gap: var(--space-8); }
    .acc-row-media { flex-basis: 320px !important; }
  }
  @media (max-width: 768px) {
    .acc-row { flex-direction: column; align-items: stretch; }
    .acc-row-media { flex-basis: auto !important; width: 100%; }
  }
  @media (max-width: 640px) {
    .acc-hero-title { font-size: 2rem !important; }
  }
</style>
