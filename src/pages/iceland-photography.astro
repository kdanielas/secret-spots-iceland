---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';

import introImg from '../assets/images/south-coast-vestrahorn-photographer.webp';

import northernLightsImg from '../assets/images/northern-lights-iceland.webp';
import blackSandImg from '../assets/images/vestrahorn-black-sand-dunes.webp';
import waterfallImg from '../assets/images/south-coast-horse-skogafoss-tour.webp';
import highlandsImg from '../assets/images/landmannalaugar-iceland-highlands.webp';
import glacierImg from '../assets/images/glacier-lagoon-iceland.jpg';

import moment1 from '../assets/images/couple-highlands-overlook-landmannalaugar-iceland-a.webp';
import moment2 from '../assets/images/couple-private-tour-iceland.webp';
import moment3 from '../assets/images/south-coast-family-tour.jpg';
import moment4 from '../assets/images/south-coast-mother-daughter.jpg';
import moment5 from '../assets/images/highlands-couple-iceland.jpg';
import moment6 from '../assets/images/engagment-couple-reykjanes.jpg';

import gem1 from '../assets/images/reykjanes-eruption-night.webp';
import gem2 from '../assets/images/diamond-beach-iceland.jpg';
import gem3 from '../assets/images/katla-glacier-hike-south-coast.webp';
import gem4 from '../assets/images/plane-wreck-south-coast.webp';
import gem5 from '../assets/images/highlands-aerial-rainbow-mountains.webp';
import gem6 from '../assets/images/kerid-crater-golden-circle.webp';
import gem7 from '../assets/images/gullfoss-golden-circle-iceland.jpg';
import gem8 from '../assets/images/south-coast-glacier-lagoon.jpg';

import video1 from '../assets/images/hidden-waterfall-canyon-hiker-iceland.mp4?url';
import video2 from '../assets/images/volcano-eruption-lava-flow-vertical-iceland.mp4?url';

const LOCATIONS = [
  { image: northernLightsImg, title: 'Northern Lights Photography in Iceland', description: 'Capturing the Northern Lights requires the right conditions, location, and timing. Luke helps travelers find the best viewpoints away from crowds, combining local experience with photography knowledge to create unforgettable aurora images.', tours: ['6 Days Ultimate Adventure'] },
  { image: blackSandImg, title: 'Black Sand Beach Photography', description: 'The volcanic coastline of Iceland creates some of the most recognizable landscapes in the world. Capture dramatic black sand beaches, basalt columns, sea stacks, and Atlantic waves along the South Coast.', tours: ['South Coast Adventure', '3 Days South Coast'] },
  { image: waterfallImg, title: 'Waterfall Photography in Iceland', description: "Iceland's waterfalls are among its most iconic photography locations. From powerful cascades like Skógafoss and Seljalandsfoss to hidden waterfalls in remote valleys, each location offers unique compositions and dramatic landscapes.", tours: ['South Coast Adventure', '3 Days South Coast', 'Highlands Adventure'] },
  { image: highlandsImg, title: 'Highlands Photography Locations in Iceland', description: 'The Icelandic Highlands offer some of the most remote and untouched photography locations in the country. Colorful mountains, lava fields, canyons, and hidden waterfalls create landscapes that feel like another planet.', tours: ['Highlands Adventure', '6 Days Ultimate Adventure'] },
  { image: glacierImg, title: 'Glacier & Ice Cave Photography', description: 'Glaciers, ice caves, and glacier lagoons create constantly changing photography opportunities. From floating icebergs to ancient ice formations, these landscapes showcase Iceland at its most dramatic.', tours: ['3 Days South Coast', '6 Days Ultimate Adventure'] },
];

const MOMENTS = [moment1, moment2, moment3, moment4, moment5, moment6];
const GEMS = [gem1, gem2, gem3, gem4, gem5, gem6, gem7, gem8];
---

<Layout title="How to Photograph Iceland: Seasons, Light, Gear & Timing" description="A photographer's guide to Iceland's best locations — Northern Lights, glaciers, black sand beaches and hidden waterfalls, from local guide Luke." active="Photography Guide">
  <div class="container-pad" style="padding-bottom:var(--space-8)">
    <section style="background:#081824;border-radius:32px;min-height:420px;display:flex;align-items:flex-end;justify-content:center;padding:var(--space-11) var(--space-9)">
      <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center;max-width:857px">
        <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center;text-align:center">
          <h1 class="photo-hero-title" style="font:400 3rem/1.1 var(--font-display);color:var(--cream-100);margin:0;overflow-wrap:anywhere">Iceland Photography Guide — Best Locations &amp; Photo Spots</h1>
          <p style="font:400 18px/1.6 var(--font-sans);color:rgba(255,255,255,.9);margin:0">Iceland is one of the world's most rewarding places to shoot — if you know where to go and when. This guide walks through the locations, light, and moments Luke looks for after nearly 20 years photographing the island, from the Northern Lights and glacier lagoons to black sand beaches and hidden waterfalls few visitors ever find.</p>
        </div>
        <Button variant="primary" href="/tours">See All Our Iceland Photography Tours</Button>
      </div>
    </section>
  </div>

  <Breadcrumbs trail={[{ label: 'Photography Guide' }]} />

  <Section tight style="padding-top:var(--space-7)">
    <div class="photo-row">
      <div class="photo-row-media" style="flex:0 0 460px;border-radius:32px;overflow:hidden;aspect-ratio:460/560;border:1px solid var(--ink-900)">
        <Image src={introImg} alt="Luke photographing the South Coast of Iceland" width={700} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="flex:1;display:flex;flex-direction:column;gap:var(--space-7);max-width:600px">
        <h2 style="font:400 2.25rem/1.2 var(--font-display);color:var(--text-heading);margin:0">What Makes Photography in Iceland Different</h2>
        <div style="display:flex;flex-direction:column;gap:var(--space-5)">
          <p style="font:var(--type-lead);color:var(--text-heading);margin:0">Unlike a regular private sightseeing tour, an Iceland photography tour is designed around capturing the best images. Luke guides photographers and photography enthusiasts to Iceland's most spectacular locations, helping with compositions, camera settings, lighting conditions, and planning the perfect shot.</p>
          <p style="font:var(--type-lead);color:var(--text-heading);margin:0">From dramatic waterfalls and black sand beaches to volcanic landscapes, glaciers, and the Northern Lights, every photography tour in Iceland is adapted to weather, seasons, and the best available light.</p>
          <p style="font:var(--type-lead);color:var(--text-heading);margin:0">Whether you are an experienced photographer looking to improve your skills or simply want to capture incredible memories from Iceland, Luke creates a personalized experience based on your goals.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="alt">
    <div style="display:flex;flex-direction:column;gap:var(--space-9);align-items:center">
      <div style="display:flex;flex-direction:column;gap:var(--space-4);align-items:center;text-align:center;max-width:720px">
        <h2 style="font:400 2.25rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Best Photography Locations in Iceland</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">From volcanic landscapes and black sand beaches to glaciers, waterfalls, and the Northern Lights, every region offers unique opportunities to capture unforgettable images. During Luke's private Iceland tours, you'll visit some of the country's most photogenic locations while benefiting from local knowledge, flexible timing, and professional photography guidance.</p>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:var(--space-4);width:100%">
        <button type="button" class="locations-arrow" data-dir="prev" aria-label="Previous location">
          <Icon name="arrow-right" size={18} style="transform:rotate(180deg)" />
        </button>
        <button type="button" class="locations-arrow" data-dir="next" aria-label="Next location">
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
      <div class="locations-carousel">
        {LOCATIONS.map((l) => (
          <article class="location-card" style="display:flex;flex-direction:column;gap:var(--space-5);background:var(--cream-50);border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.05);padding-bottom:var(--space-6)">
            <div data-ev="click_image" data-ev-text={l.title} style="position:relative;aspect-ratio:2/1;overflow:hidden">
              <Image src={l.image} alt="" width={500} quality={80} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
            </div>
            <div style="display:flex;flex-direction:column;gap:var(--space-4);padding:0 var(--space-6)">
              <div style="display:flex;flex-direction:column;gap:var(--space-3)">
                <h3 style="font:700 18px/1.3 var(--font-sans);color:var(--text-heading);margin:0">{l.title}</h3>
                <p style="font:400 14px/1.6 var(--font-sans);color:var(--text-body);margin:0">{l.description}</p>
              </div>
              <div style="display:flex;flex-direction:column;gap:var(--space-3);padding-top:var(--space-3);border-top:1px solid var(--border-subtle)">
                <span style="font:700 12px/1 var(--font-sans);letter-spacing:.04em;text-transform:uppercase;color:var(--text-muted)">Available on</span>
                <div style="display:flex;flex-wrap:wrap;gap:8px">
                  {l.tours.map((t) => (
                    <span style="display:inline-flex;background:var(--surface-chip);color:var(--text-heading);font:600 12px/1 var(--font-sans);padding:7px 12px;border-radius:20px">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Section>

  <Section tone="page">
    <div style="display:flex;flex-direction:column;gap:var(--space-8)" data-reveal>
      <div style="display:flex;flex-direction:column;gap:var(--space-3);text-align:center;max-width:720px;margin:0 auto">
        <h2 style="font:400 2.25rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Moments from Our Private Iceland Tours</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">Every tour is about more than the destination. From sharing unforgettable views to discovering hidden places together, these moments capture the joy, adventure, and memories created during our private tours across Iceland.</p>
      </div>
      <div class="photo-carousel">
        {MOMENTS.map((m) => (
          <div class="photo-carousel-card">
            <Image src={m} alt="" width={500} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section tone="alt">
    <div style="display:flex;flex-direction:column;gap:var(--space-8)" data-reveal>
      <div style="display:flex;flex-direction:column;gap:var(--space-3);text-align:center;max-width:760px;margin:0 auto">
        <h2 style="font:400 2.25rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Hidden Gems of Iceland</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">From glacier lagoons and volcanic landscapes to secluded waterfalls and black sand beaches — many of these hidden viewpoints and remote landscapes are only accessible through local knowledge and years of exploration.</p>
      </div>
      <div class="photo-carousel">
        {GEMS.map((g) => (
          <div class="photo-carousel-card">
            <Image src={g} alt="" width={500} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section tone="page">
    <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center">
      <div style="display:flex;flex-direction:column;gap:var(--space-3);text-align:center;max-width:640px">
        <h2 style="font:400 2.25rem/1.2 var(--font-display);color:var(--text-heading);margin:0">Iceland in Motion</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0">Discover the authentic beauty that makes every tour unforgettable.</p>
      </div>
      <div class="video-grid">
        <div style="border-radius:24px;overflow:hidden;aspect-ratio:9/16">
          <video class="lazy-video" data-src={video1} muted loop playsinline autoplay style="width:100%;height:100%;object-fit:cover"></video>
        </div>
        <div style="border-radius:24px;overflow:hidden;aspect-ratio:9/16">
          <video class="lazy-video" data-src={video2} muted loop playsinline autoplay style="width:100%;height:100%;object-fit:cover"></video>
        </div>
      </div>
    </div>
  </Section>
</Layout>

<style>
  .photo-row { display: flex; align-items: center; gap: var(--space-11); }

  .photo-carousel {
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .photo-carousel::-webkit-scrollbar { display: none; }
  .photo-carousel-card {
    flex: 0 0 clamp(220px, 26vw, 340px);
    aspect-ratio: 3/4;
    border-radius: 20px;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .video-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-7); max-width: 600px; width: 100%; }

  .locations-carousel {
    display: flex;
    gap: var(--space-7);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    width: 100%;
  }
  .locations-carousel::-webkit-scrollbar { display: none; }
  .location-card {
    flex: 0 0 clamp(260px, 30vw, 340px);
    scroll-snap-align: start;
  }
  .locations-arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-field);
    background: var(--cream-50);
    color: var(--ink-900);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-control);
  }
  .locations-arrow:hover { background: var(--cream-100); }
  .locations-arrow:active { transform: var(--press-scale); }

  @media (max-width: 640px) {
    .location-card { flex-basis: 78vw; }
  }

  @media (max-width: 1024px) {
    .photo-row { gap: var(--space-8); }
    .photo-row-media { flex-basis: 320px !important; }
  }
  @media (max-width: 768px) {
    .photo-row { flex-direction: column; align-items: stretch; }
    .photo-row-media { flex-basis: auto !important; width: 100%; }
  }
  @media (max-width: 640px) {
    .photo-hero-title { font-size: 2rem !important; }
  }
</style>

<script>
  const locationsTrack = document.querySelector<HTMLElement>('.locations-carousel');
  const locationsArrows = document.querySelectorAll<HTMLButtonElement>('.locations-arrow');
  if (locationsTrack) {
    // duplicate the set once so we can loop seamlessly — scrolling past the
    // end (or before the start) lands on identical cloned cards, then we
    // silently rewind by one set width so it feels infinite
    const originalCards = Array.from(locationsTrack.children);
    originalCards.forEach((card) => {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      locationsTrack.appendChild(clone);
    });

    const setWidth = () => locationsTrack.scrollWidth / 2;

    locationsArrows.forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = locationsTrack.querySelector<HTMLElement>('.location-card');
        const step = card ? card.getBoundingClientRect().width + 28 : locationsTrack.clientWidth * 0.8;
        if (btn.dataset.dir === 'prev' && locationsTrack.scrollLeft - step < 0) {
          locationsTrack.scrollLeft += setWidth();
        }
        locationsTrack.scrollBy({ left: btn.dataset.dir === 'prev' ? -step : step, behavior: 'smooth' });
      });
    });

    let locationsSettleTimer: ReturnType<typeof setTimeout>;
    locationsTrack.addEventListener('scroll', () => {
      clearTimeout(locationsSettleTimer);
      locationsSettleTimer = setTimeout(() => {
        const width = setWidth();
        if (locationsTrack.scrollLeft >= width) locationsTrack.scrollLeft -= width;
      }, 120);
    });
  }

  const lazyVideos = document.querySelectorAll<HTMLVideoElement>('video.lazy-video[data-src]');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const video = entry.target as HTMLVideoElement;
          video.src = video.dataset.src ?? '';
          video.load();
          video.play().catch(() => {});
          io.unobserve(video);
        }
      });
    },
    { rootMargin: '200px' }
  );
  lazyVideos.forEach((video) => io.observe(video));
</script>
