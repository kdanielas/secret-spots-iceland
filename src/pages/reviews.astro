---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import ReviewCard from '../components/ReviewCard.astro';
import testimonialImg from '../assets/images/hallgrimskirkja-church-group-selfie-reykjavik.webp';
import richardImg from '../assets/images/reviews/richard-ernashaw.jpg';
import alKringerImg from '../assets/images/reviews/al-kringer.jpg';
import alKringer2Img from '../assets/images/reviews/al-kringer-2.jpg';
import zacharyImg from '../assets/images/reviews/zachary-hertzman.jpg';
import irinaImg from '../assets/images/reviews/irina.jpg';
import melanieImg from '../assets/images/reviews/melanie-cochran.jpg';
import humphreyImg from '../assets/images/reviews/humphrey-b.jpg';
import samratImg from '../assets/images/reviews/samrat-deka.jpg';
import janImg from '../assets/images/reviews/jan.jpg';
import kellyImg from '../assets/images/reviews/kelly-waldron.jpg';
import tanjaImg from '../assets/images/reviews/tanja.jpg';
import deborahImg from '../assets/images/reviews/deborah-taranto.jpg';
import brianImg from '../assets/images/reviews/brian.jpg';
import hughImg from '../assets/images/reviews/hugh.jpg';
import ericImg from '../assets/images/reviews/eric-andersen.jpg';
import heidiImg from '../assets/images/reviews/heidi.jpg';
import michelleImg from '../assets/images/reviews/michelle-chang.jpg';

const [
  richardAvatar, alKringerAvatar, alKringer2Avatar, zacharyAvatar, irinaAvatar,
  melanieAvatar, humphreyAvatar, samratAvatar, janAvatar, kellyAvatar,
  tanjaAvatar, deborahAvatar, brianAvatar, hughAvatar, ericAvatar, heidiAvatar, michelleAvatar,
] = await Promise.all(
  [
    richardImg, alKringerImg, alKringer2Img, zacharyImg, irinaImg,
    melanieImg, humphreyImg, samratImg, janImg, kellyImg,
    tanjaImg, deborahImg, brianImg, hughImg, ericImg, heidiImg, michelleImg,
  ].map((img) => getImage({ src: img, width: 96, quality: 80 }))
).then((results) => results.map((r) => r.src));

const WHY_CHOOSE = [
  { icon: 'heart', title: 'Private & Personalized Tours' },
  { icon: 'star', title: 'Professional Photography Included' },
  { icon: 'map-pin', title: 'Local Knowledge & Authentic Experiences' },
  { icon: 'check', title: 'Hidden Gems Beyond the Tourist Trail' },
];

const THEMES = [
  {
    eyebrow: 'Hidden Gems & Off-the-Beaten-Path Experiences',
    title: 'Discover Iceland Beyond the Crowds',
    lead: 'Secret Spots of Iceland was built around one simple idea: showing visitors the Iceland that most travelers never get to see. Guests consistently mention the hidden locations, peaceful landscapes, and authentic experiences that set these tours apart.',
    quotes: [
      { quote: 'He shows you impressive places that are not overrun with tourists.', name: 'Deborah Taranto' },
      { quote: 'Each of the spots he takes you to is off the beaten path and therefore has far fewer tourists.', name: 'Hugh' },
      { quote: 'This tour allowed me to see things I had never seen before.', name: 'Kate Pappas' },
      { quote: 'Luke absolutely embodies what local guides should be.', name: 'Eric Andersen' },
    ],
  },
  {
    eyebrow: 'Private Tours & Custom Itineraries',
    title: 'Tailored Adventures Designed Around You',
    lead: "No two travelers are the same. Many guests highlight Luke's flexibility, local expertise, and ability to create personalized itineraries that match their interests, pace, and travel style.",
    quotes: [
      { quote: 'Luke is truly amazing and passionate about making his tours meaningful, personal and so much fun.', name: 'Tanja' },
      { quote: 'He tailored our trip to include the sights that were a must-see for our family. We made memories to last a lifetime.', name: 'Kelly Waldron' },
      { quote: 'Luke is very friendly, and very flexible based on how long you want to stay at any one site.', name: 'Brian' },
    ],
  },
  {
    eyebrow: 'Photography Experiences',
    title: "More Than a Tour — Memories You'll Keep Forever",
    lead: 'Every adventure includes professional photography, allowing guests to fully enjoy the experience while Luke captures the moments.',
    quotes: [
      { quote: 'Luke caught the moment perfectly in both video and photos which we will treasure forever.', name: 'Michelle Chang' },
      { quote: 'Luke is a phenomenal photographer and we are so happy with the pictures he took.', name: 'Heidi' },
      { quote: 'Coming home, I have some outstanding photos to remember my trip.', name: 'Ed' },
    ],
  },
  {
    eyebrow: 'Family & Small Group Adventures',
    title: 'Meaningful Experiences for Families and Friends',
    lead: 'Whether traveling as a couple, a family, or a small group of friends, guests consistently mention how welcoming and accommodating Luke is throughout the journey.',
    quotes: [
      { quote: 'My children loved the places Luke took us to explore.', name: 'Jan' },
      { quote: 'Our family had an unforgettable experience with Luke as our travel guide.', name: 'Kelly Waldron' },
      { quote: 'Coming home, I have some outstanding photos to remember my trip.', name: 'Eric Andersen' },
    ],
  },
  {
    eyebrow: 'Multi-Day Adventures',
    title: 'Explore More of Iceland',
    lead: 'For travelers who want to go deeper, multi-day tours provide the opportunity to experience more remote locations, changing landscapes, and unforgettable moments.',
    quotes: [
      { quote: 'Professional, knowledgeable guide with unforgettable memories.', name: 'Richard Ernashaw' },
      { quote: "Luke's 4x4 gave us access to Iceland's secret spots that we wouldn't get to see in a rental car.", name: 'Humphrey B' },
      { quote: 'Two days in Iceland; a memory of a lifetime.', name: 'Ed' },
    ],
  },
];

const WHAT_GUESTS_SAY = [
  'Hidden locations away from tourist crowds',
  'Personalized and flexible itineraries',
  'Professional photography included',
  'Comfortable private transportation',
  'Authentic local experiences',
  'Friendly and knowledgeable guidance',
  'Lifelong memories and meaningful connections',
];

const REVIEWS = [
  { name: 'Richard Ernashaw', avatar: richardAvatar, quote: "3 Day Tour To Southcoast — Luke is professional, knowledgable guide, we ended up with 3 day tour to southcoast, northen lights and circle tour and all was well thought through with unforgettable memmories. He knows a lot of nice spots off the beaten path as well, was great companion, flexible to adjust, easy to talk to. Car is comfy, even had a minibar for us for those moments coming back from waterfalls feeling cold. We were also catching northern lights, finding spots, so it was a lot of fun too. Highly recommend!" },
  { name: 'AL Kringer', avatar: alKringerAvatar, quote: "Don't think twice, just book this tour with Luke! He's very professional and friendly with lots of cool stories to share. We were very fortunate to be the only couple with him that day, not to mention the weather that day could not have been more perfect for us! The places he took us were out-of-this-world beautiful! He made sure we had lots of amazing photos from the trip! Definitely a memorable experience!" },
  { name: 'Zachary Hertzman', avatar: zacharyAvatar, quote: 'Reykjavik Tour — Amazing time with Luke, the perfect one day road trip from Reykjavik. Not only were the spots perfect, but Luke was a wonderful guide and such a great person to hang with for the day. Would highly recommend!' },
  { name: 'Irina', avatar: irinaAvatar, quote: 'South Coast Tour — He went above and beyond for us to enjoy our stay. If anyone is looking for an incredibly kind, talented and smart guide while on vacation, Luke is absolutely 100% your guy. I would recommend him for a truly enjoyable private experience. Thank you Luke for making my trip so memorable! I would definitely come back again!' },
  { name: 'AL Kringer', avatar: alKringer2Avatar, quote: 'Absolute Must Do! — My mom, sister and I took this tour with Luke last week and had an absolutely fantastic time! Luke was so friendly and knowledgeable of Iceland and all of the amazing spots that he took us to. We were truly off the beaten path — not a tour bus in sight! It was a truly unforgettable day that I would recommend to anyone.' },
  { name: 'Melanie Cochran', avatar: melanieAvatar, quote: 'This tour was one of the best experiences of my life. We saw so many amazing places. Luke was super nice and informative. Since there was only one other couple with us, he was able to personalize the day for us by constantly asking where we wanted to stop and how long we wanted to stay at each place. Highly recommend!' },
  { name: 'Humphrey B', avatar: humphreyAvatar, quote: "3 days Tour — Luke's 4X4 gave us access to Iceland's secret spots that we wouldn't get to see in a rental car — he knew exactly where to go and modified each day based on what we enjoyed most." },
  { name: 'Samrat Deka', avatar: samratAvatar, quote: "Was definitely one of the best experiences I've had in over 20 years of travel across the world. If there's one thing to do on a trip to Reykjavik... this is it!" },
  { name: 'Jan', avatar: janAvatar, quote: 'Do not Hesitate....Book with Luke — What a fantastic experience we had with Luke! My 20 and 18 year old children loved the places Luke took us to explore and he showed us some true wonders of Iceland that most people will not get a chance to see.' },
  { name: 'Kelly Waldron', avatar: kellyAvatar, quote: 'My family had an unforgettable experience with Luke as our travel guide for 3 days. He was very kind and patient, and knowledgeable about the places we visited. His photography was outstanding, too. He tailored our trip to include the sights that were a must-see for our family. We made memories to last a lifetime!' },
  { name: 'Tanja', avatar: tanjaAvatar, quote: 'Phenomenal experience! — Luke is truly amazing and passionate about making his tours meaningful, personal and so much fun! Never a dull moment as his energy is so good and he engages in great conversations during the longer drives. I am further grateful for his unique gift of capturing special moments through his skilled photography.' },
  { name: 'Deborah Taranto', avatar: deborahAvatar, quote: "Another great story… — Touring the island with Luke is the best thing you can do. He shows you impressive places that are not overrun with tourists. You get a good impression of authentic Iceland, interesting stories to tell and memories for life. Luke is courteous, uncomplicated, reliable and simply super likeable." },
  { name: 'Brian', avatar: brianAvatar, quote: 'Excellent Customized Local Tour — Luke will really take you to secret places. You won\'t see any crowds on this tour. Luke is very friendly, and very flexible based on how long you want to stay at any one site.' },
  { name: 'Hugh', avatar: hughAvatar, quote: "This experience with Luke was hands-down one of the best I had during my entire nine-week trip to Europe. Each of the spots he takes you to is off the beaten path and therefore has far fewer tourists. The photos Luke takes are a fantastic memento of the experience. The best part of the experience has to be Luke himself — such a kind and generous host." },
  { name: 'Eric Andersen', avatar: ericAvatar, quote: 'Wow! This adventure was better than we expected. Luke took us on an action-packed drive to nearly a dozen fascinating but hard-to-find spots across the Reykjanes Peninsula, explaining the unique geological history along the way. The photos and movies he took were wonderful, and will be cherished for many years.' },
  { name: 'Heidi', avatar: heidiAvatar, quote: 'We visited Iceland in October 2021 and had such a wonderful time. Luke was a fantastic guide and brought us to some unique and beautiful locations — a much better option for anyone who wants a personalized, small group setting. Luke is a phenomenal photographer and we are so happy with the pictures he took.' },
  { name: 'Michelle Chang', avatar: michelleAvatar, quote: 'A Truly Professional Tour and Photographer — 100% Recommend! Luke caught the moment perfectly in both video and photos which we will treasure forever. He had so many great ideas for photo locations and it was very easy and natural to have him take our photo.' },
];

// Where these reviews were originally left, so guests can read the full,
// unedited set on the platform itself.
const REVIEW_SOURCES = [
  {
    platform: 'Tripadvisor',
    icon: 'tripadvisor-color',
    href: 'https://www.tripadvisor.com/AttractionProductReview-g189970-d23569612-Private_Iceland_Tour_Hidden_Gems_Local_Experience-Reykjavik_Capital_Region.html',
  },
  {
    platform: 'Google',
    icon: 'google-color',
    href: 'https://www.google.com/maps/place/Secret+Spots+Of+Iceland/@64.1338111,-21.8213431,17z/data=!3m1!4b1!4m6!3m5!1s0x48d675481deb0d47:0x3e7adf7b877b8953!8m2!3d64.1338111!4d-21.8213431!16s%2Fg%2F11pv6bm7q3',
  },
];
---

<Layout title="Iceland private tours reviews | Secret Spots" description="Read honest reviews from travelers who explored Iceland's hidden gems with Luke. Private tours and photography experiences — see what others discovered." active="Reviews">
  <div class="container-pad pb-8">
    <section class="page-hero-dark">
      <div class="stack gap-8 items-center" style="max-width:857px">
        <div class="stack gap-8 items-center text-center">
          <h1 class="reviews-hero-title blog-hero-title">Real Experiences. Real Memories. Real Iceland.</h1>
          <p class="blog-hero-lead">From hidden waterfalls and volcanic landscapes to unforgettable road trips and professional photography, discover what guests have to say about exploring Iceland with Luke.</p>
        </div>
        <a class="platform-link" href="#reviews-intro">
          <span class="hero-cta-label">Read the reviews</span>
          <Icon name="chevron-down" size={20} color="var(--amber-400)" />
        </a>
      </div>
    </section>
  </div>

  <Section id="reviews-intro" tight style="padding-top:var(--space-7)">
    <div class="stack gap-11 items-center">
      <h2 class="sh-md title-ink text-center">Why Travelers Choose Secret Spots Iceland</h2>
      <div class="why-grid">
        {WHY_CHOOSE.map((w) => (
          <div class="why-card">
            <span class="why-icon"><Icon name={w.icon} size={26} color="var(--text-heading-deep)" /></span>
            <span class="why-title">{w.title}</span>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section tight style="padding-top:0">
    <div class="acc-row">
      <div class="acc-row-media media-frame" style="flex:0 0 460px;border-radius:32px;overflow:hidden;aspect-ratio:460/460">
        <Image class="cover" src={testimonialImg} alt="Happy guests on a private Secret Spots Iceland tour" width={700} quality={80} loading="lazy" />
      </div>
      <div class="text-col">
        <div class="row gap-2">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={18} color="var(--star-gold)" />)}
        </div>
        <div style="border-left:3px solid var(--amber-400);padding-left:var(--space-6);display:flex;flex-direction:column;gap:var(--space-4)">
          <p style="font:400 20px/1.5 var(--font-display);color:var(--text-heading);margin:0">&ldquo;This experience was one of a lifetime. Visited so many beautiful places, places I would have never found on my own. Luke knows what he is doing and is an awesome photographer.&rdquo;</p>
          <span style="font:700 14px/1 var(--font-sans);color:var(--text-muted)">— Roberto Irias</span>
        </div>
        <Button variant="primary" href="/contact">Book Your Adventure</Button>
      </div>
    </div>
  </Section>

  {THEMES.map((t) => (
    <Section tone="page">
      <div class="stack gap-9 items-center">
        <div style="display:flex;flex-direction:column;gap:var(--space-3);align-items:center;text-align:center;max-width:720px">
          <span style="font:var(--type-eyebrow);letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;color:var(--text-eyebrow)">{t.eyebrow}</span>
          <h2 class="sh-lg title-ink">{t.title}</h2>
          <p class="lead-body">{t.lead}</p>
        </div>
        <div class="quote-grid">
          {t.quotes.map((q) => (
            <div class="quote-card">
              <span class="quote-mark" aria-hidden="true">&ldquo;</span>
              <p class="quote-text">{q.quote}</p>
              <span class="quote-name">— {q.name}</span>
            </div>
          ))}
        </div>
      </div>
    </Section>
  ))}

  <Section tone="page">
    <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center">
      <div style="display:flex;flex-direction:column;gap:var(--space-3);align-items:center;text-align:center;max-width:680px">
        <h2 class="sh-lg title-ink">What Guests Say Most Often</h2>
        <p class="lead-body">After reading hundreds of reviews, the same themes appear again and again:</p>
      </div>
      <div class="guest-chip-cloud">
        {WHAT_GUESTS_SAY.map((item) => (
          <div class="guest-chip">
            <span class="guest-chip-icon"><Icon name="check" size={13} color="#fff" /></span>
            <span class="guest-chip-text">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section id="reviews" tone="page">
    <div class="stack gap-9 items-center">
      <h2 class="sh-lg title-ink text-center">Reviews</h2>
      <div class="grid-4 reviews-grid">
        {REVIEWS.map((r) => (
          <div class="reviews-grid-item">
            <ReviewCard name={r.name} avatar={r.avatar} date="Verified traveller" quote={r.quote} style="background:#EDEBE2;height:100%" />
          </div>
        ))}
      </div>

      <div class="review-sources">
        <h3 class="sh-xs article-h3">Read them where guests left them</h3>
        <p style="font:400 16px/1.6 var(--font-sans);color:var(--text-body);margin:0;max-width:620px">The reviews above are a selection. Every one of them is public on Tripadvisor and Google, unedited and in full.</p>
        <div class="review-sources-links">
          {REVIEW_SOURCES.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="review-source-link"
              aria-label={`Read all Secret Spots Iceland reviews on ${s.platform} (opens in a new tab)`}
              data-ev="click_link"
              data-ev-text={`reviews_${s.platform.toLowerCase()}`}
            >
              <span class="review-source-icon">
                <img src={`/icons/${s.icon}.svg`} alt="" width="20" height="20" style="width:20px;height:20px;object-fit:contain" />
              </span>
              All reviews on {s.platform}
              <Icon name="arrow-up-right" size={16} />
            </a>
          ))}
        </div>
      </div>
    </div>
  </Section>
</Layout>

<style>
  .review-sources {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
  }
  .review-sources-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .review-source-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: 10px 20px 10px 10px;
    border: 1px solid var(--ink-900);
    border-radius: var(--radius-pill);
    background: var(--cream-50);
    color: var(--ink-900);
    font: var(--type-button);
    font-size: .9375rem;
    text-decoration: none;
    transition: var(--transition-control);
  }
  .review-source-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    background: var(--surface-chip);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    overflow: hidden;
  }
  .review-source-link:hover { background: var(--cream-100); }
  .review-source-link:active { transform: var(--press-scale); }

  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); width: 100%; }
  .why-card {
    background: #EDEBE2;
    border-radius: 20px;
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    box-shadow: 0 6px 20px rgba(8, 24, 36, .06);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .why-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(8, 24, 36, .1); }
  .why-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--amber-400);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .why-title { font: 700 17px/1.3 var(--font-sans); color: var(--text-heading); }

  @media (max-width: 768px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .why-grid { grid-template-columns: 1fr; }
  }

  .acc-row { display: flex; align-items: center; gap: var(--space-11); }
  @media (max-width: 1024px) {
    .acc-row { gap: var(--space-8); }
    .acc-row-media { flex-basis: 320px !important; }
  }
  @media (max-width: 768px) {
    .acc-row { flex-direction: column; align-items: stretch; }
    .acc-row-media { flex-basis: auto !important; width: 100%; }
  }

  .quote-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6); width: 100%; }
  .quote-card {
    background: var(--surface-page-soft);
    border-top: 4px solid var(--amber-400);
    border-radius: 20px;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-height: 280px;
    box-shadow: 0 6px 20px rgba(8, 24, 36, .06);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .quote-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(8, 24, 36, .1); }
  .quote-mark { font: 400 48px/1 var(--font-display); color: var(--amber-400); }
  .quote-text { font: 400 19px/1.6 var(--font-sans); color: var(--text-heading); margin: 0; flex: 1; }
  .quote-name { font: 700 14px/1 var(--font-sans); color: var(--text-muted); }

  .guest-chip-cloud { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-4); max-width: 920px; }
  .guest-chip {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: #EDEBE2;
    border: 1px solid rgba(8, 24, 36, .08);
    border-radius: var(--radius-pill);
    padding: var(--space-4) var(--space-6);
    box-shadow: 0 2px 8px rgba(8, 24, 36, .04);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .guest-chip:hover { transform: translateY(-3px); box-shadow: 0 10px 22px rgba(8, 24, 36, .1); background: var(--surface-page-soft); }
  .guest-chip-icon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--amber-400);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .guest-chip-text { font: 600 15px/1.3 var(--font-sans); color: var(--text-heading); white-space: nowrap; }

  @media (max-width: 768px) {
    .guest-chip-text { white-space: normal; }
    .reviews-hero-title { font-size: 2rem !important; }
    /* carousel instead of a long vertical stack of 17 review cards */
    .reviews-grid {
      display: flex !important;
      width: 100%;
      align-self: stretch;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: var(--space-5);
      padding: 4px 0 var(--space-3);
      scrollbar-width: none;
    }
    .reviews-grid::-webkit-scrollbar { display: none; }
    .reviews-grid-item { flex: 0 0 85%; min-width: 0; scroll-snap-align: start; }
  }
</style>
