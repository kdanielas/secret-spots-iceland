---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';

import heroImg from '../assets/images/south-coast-vestrahorn-tour.webp';
import jeepImg from '../assets/images/jeep.webp';
import vClassImg from '../assets/images/mercedes-v-class-van-fleet-a.jpg';
import sprinter4x4Img from '../assets/images/mercedes-sprinter-4x4-van-8-seats-fleet.jpg';
import minibusImg from '../assets/images/mercedes-sprinter-minibus-16-seats-fleet.jpg';

const VEHICLES = [
  {
    image: vClassImg,
    capacity: 'Up to 6 passengers',
    title: 'Luxury Travel',
    description: 'The perfect choice for couples and small families. Spacious, comfortable, and elegant — ideal for those who want a premium private experience without compromise.',
    model: 'Mercedes V-Class',
  },
  {
    image: sprinter4x4Img,
    capacity: 'Up to 8 passengers',
    title: 'Comfortable Travel',
    description: 'Fully equipped for comfort on longer journeys, with plenty of space for luggage, camera equipment, and everything your group needs on the road.',
    model: 'Luxury Sprinter',
  },
  {
    image: minibusImg,
    capacity: 'Up to 18 passengers',
    title: 'Premium Travel',
    description: 'For larger groups, our Luxury Sprinter offers a spacious and comfortable way to experience Iceland. Everyone can travel together while enjoying generous seating, panoramic views, and a relaxed atmosphere throughout the journey.',
    model: 'Highlands Adventure',
  },
];
---

<Layout title="Our Vehicles | Luxury Transportation for Private Iceland Tours" description="Comfortable, private 4x4 vehicles for Iceland tours — built for highland roads, glacier access and flexible stops, with a guide who knows the terrain." active="Our Vehicles">
  <Hero
    framedImage={heroImg}
    framedImageAlt="4x4 vehicle driving past snow-capped mountains in Iceland"
    subtitle="A great tour is about more than the destinations you visit - it's also about how you experience the journey. That's why we carefully select premium vehicles that provide comfort, safety, and flexibility throughout your adventure in Iceland."
    primaryCta=""
    secondaryCta=""
  >
    <Fragment slot="title">Travel Iceland in Comfort</Fragment>
  </Hero>

  <Breadcrumbs trail={[{ label: 'Our Vehicles' }]} />

  <section class="section-py">
    <div style="max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:var(--space-11);align-items:center;padding:0 var(--space-8)">
      <h2 style="font:400 2.5rem/1.2 var(--font-display);color:var(--text-heading);margin:0;text-align:center;max-width:700px">The Right Vehicle for Every Adventure</h2>
      <div class="vehicles-grid">
        {VEHICLES.map((v) => (
          <article style="display:flex;flex-direction:column;gap:var(--space-6);background:var(--cream-50);border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.05);padding-bottom:var(--space-6)">
            <div style="position:relative;aspect-ratio:1/1;overflow:hidden">
              <Image class="inset-fill cover" src={v.image} alt={v.title} width={700} quality={80} loading="lazy" />
              <span class="media-badge">{v.capacity}</span>
            </div>
            <div style="display:flex;flex-direction:column;gap:var(--space-8);padding:0 var(--space-6);flex:1">
              <div class="stack gap-3">
                <h3 style="font:600 20px/1.2 var(--font-sans);color:var(--text-heading);margin:0">{v.title}</h3>
                <p style="font:400 14px/1.5 var(--font-sans);color:var(--text-heading);margin:0">{v.description}</p>
              </div>
              <span style="display:inline-flex;align-self:flex-start;background:var(--surface-chip);border:1px solid rgba(39,51,60,.15);color:rgba(19,37,51,.9);font:600 15px/1 var(--font-sans);padding:8px 12px;border-radius:39px">{v.model}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="container-pad" style="padding-top:0;padding-bottom:var(--space-11)">
    <div style="background:var(--cream-50);border-radius:32px;padding:var(--space-9);display:flex;align-items:center;gap:var(--space-11)" class="vehicle-why-row">
      <div class="media-frame" style="flex:1 1 0;border-radius:32px;overflow:hidden;aspect-ratio:737/414">
        <Image class="cover" src={jeepImg} alt="4x4 vehicle crossing a river in the Icelandic highlands" width={900} quality={80} loading="lazy" />
      </div>
      <div style="flex:1 1 0;display:flex;flex-direction:column;gap:var(--space-7)">
        <h2 class="page-subsection-title">Why the Right Vehicle Matters</h2>
        <p style="font:400 16px/1.7 var(--font-sans);color:var(--text-body);margin:0">Iceland's landscapes are vast, and many of the country's most beautiful locations are reached by scenic drives through changing terrain and weather conditions. That's why comfort matters.</p>
        <p style="font:400 16px/1.7 var(--font-sans);color:var(--text-body);margin:0">Whether you're traveling for a day tour, a photography adventure, or a multi-day private journey, our goal is to ensure you enjoy the same level of comfort and quality on the road as you do at every destination.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .vehicles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); width: 100%; }
  @media (max-width: 1024px) {
    .vehicles-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .vehicles-grid { grid-template-columns: 1fr; }
    .vehicle-why-row { flex-direction: column; }
  }
</style>
