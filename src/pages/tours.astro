---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';

import reykjanesImg from '../assets/images/reykjanes-eruption-night.webp';
import southCoastImg from '../assets/images/vestrahorn-black-sand-dunes.webp';
import goldenCircleImg from '../assets/images/kerid-crater-golden-circle.webp';
import snaefellsnesImg from '../assets/images/glacier-crevasse-aerial.webp';
import highlandsImg from '../assets/images/south-coast-glacier-snowmobile.webp';
import ringRoadImg from '../assets/images/glacier-lagoon-south-coast-drone.webp';
import guideVideoUrl from '../assets/images/hidden-waterfall-canyon-hiker-iceland.mp4?url';

const TOURS = [
  { slug: 'secret-reykjanes', image: reykjanesImg, duration: '7 hours', title: 'Secret Reykjanes', level: 'All levels', description: 'Volcanic craters, geothermal fields and dramatic sea cliffs near Reykjavik, with professional photography guidance.', price: '€149', href: '/tours/reykjanes' },
  { slug: 'south-coast-waterfalls', image: southCoastImg, duration: '7 hours', title: 'South Coast & Waterfalls', level: 'All levels', description: 'Black sand beaches, glacier lagoons and thundering waterfalls along the Ring Road, timed for the best light.', price: '€149', href: '/tours/south-coast-adventure' },
  { slug: 'golden-circle-secrets', image: goldenCircleImg, duration: '7 hours', title: 'Golden Circle Secrets', level: 'All levels', description: 'The classic route reimagined — geysers, waterfalls and craters, with detours to the spots most visitors skip.', price: '€149', href: '/tours/golden-circle' },
  { slug: 'snaefellsnes-peninsula', image: snaefellsnesImg, duration: '7 hours', title: 'Snæfellsnes Peninsula', level: 'All levels', description: "Iceland in miniature: glaciers, black-sand coves and mountains, away from the south coast crowds.", price: '€149', href: '/contact' },
  { slug: 'highlands-adventure', image: highlandsImg, duration: '10-12 hours', title: 'Highlands Adventure', level: 'Moderate fitness', description: 'Remote highland routes, hot rivers and volcanic landscapes most tours never reach — summer only.', price: 'From €1,700', href: '/tours/highlands-adventure' },
  { slug: 'ring-road-northern-lights', image: ringRoadImg, duration: '6 days', title: 'Ultimate Iceland Adventure', level: 'All levels', description: 'A full loop of Iceland shaped around your pace, with dedicated nights chasing the aurora.', price: 'From €1,690', href: '/tours/6-days-ultimate-adventure' },
];
// Medición (#86): slug del tour al que lleva una tarjeta, para tour_name.
const tourSlug = (href: string) => (href.startsWith('/tours/') ? href.split('/')[2] : undefined);
---

<Layout title="Iceland Photography Tours — Shoot Hidden Iceland with a Pro" description="Private photography tours with Luke, a pro photographer with 20 years in Iceland. Golden-hour timing, secret locations, all skill levels welcome. Small groups only." active="Tours">
  <div class="container-pad" style="padding-bottom:var(--space-8)">
    <section style="background:#081824;border-radius:32px;min-height:500px;display:flex;align-items:flex-end;justify-content:center;padding:var(--space-11) var(--space-9)">
      <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center;max-width:857px">
        <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center;text-align:center">
          <h1 class="tours-hero-title" style="font:400 3rem/1.1 var(--font-display);color:var(--cream-100);margin:0;overflow-wrap:anywhere">Iceland Photography Tours — Book Now</h1>
          <p style="font:400 18px/1.6 var(--font-sans);color:rgba(255,255,255,.9);margin:0">From day trips to multi-day adventures, every tour is fully private and built around you. Choose a classic private Iceland tour or a dedicated photography tour with Luke — a local guide and professional photographer with nearly 20 years exploring Iceland's most remote landscapes — and go home with the trip, and the photos, you actually wanted.</p>
        </div>
        <a href="#tours" style="display:flex;flex-direction:column;align-items:center;gap:var(--space-2);color:var(--amber-400);text-decoration:none">
          <span style="font:700 15px/1 var(--font-sans)">Check our tours</span>
          <Icon name="chevron-down" size={20} color="var(--amber-400)" />
        </a>
      </div>
    </section>
  </div>

  <Section id="tours" tight style="padding-top:var(--space-7);scroll-margin-top:110px">
    <div style="display:flex;flex-direction:column;gap:var(--space-11);align-items:center">
      <h2 class="sh-lg" style="color:var(--text-heading);margin:0;text-align:center">All Our Private Iceland Tours</h2>
      <div class="grid-tours">
        {TOURS.map((t) => (
          <div id={t.slug} class="card-clickable" style="display:flex;flex-direction:column;gap:var(--space-6);background:var(--cream-50);border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.05);padding-bottom:var(--space-7);scroll-margin-top:110px">
            <a href={t.href} data-ev="click_link" data-ev-text={t.title} data-ev-tour={tourSlug(t.href)} style="display:contents;text-decoration:none;color:inherit">
              <div data-ev="click_image" data-ev-text={t.title} data-ev-tour={tourSlug(t.href)} style="position:relative;aspect-ratio:2/1;overflow:hidden">
                <Image src={t.image} alt="" width={500} quality={80} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
                <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,.6) 0%, rgba(0,0,0,0) 45%)"></div>
                <span style="position:absolute;top:16px;left:16px;background:rgba(29,45,68,.54);color:var(--cream-50);padding:8px 14px;border-radius:20px;font:700 13px/1 var(--font-sans)">{t.duration}</span>
                <span style="position:absolute;bottom:16px;right:16px;color:var(--cream-50);text-align:right">
                  <span style="display:block;font:400 13px/1 var(--font-sans);opacity:.9;margin-bottom:4px">From</span>
                  <span style="display:block;font:700 22px/1 var(--font-sans)">{t.price}<span style="font:400 13px/1 var(--font-sans)"> /group</span></span>
                </span>
              </div>
              <div style="display:flex;flex-direction:column;gap:var(--space-3);padding:0 var(--space-6)">
                <h3 style="font:700 20px/1.2 var(--font-sans);color:var(--text-heading);margin:0">{t.title}</h3>
                <p style="font:400 16px/1.5 var(--font-sans);color:var(--text-heading);margin:0">{t.description}</p>
              </div>
            </a>
            <div style="display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap;padding-top:var(--space-3);margin-top:auto;padding-left:var(--space-6);padding-right:var(--space-6)">
              <a href="/contact" class="cta-pill" data-ev="click_button" data-ev-tour={tourSlug(t.href)} style="display:inline-flex;align-items:center;justify-content:center;padding:9.5px 24px;background:var(--action-dark-bg);color:var(--action-dark-fg);border-radius:var(--radius-pill);font:var(--type-button);font-size:.9375rem;white-space:nowrap;text-decoration:none">Check Availability</a>
              <a href={t.href} class="info-pill" aria-label={`More info about the ${t.title} tour`} data-ev="click_button" data-ev-tour={tourSlug(t.href)} style="display:inline-flex;align-items:center;gap:4px;padding:9px 4px;color:var(--ink-900);font:var(--type-button);font-size:.9375rem;white-space:nowrap;text-decoration:none">Tour details<Icon name="chevron-right" size={16} /></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section tone="alt">
    <div data-reveal style="display:flex;flex-direction:column;gap:var(--space-11);align-items:center">
      <div class="media-frame" style="width:100%;aspect-ratio:16/9;border-radius:32px;overflow:hidden">
        <video class="lazy-video" data-src={guideVideoUrl} muted loop playsinline style="width:100%;height:100%;object-fit:cover"></video>
      </div>
      <div style="display:flex;flex-direction:column;gap:var(--space-7);align-items:center;text-align:center">
        <h2 style="font:400 2rem/1.2 var(--font-sans);color:var(--text-heading);margin:0">Our photography guide &amp; tips</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0;max-width:720px">Every tour is private and shaped around the weather, the light, and what you actually want to see — with a local guide who knows where the crowds aren't.</p>
        <Button variant="outline" href="/iceland-photography" iconAfter="chevron-right">See Our Photography Guide</Button>
      </div>
    </div>
  </Section>

  <section class="container-pad" style="padding-top:0;padding-bottom:var(--space-11)">
    <div data-reveal class="quote-panel">
      <div style="display:flex;gap:4px">
        {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} color="var(--star-gold)" />)}
      </div>
      <p style="font:400 22px/1.6 var(--font-sans);color:var(--text-heading);margin:0;text-align:center;max-width:900px">We recently completed a trip to Iceland from Reykjavik to the south coast with Luke as our guide throughout. We had a range of ages in our group from tween to 80+ and Luke did a fantastic job of accommodating capabilities and interests throughout. He had us well equipped with the secret spots he is known for along with the must see big destinations.</p>
      <div style="display:flex;flex-direction:column;gap:4px;align-items:center">
        <span style="font:700 14px/1 var(--font-sans);color:var(--text-heading)">Britta Hormann</span>
        <span style="font:400 12px/1 var(--font-sans);color:var(--text-muted);text-decoration:underline">United States · Tripadvisor Review</span>
      </div>
      <div style="display:flex;gap:var(--space-4)">
        <button type="button" class="testimonial-arrow" aria-label="Previous review">
          <Icon name="chevron-right" size={18} style="transform:rotate(180deg)" />
        </button>
        <button type="button" class="testimonial-arrow" aria-label="Next review">
          <Icon name="chevron-right" size={18} />
        </button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .card-clickable { transition: box-shadow var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .card-clickable:hover { box-shadow: 0 12px 32px rgba(0,0,0,.1); }
  .cta-pill:hover { background: var(--action-dark-bg-hover); }
  .info-pill:hover { color: var(--blue-500); }
  .card-clickable:active { transform: var(--press-scale); }

  .testimonial-arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--cream-50);
    color: var(--ink-900);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-control);
  }
  .testimonial-arrow:hover { background: var(--cream-100); }
  .testimonial-arrow:active { transform: var(--press-scale); }

  @media (max-width: 768px) {
    .tours-hero-title { font-size: 2rem !important; }
  }
</style>

<script>
  const lazyVideos = document.querySelectorAll<HTMLVideoElement>('video.lazy-video[data-src]');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const video = entry.target as HTMLVideoElement;
          video.src = video.dataset.src ?? '';
          video.load();
          video.play().catch(() => {});
          io.unobserve(video);
        }
      });
    },
    { rootMargin: '200px' }
  );
  lazyVideos.forEach((video) => io.observe(video));
</script>
