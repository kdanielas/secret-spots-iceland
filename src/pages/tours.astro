---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import IconChip from '../components/IconChip.astro';
import TourListingCard from '../components/TourListingCard.astro';

import guideVideoUrl from '../assets/images/hidden-waterfall-canyon-hiker-iceland.mp4?url';
import jeepImg from '../assets/images/jeep.webp';
import { DAY_TOURS, MULTI_DAY_TOURS } from '../data/tours';

/**
 * Lo que hace distinto al tour, tal cual lo decía /iceland-photography-tours
 * (#14): /tours sustituye a esa URL, así que el texto tiene que venirse con
 * ella. El diseño cambia; la copia, no.
 */
const WHY = [
  {
    icon: 'clock',
    title: 'No Fixed Itineraries',
    description:
      'Every tour is built around your group, your pace, and what the weather and light make possible that day. Want to stay longer at a location? We stay. Want to add a stop? We adapt.',
  },
  {
    icon: 'map-pin',
    title: 'Local Knowledge',
    description:
      'Nearly two decades exploring Iceland means knowing where to go, when to go, and how to avoid the crowds. Secret waterfalls, hidden canyons, alternative viewpoints, perfect light timing — this is the kind of knowledge that only comes from years of living here.',
  },
  {
    icon: 'user',
    title: 'Private & Customizable',
    description:
      "Just your group — no strangers, no crowded buses, no compromises. Whether you're a couple, family, or group of friends, the experience is designed exclusively for you.",
  },
  {
    icon: 'shield-check',
    title: 'Flexibility & Safety',
    description:
      "Weather changes? The itinerary changes. Roads are closed? There's a plan B. Luke's expertise navigating Iceland's roads and conditions — including remote F-roads in a heavy-duty 4x4 — means your adventure is always safe and optimized for the best possible experience.",
  },
  {
    icon: 'camera',
    title: 'Professional Photography Included',
    description:
      "Luke is a professional photographer with nearly 20 years shooting Iceland's landscapes. He doesn't just guide you to incredible locations — he helps you capture them. Go home with stunning shots, not just memories.",
  },
  {
    icon: 'heart',
    title: 'Restaurant & Accommodation Recommendations',
    description:
      'From cosy local spots to hidden gems only locals know about — Luke shares recommendations based on years of living in Iceland. No tourist traps, just honest advice about where to eat, where to stay, and what to experience beyond the standard route.',
  },
];
---

<Layout title="Iceland Photography Tours — Shoot Hidden Iceland with a Pro" description="Private photography tours with Luke, a pro photographer with 20 years in Iceland. Golden-hour timing, secret locations, all skill levels welcome. Small groups only." active="Tours">
  <div class="container-pad" style="padding-bottom:var(--space-8)">
    <section style="background:#081824;border-radius:32px;min-height:500px;display:flex;align-items:flex-end;justify-content:center;padding:var(--space-11) var(--space-9)">
      <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center;max-width:857px">
        <div style="display:flex;flex-direction:column;gap:var(--space-8);align-items:center;text-align:center">
          <h1 class="tours-hero-title" style="font:400 3rem/1.1 var(--font-display);color:var(--cream-100);margin:0;overflow-wrap:anywhere">Iceland Photography Tours — Book Now</h1>
          <p style="font:400 18px/1.6 var(--font-sans);color:rgba(255,255,255,.9);margin:0">From day trips to multi-day adventures, every tour is fully private and built around you. Choose a classic private Iceland tour or a dedicated photography tour with Luke — a local guide and professional photographer with nearly 20 years exploring Iceland's most remote landscapes — and go home with the trip, and the photos, you actually wanted.</p>
        </div>
        <a href="#tours" style="display:flex;flex-direction:column;align-items:center;gap:var(--space-2);color:var(--amber-400);text-decoration:none">
          <span style="font:700 15px/1 var(--font-sans)">Check our tours</span>
          <Icon name="chevron-down" size={20} color="var(--amber-400)" />
        </a>
      </div>
    </section>
  </div>

  <Section id="tours" tight style="padding-top:var(--space-7);scroll-margin-top:110px">
    <div style="display:flex;flex-direction:column;gap:var(--space-9);align-items:center">
      <SectionHeading align="center" size="lg" maxWidth="760px">
        <Fragment slot="title">Private Iceland Day Tours</Fragment>
        <Fragment slot="lead">Four private day tours out of Reykjavík, each one just your group — volcanic coastlines, waterfalls, geothermal fields and the Highlands, with professional photography guidance throughout.</Fragment>
      </SectionHeading>
      <div class="grid-tour-cards">
        {DAY_TOURS.map((t) => <TourListingCard tour={t} />)}
      </div>
    </div>
  </Section>

  <Section tone="alt">
    <div data-reveal style="display:flex;flex-direction:column;gap:var(--space-11);align-items:center">
      <div class="media-frame" style="width:100%;aspect-ratio:16/9;border-radius:32px;overflow:hidden">
        <video class="lazy-video" data-src={guideVideoUrl} muted loop playsinline style="width:100%;height:100%;object-fit:cover"></video>
      </div>
      <div style="display:flex;flex-direction:column;gap:var(--space-7);align-items:center;text-align:center">
        <h2 class="sh-lg" style="color:var(--text-heading);margin:0">Our photography guide &amp; tips</h2>
        <p style="font:var(--type-lead);color:var(--text-body);margin:0;max-width:720px">Every private Iceland tour can become a photography-focused experience. Luke helps guests capture the best moments — the itinerary is shaped around the weather, the light, and what you actually want to see, with a local guide who knows where the crowds aren't.</p>
        <Button variant="outline" href="/iceland-photography" iconAfter="chevron-right">See Our Photography Guide</Button>
      </div>
    </div>
  </Section>

  <Section>
    <div style="display:flex;flex-direction:column;gap:var(--space-9);align-items:center">
      <SectionHeading align="center" size="lg" maxWidth="760px">
        <Fragment slot="title">Multi-Day Private Tours of Iceland</Fragment>
        <Fragment slot="lead">Three or six days with the same guide, the same vehicle and no fixed schedule — the South Coast at a relaxed pace, or a full loop of the island with the Highlands included.</Fragment>
      </SectionHeading>
      <div class="grid-tour-cards">
        {MULTI_DAY_TOURS.map((t) => <TourListingCard tour={t} />)}
      </div>
    </div>
  </Section>

  <Section tone="alt">
    <div data-reveal style="display:flex;flex-direction:column;gap:var(--space-11);align-items:center">
      <SectionHeading align="center" eyebrow="Why travel with Luke" size="lg" maxWidth="820px">
        <Fragment slot="title">What makes this one-of-a-kind Iceland photo tour so special?</Fragment>
      </SectionHeading>
      <div class="grid-why">
        {WHY.map((w) => (
          <div style="display:flex;gap:var(--space-5);align-items:flex-start">
            <IconChip name={w.icon} size={44} />
            <div style="display:flex;flex-direction:column;gap:var(--space-2)">
              <h3 style="font:700 17px/1.3 var(--font-sans);color:var(--text-heading);margin:0">{w.title}</h3>
              <p style="font:400 15px/1.6 var(--font-sans);color:var(--text-body);margin:0">{w.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section>
    <div data-reveal class="grid-1-1-gap5 text-first-mobile">
      <div class="media-frame" style="border-radius:32px;overflow:hidden;aspect-ratio:4/3">
        <Image src={jeepImg} alt="Luke's heavy-duty 4x4 fording a glacial river in the Icelandic highlands" width={900} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div style="display:flex;flex-direction:column;gap:var(--space-6);align-items:flex-start">
        <SectionHeading eyebrow="The vehicles" size="lg">
          <Fragment slot="title">Experience Iceland like never before – Join the ultimate Iceland private tour!</Fragment>
        </SectionHeading>
        <p style="font:400 16px/1.7 var(--font-sans);color:var(--text-body);margin:0">During our unforgettable Iceland photography tour, I focus on your comfort and adventure by using powerful 4x4 trucks. These vehicles are built to handle Iceland's wild terrain, allowing us to reach the most spectacular Iceland photography locations that are often out of reach for regular tourists.</p>
        <p style="font:400 16px/1.7 var(--font-sans);color:var(--text-body);margin:0">These aren't just any vehicles — they're a gateway to remote nature, volcanic landscapes, and hidden waterfalls that you'll discover on this one-of-a-kind photo tour Iceland. If you're traveling in a group larger than six people, I also offer a customized van that ensures everyone enjoys the journey in comfort during our photography tours Iceland.</p>
        <Button variant="outline" href="/our-vehicles" iconAfter="chevron-right">Our Vehicles</Button>
      </div>
    </div>
  </Section>

  <section class="container-pad" style="padding-top:0;padding-bottom:var(--space-11)">
    <div data-reveal class="quote-panel">
      <div style="display:flex;gap:4px">
        {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} color="var(--star-gold)" />)}
      </div>
      <p style="font:400 22px/1.6 var(--font-sans);color:var(--text-heading);margin:0;text-align:center;max-width:900px">We recently completed a trip to Iceland from Reykjavik to the south coast with Luke as our guide throughout. We had a range of ages in our group from tween to 80+ and Luke did a fantastic job of accommodating capabilities and interests throughout. He had us well equipped with the secret spots he is known for along with the must see big destinations.</p>
      <div style="display:flex;flex-direction:column;gap:4px;align-items:center">
        <span style="font:700 14px/1 var(--font-sans);color:var(--text-heading)">Britta Hormann</span>
        <span style="font:400 12px/1 var(--font-sans);color:var(--text-muted);text-decoration:underline">United States · Tripadvisor Review</span>
      </div>
    </div>
  </section>

  <Section tight>
    <div data-reveal style="display:flex;flex-direction:column;gap:var(--space-7);align-items:center;text-align:center;max-width:760px;margin:0 auto">
      <h2 class="sh-lg" style="color:var(--text-heading);margin:0">Ready to Plan Your Private Iceland Tour?</h2>
      <p style="font:var(--type-lead);color:var(--text-body);margin:0">Whether you have 7 hours or 6 days, whether you want to see iconic landmarks or hidden gems, or a combination of both — we'll create the perfect private Iceland experience for you.</p>
      <p style="font:400 16px/1.7 var(--font-sans);color:var(--text-body);margin:0">Tell Luke's team your travel dates, group size, and what you're dreaming of. We'll get back to you within 24 hours with ideas tailored to your trip.</p>
      <Button variant="dark" href="/contact" iconAfter="arrow-right">Contact Luke &amp; Start Planning</Button>
    </div>
  </Section>
</Layout>

<style>
  @media (max-width: 768px) {
    .tours-hero-title { font-size: 2rem !important; }
  }
</style>

<script>
  const lazyVideos = document.querySelectorAll<HTMLVideoElement>('video.lazy-video[data-src]');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const video = entry.target as HTMLVideoElement;
          video.src = video.dataset.src ?? '';
          video.load();
          video.play().catch(() => {});
          io.unobserve(video);
        }
      });
    },
    { rootMargin: '200px' }
  );
  lazyVideos.forEach((video) => io.observe(video));
</script>
