---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import { POSTS, formatPostDate } from '../../data/blog-posts';
---

<Layout title="Iceland Travel Blog — Local Tips & Hidden Gems | Secret Spots" description="Discover Iceland through Luke's eyes — travel guides, hidden locations, photography spots and local tips to help you plan the perfect Iceland trip." active="Blog">
  <div class="container-pad pb-8">
    <section class="page-hero-dark">
      <div class="stack gap-8 items-center" style="max-width:857px">
        <div class="stack gap-8 items-center text-center">
          <h1 class="blog-hero-title blog-hero-title">Iceland Travel Blog</h1>
          <p class="blog-hero-lead">Local tips, hidden gems and stories from the road — written by Luke and the Secret Spots team.</p>
        </div>
        <a class="platform-link" href="#posts">
          <span class="hero-cta-label">Read the latest</span>
          <Icon name="chevron-down" size={20} color="var(--amber-400)" />
        </a>
      </div>
    </section>
  </div>

  <Section id="posts" tight style="padding-top:var(--space-7)">
    <div class="stack gap-11 items-center">
      <div class="grid-tours">
        {POSTS.map((p) => (
          <a href={p.href} class="card-clickable" aria-label={`Read the article: ${p.title}`} data-ev="click_link" data-ev-text={p.title} style="display:flex;flex-direction:column;gap:var(--space-6);background:var(--cream-50);border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.05);padding-bottom:var(--space-7);text-decoration:none;color:inherit">
            <div class="media-2-1">
              <Image class="inset-fill cover" src={p.image} alt={p.imageAlt} width={500} quality={80} loading="lazy" />
              <time class="media-badge" datetime={p.datePublished}>{formatPostDate(p.datePublished)}</time>
            </div>
            <div style="display:flex;flex-direction:column;gap:var(--space-4);padding:0 var(--space-6);flex:1">
              <h2 class="card-title title-ink">{p.title}</h2>
              <p style="font:400 14px/1.6 var(--font-sans);color:var(--text-body);margin:0">{p.excerpt}</p>
              <span style="display:inline-flex;align-items:center;gap:6px;margin-top:auto;padding-top:var(--space-3);font:700 14px/1 var(--font-sans);color:var(--text-heading)">
                Read article
                <Icon name="chevron-right" size={14} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </Section>
</Layout>

<style>
  @media (max-width: 768px) {
    .blog-hero-title { font-size: 2rem !important; }
  }

  .card-clickable { transition: box-shadow var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .card-clickable:hover { box-shadow: 0 12px 32px rgba(0,0,0,.1); }
  .card-clickable:active { transform: var(--press-scale); }

</style>
