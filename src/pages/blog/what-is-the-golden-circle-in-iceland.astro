---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { BLOG_AUTHOR, blogPageMeta } from '../../lib/blog';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';

import heroImg from '../../assets/images/gullfoss-golden-circle-iceland.jpg';
import keridImg from '../../assets/images/kerid-crater-golden-circle.webp';

const ATTRACTIONS = [
  { name: 'Þingvellir National Park', description: 'A natural treasure and a historically significant site for Icelanders, listed as a UNESCO World Heritage Site — geologically unique (this is where tectonic plates meet!) and historically important as the birthplace of Icelandic democracy.' },
  { name: 'Haukadalur Valley', description: 'A paradise for lovers of lively natural phenomena like geysers. The geysers Geysir and Strokkur are still active today, shooting steam over 20 meters high!' },
  { name: 'Gullfoss Waterfall', description: 'A highlight of the tour on the Hvítá River, and the namesake of the original Icelandic name for the route: Gullni hringurinn. In the early 20th century, there were plans to turn Gullfoss into a hydroelectric power station — fortunately, these plans were met with strong opposition and ultimately stopped.' },
];

const BENEFITS = [
  'Explore both natural wonders and cultural landmarks',
  "Visit the most important and beautiful places on Iceland's map in just one day",
  'Includes a professional photo session at each location',
  'Fully customized to each client, so it will be exactly what you\'re looking for',
];

const { post, dateline, schema } = await blogPageMeta(Astro.url.pathname, heroImg);
---

<Layout
  title="What Is the Golden Circle in Iceland and Why Is It Worth Visiting? | Secret Spots Iceland"
  description="Where the name comes from, what the route includes, and why it's still one of the best ways to see Iceland in a day."
  active="Blog"
  schema={schema}
>
  <Hero
    framedImage={heroImg}
    framedImageAlt="Gullfoss waterfall on the Golden Circle route"
    primaryCta=""
    secondaryCta=""
  >
    <Fragment slot="title">What Is the Golden Circle in Iceland and Why Is It Worth Visiting?</Fragment>
    <Fragment slot="subtitle">By {BLOG_AUTHOR} · <time datetime={post.datePublished}>{dateline}</time></Fragment>
  </Hero>

  <article class="blog-article container-pad">
    <div class="blog-article-col">
      <Breadcrumbs inline trail={[{ label: 'Blog', href: '/blog' }, { label: post.title }]} style="margin-bottom:var(--space-10)" />

      <div style="display:flex;flex-direction:column;gap:var(--space-6)">
        <p style="font:var(--type-lead);color:var(--text-heading);margin:0">The Golden Circle in Iceland is one of the most popular tourist routes in this picturesque country. In today's article, I'll answer questions such as: Where does the name "Golden Circle" come from? What does the Golden Circle route in Iceland include? And why is it a great choice for exploring Iceland? Let's dive in!</p>
      </div>

      <section style="margin-top:var(--space-9)">
        <h2 style="font:400 1.625rem/1.3 var(--font-display);color:var(--text-heading);margin:0 0 var(--space-5)">What Is the Golden Circle in Iceland?</h2>
        <p style="font:var(--type-lead);color:var(--text-heading);margin:0">As mentioned in the introduction, the Golden Circle (Iceland) is a popular tourist route — one of the most frequently and eagerly chosen. It's located in the southwestern part of the country and not only allows you to visit scenic and culturally important places in Iceland but also covers three of the country's top attractions. What's more, the Golden Circle in Iceland (Icelandic: Gullni hringurinn) lets you see all of these in just one day — my Golden Circle tour lasts eight hours and starts in Reykjavík. The route is fully drivable, making it suitable for families with children, seniors, or those who prefer not to walk for extended periods.</p>
      </section>

      <section style="margin-top:var(--space-9)">
        <h2 style="font:400 1.625rem/1.3 var(--font-display);color:var(--text-heading);margin:0 0 var(--space-5)">What Does the Golden Circle in Iceland Include?</h2>
        <p style="font:var(--type-lead);color:var(--text-heading);margin:0 0 var(--space-6)">A Golden Circle tour in Iceland (Gullni hringurinn) is a journey through natural and cultural landmarks. Its core features are three must-see attractions:</p>
        <div style="display:flex;flex-direction:column;width:100%">
          {ATTRACTIONS.map((a) => (
            <div style="padding:var(--space-6) 0;border-bottom:1px solid #c2b8ab">
              <p style="font:700 17px/1.3 var(--font-sans);color:var(--text-heading);margin:0 0 6px">{a.name}</p>
              <p style="font:var(--type-lead);color:var(--text-heading);margin:0">{a.description}</p>
            </div>
          ))}
        </div>
        <p style="font:var(--type-lead);color:var(--text-heading);margin:var(--space-6) 0 0">Every Golden Circle tour in Iceland can differ slightly depending on the organizer. On my tour, you'll also see the colorful Kerið crater and the natural hot spring Secret Lagoon. You can also enjoy a local food tasting during lunch at the Friðheimar tomato farm and experience unique attractions like snowmobiling on the Langjökull glacier or horseback riding in the surrounding area. I tailor the Golden Circle tour to my clients' preferences.</p>
      </section>

      <figure style="margin:var(--space-11) 0">
        <div style="border-radius:24px;overflow:hidden;aspect-ratio:16/10">
          <Image src={keridImg} alt="Kerið volcanic crater on the Golden Circle route" width={900} quality={80} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
        </div>
      </figure>

      <section>
        <h2 style="font:400 1.625rem/1.3 var(--font-display);color:var(--text-heading);margin:0 0 var(--space-5)">Golden Circle in Iceland – Tour Benefits</h2>
        <div style="display:flex;flex-direction:column;width:100%">
          {BENEFITS.map((item) => (
            <div style="display:flex;gap:var(--space-4);align-items:flex-start;padding:var(--space-5) 0;border-bottom:1px solid var(--border-subtle)">
              <Icon name="check" size={20} color="var(--blue-500)" style="flex:0 0 auto;margin-top:2px" />
              <p style="font:var(--type-lead);color:var(--text-heading);margin:0">{item}</p>
            </div>
          ))}
        </div>
      </section>

      <div style="margin-top:var(--space-11);padding:var(--space-9);background:#081824;border-radius:24px;display:flex;flex-direction:column;gap:var(--space-6);align-items:flex-start">
        <div style="display:flex;flex-direction:column;gap:var(--space-3)">
          <h2 style="font:400 2rem/1.2 var(--font-display);color:var(--cream-50);margin:0">See Iceland's classics in a day</h2>
          <p style="font:var(--type-lead);color:rgba(255,255,255,.8);margin:0">Tell us your dates and we'll build your Golden Circle day around you.</p>
        </div>
        <Button variant="primary" href="/contact">Check Availability</Button>
      </div>

      <div style="margin-top:var(--space-9);padding-top:var(--space-7);border-top:1px solid var(--border-subtle);display:flex;align-items:center;gap:var(--space-4)">
        <span style="width:44px;height:44px;border-radius:var(--radius-pill);background:var(--avatar-red);color:var(--cream-50);display:inline-flex;align-items:center;justify-content:center;font:700 16px/1 var(--font-sans);flex:0 0 auto">L</span>
        <div style="display:flex;flex-direction:column">
          <span style="font:700 15px/1.3 var(--font-sans);color:var(--text-heading)">Luke EM</span>
          <span style="font:var(--type-body-xs);color:var(--text-muted)">Founder &amp; guide, Secret Spots of Iceland</span>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .blog-article { padding-top: var(--space-11); padding-bottom: var(--space-13); }
  .blog-article-col { max-width: 720px; margin: 0 auto; }
</style>
