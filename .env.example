# Copia este archivo como .env y rellena los valores. .env no se sube a git.

# Contenedor de Google Tag Manager (#88). Vacío = no se carga GTM.
# En Vercel: Settings > Environment Variables, en Production y Preview.
PUBLIC_GTM_ID=

# ─── Formulario de contacto (#21) ─────────────────────────────────────────────
# Sin estas variables el endpoint /api/contact responde 503 y el visitante ve
# un error con el teléfono y el correo de Luke. Nunca en el código: sólo aquí
# (en local) y en Vercel > Settings > Environment Variables.

# Par de claves de reCAPTCHA v2 «casilla», de google.com/recaptcha/admin (#22).
# Van juntas: hay que registrar secretspotsoficeland.com y el dominio de preview
# de Vercel. Sin la pública el formulario no muestra la casilla y avisa de que no
# se puede enviar; sin la secreta /api/contact responde 503.

# Clave PÚBLICA. Viaja en el HTML de /contact, así que el prefijo PUBLIC_ es
# obligatorio para que Astro la deje llegar al navegador.
PUBLIC_RECAPTCHA_SITE_KEY=

# Clave SECRETA. Solo servidor: es la que verifica el token en /api/contact.
RECAPTCHA_SECRET_KEY=

# API key de Resend (resend.com) para enviar el correo de la consulta.
RESEND_API_KEY=

# Remitente verificado en el dominio de Resend. No es el correo del visitante:
# ese va en reply_to, para que responder desde la bandeja le escriba a él.
CONTACT_FROM_EMAIL=web@secretspotsoficeland.com

# Bandeja de Luke. Si se deja vacía se usa BUSINESS.email de src/data/site.ts.
CONTACT_TO_EMAIL=
